#category("Goals")
#name("All Side Quests")
#description("Require finishing all side quests before fighting Shriek (you poor soul...)")

!tags("All Side Quests")

!include("goal_mode_core", add_row_item, write_short_goals_row, check_goals_completed, write_missing_goals, update_goals)
!include("list_core", new_row, add_current_row)

!let(max_quests, 12)

!augment_fun(write_short_goals_row(), {
    set_string("quests_message", "Quests: " + itemTracker.questsCount + "/" + max_quests)
    if itemTracker.questsCount == max_quests set_string("quests_message", "$" + get_string("quests_message") + "$")
    add_row_item(get_string("quests_message"))
})

!augment_fun(check_goals_completed(), {
    if itemTracker.questsCount < max_quests set_boolean("goals_completed", false)
})

on spawn store(itemTracker.questsRequired, max_quests)

on MarshSpawn.TokkKeystoneQuest {
    create_stats_entry(QuestEnd, "The Missing Key")
    store(itemTracker.questsCount, itemTracker.questsCount + 1)
}
// TODO optimization for state > n == false?
on MarshSpawn.TokkKeystoneQuest == false store(itemTracker.questsCount, itemTracker.questsCount - 1)

on MarshSpawn.TokkTabletQuest {
    create_stats_entry(QuestEnd, "Into the Burrows")
    store(itemTracker.questsCount, itemTracker.questsCount + 1)
}
on MarshSpawn.TokkTabletQuest == false store(itemTracker.questsCount, itemTracker.questsCount - 1)

on OuterWellspring.TheLostCompass {
    create_stats_entry(QuestEnd, "The Lost Compass")
    store(itemTracker.questsCount, itemTracker.questsCount + 1)
}
on OuterWellspring.TheLostCompass == false store(itemTracker.questsCount, itemTracker.questsCount - 1)

on MarshSpawn.MokkFangQuest {
    create_stats_entry(QuestEnd, "A Little Braver")
    store(itemTracker.questsCount, itemTracker.questsCount + 1)
}
on MarshSpawn.MokkFangQuest == false store(itemTracker.questsCount, itemTracker.questsCount - 1)

on GladesTown.FamilyReunion {
    create_stats_entry(QuestEnd, "Family Reunion")
    store(itemTracker.questsCount, itemTracker.questsCount + 1)
}
on GladesTown.FamilyReunion == false store(itemTracker.questsCount, itemTracker.questsCount - 1)

on GladesTown.LastTree {
    create_stats_entry(QuestEnd, "The Tree Keeper")
    store(itemTracker.questsCount, itemTracker.questsCount + 1)
}
on GladesTown.LastTree == false store(itemTracker.questsCount, itemTracker.questsCount - 1)

// TODO we lack fully accurate simulation in cases where quests set multiple states.
// This should more accurately be questUberStateGroup.desertCogQuest but paths.wotwl doesn't communicate that state
on GladesTown.TwillenGemQuest {
    create_stats_entry(QuestEnd, "A Diamond in the Rough")
    store(itemTracker.questsCount, itemTracker.questsCount + 1)
}
on GladesTown.TwillenGemQuest == false store(itemTracker.questsCount, itemTracker.questsCount - 1)

on WindtornRuins.HandToHandComplete {
    create_stats_entry(QuestEnd, "Hand To Hand")
    store(itemTracker.questsCount, itemTracker.questsCount + 1)
}
on WindtornRuins.HandToHandComplete == false store(itemTracker.questsCount, itemTracker.questsCount - 1)

on GladesTown.MokiAcornQuest {
    create_stats_entry(QuestEnd, "Into the Darkness")
    store(itemTracker.questsCount, itemTracker.questsCount + 1)
}
on GladesTown.MokiAcornQuest == false store(itemTracker.questsCount, itemTracker.questsCount - 1)

on EastHollow.KwolokAmuletQuest {
    create_stats_entry(QuestEnd, "Kwolok's Wisdom")
    store(itemTracker.questsCount, itemTracker.questsCount + 1)
}
on EastHollow.KwolokAmuletQuest == false store(itemTracker.questsCount, itemTracker.questsCount - 1)

on GladesTown.RebuildTheGlades {
    create_stats_entry(QuestEnd, "Rebuilding the Glades")
    store(itemTracker.questsCount, itemTracker.questsCount + 1)
}
on GladesTown.RebuildTheGlades == false store(itemTracker.questsCount, itemTracker.questsCount - 1)

on GladesTown.RegrowTheGlades {
    create_stats_entry(QuestEnd, "Regrowing the Glades")
    store(itemTracker.questsCount, itemTracker.questsCount + 1)
}
on GladesTown.RegrowTheGlades == false store(itemTracker.questsCount, itemTracker.questsCount - 1)

on change itemTracker.questsCount update_goals()

!augment_fun(write_missing_goals(), if itemTracker.questsCount < max_quests {
    new_row("#Missing Quests (" + (max_quests - itemTracker.questsCount) + ")#: ")
    if MarshSpawn.TokkKeystoneQuest == false add_row_item("Missing Key")
    if MarshSpawn.TokkTabletQuest == false add_row_item("Into Burrows")
    if OuterWellspring.TheLostCompass == false add_row_item("Lost Compass")
    if MarshSpawn.MokkFangQuest == false add_row_item("Little Braver")
    if GladesTown.FamilyReunion == false add_row_item("Family Reunion")
    if GladesTown.LastTree == false add_row_item("Tree Keeper")
    if GladesTown.TwillenGemQuest == false add_row_item("Rough Diamond")
    if WindtornRuins.HandToHandComplete == false add_row_item("Hand to Hand")
    if GladesTown.MokiAcornQuest == false add_row_item("Into Darkness")
    if EastHollow.KwolokAmuletQuest == false add_row_item("Kwolok's Wisdom")
    if GladesTown.RebuildTheGlades == false add_row_item("Rebuilding the Glades")
    if GladesTown.RegrowTheGlades == false add_row_item("Regrowing the Glades")
    add_current_row()
})
