#category("Goals")
#name("Quests")
#description("Require completing quests before fighting Shriek")

!config_boolean(randomize, false, "Randomize", "Overrides all other settings with random values")

!config_boolean(silent_teeth, false, "Silent Teeth")
!config_boolean(missing_key, true, "Missing Key")
!config_boolean(into_burrows, true, "Into Burrows")
!config_boolean(lost_compass, true, "Lost Compass")
!config_boolean(little_braver, true, "Little Braver")
!config_boolean(family_reunion, true, "Family Reunion")
!config_boolean(tree_keeper, true, "Tree Keeper")
!config_boolean(rough_diamond, true, "Rough Diamond")
!config_boolean(hand_to_hand, true, "Hand to Hand")
!config_boolean(into_darkness, true, "Into Darkness")
!config_boolean(kwoloks_wisdom, true, "Kwolok's Wisdom")
!config_boolean(rebuilding_the_glades, true, "Rebuilding the Glades")
!config_boolean(regrowing_the_glades, true, "Regrowing the Glades")

!include("goal_mode_core", write_short_goals_row, check_goals_completed, write_missing_goals, add_missing_goal_in_area, update_goals)
!include("list_core", new_row, add_row_item, add_current_row)

!if randomize {
    !random_boolean(silent_teeth)
    !random_boolean(missing_key)
    !random_boolean(into_burrows)
    !random_boolean(lost_compass)
    !random_boolean(little_braver)
    !random_boolean(family_reunion)
    !random_boolean(tree_keeper)
    !random_boolean(rough_diamond)
    !random_boolean(hand_to_hand)
    !random_boolean(into_darkness)
    !random_boolean(kwoloks_wisdom)
    !random_boolean(rebuilding_the_glades)
    !random_boolean(regrowing_the_glades)
}

!let(quests_required, 0)
!if silent_teeth { !let(quests_required, quests_required + 1) }
!if missing_key { !let(quests_required, quests_required + 1) }
!if into_burrows { !let(quests_required, quests_required + 1) }
!if lost_compass { !let(quests_required, quests_required + 1) }
!if little_braver { !let(quests_required, quests_required + 1) }
!if family_reunion { !let(quests_required, quests_required + 1) }
!if tree_keeper { !let(quests_required, quests_required + 1) }
!if rough_diamond { !let(quests_required, quests_required + 1) }
!if hand_to_hand { !let(quests_required, quests_required + 1) }
!if into_darkness { !let(quests_required, quests_required + 1) }
!if kwoloks_wisdom { !let(quests_required, quests_required + 1) }
!if rebuilding_the_glades { !let(quests_required, quests_required + 1) }
!if regrowing_the_glades { !let(quests_required, quests_required + 1) }

!let(max_quests, 13)
!let(tag, "Quests (" + quests_required + "/" + max_quests + ")")
!if randomize { !tags("Random " + tag) }
!if randomize == false {
    !if quests_required == max_quests { !tags("All Quests") }
    !if quests_required < max_quests {
        !if quests_required == max_quests - 1 && silent_teeth == false { !tags("All Side Quests") }
        !if quests_required < max_quests - 1 || silent_teeth { !tags(tag) }
    }
}

on spawn store(tracker.questsRequired, quests_required)

!augment_fun(check_goals_completed(), {
    if tracker.questsFinished < quests_required set_boolean("goals_completed", false)
})

!augment_fun(write_short_goals_row(), {
    set_string("quests_message", "Quests: " + tracker.questsFinished + "/" + quests_required)
    if tracker.questsFinished >= quests_required set_string("quests_message", "$" + get_string("quests_message") + "$")
    add_row_item(get_string("quests_message"))
})

!augment_fun(write_missing_goals(), if tracker.questsFinished < quests_required write_missing_quests())

fun write_missing_quests() { new_row("Missing Quests (" + (quests_required - tracker.questsFinished) + "): ") }
!if silent_teeth { !augment_fun(write_missing_quests(), if kwolokGroupDescriptor.cleanseWellspringQuestUberState < 4 add_missing_goal_in_area(
    "Silent Teeth",
    (kwolokGroupDescriptor.cleanseWellspringQuestUberState != 3 && player_area() == Wellspring)
    || (kwolokGroupDescriptor.cleanseWellspringQuestUberState == 3 && player_area() == Hollow)
)) }
!if missing_key { !augment_fun(write_missing_quests(), if Marsh.MissingKey.Completed == false add_missing_goal_in_area(
    // TODO any other permanents Tokks? Or toggle this based on the conditions for the Tokks to appear? Also relevant in hand to hand
    "Missing Key",
    (npcsStateGroup.marshKeystoneQuest != 2 && player_area() == Marsh)
    || (npcsStateGroup.marshKeystoneQuest == 2 && (player_area() == Marsh || player_area() == Glades))
)) }
!if into_burrows { !augment_fun(write_missing_quests(), if Marsh.IntoBurrows.Completed == false add_missing_goal_in_area(
    "Into Burrows",
    (npcsStateGroup.inkwaterWellQuest != 3 && player_area() == Burrows)
    || (npcsStateGroup.inkwaterWellQuest == 3 && player_area() == Marsh)
)) }
!if lost_compass { !augment_fun(write_missing_quests(), if Wellspring.LostCompass.Completed == false add_missing_goal_in_area(
    "Lost Compass", player_area() == Wellspring
)) }
!if little_braver { !augment_fun(write_missing_quests(), if Marsh.LittleBraver.Completed == false add_missing_goal_in_area(
    "Little Braver", player_area() == Marsh
)) }
!if family_reunion { !augment_fun(write_missing_quests(), if Glades.FamilyReunion.Completed == false add_missing_goal_in_area(
    "Family Reunion",
    (questUberStateGroup.familyReunionQuest != 2 && player_area() == Glades)
    || (questUberStateGroup.familyReunionQuest == 2 && player_area() == Woods)
)) }
!if tree_keeper { !augment_fun(write_missing_quests(), if Glades.Plants.LastTree == false add_missing_goal_in_area(
    "Tree Keeper",
    (questUberStateGroup.treeKeeperQuest != 1 && player_area() == Woods)
    || (questUberStateGroup.treeKeeperQuest == 1 && player_area() == Glades)
)) }
!if rough_diamond { !augment_fun(write_missing_quests(), if questUberStateGroup.desertCogQuest < 5 add_missing_goal_in_area(
    "Rough Diamond",
    (questUberStateGroup.desertCogQuest != 4 && player_area() == Wastes)
    || (questUberStateGroup.desertCogQuest == 4 && (player_area() == Hollow || player_area() == Glades))
)) }
!if hand_to_hand { !augment_fun(write_missing_quests(), if Ruins.HandToHand.Completed == false add_missing_goal_in_area(
    "Hand to Hand",
    (questUberStateGroup.tradeSequenceQuest == 0 && player_area() == Hollow)
    || (questUberStateGroup.tradeSequenceQuest == 1 && (player_area() == Marsh || player_area() == Glades))
    || (questUberStateGroup.tradeSequenceQuest == 2 && player_area() == Wellspring)
    || ((questUberStateGroup.tradeSequenceQuest == 3 || questUberStateGroup.tradeSequenceQuest == 5 || questUberStateGroup.tradeSequenceQuest == 8) && player_area() == Glades)
    || (questUberStateGroup.tradeSequenceQuest == 4 && player_area() == Reach)
    || (questUberStateGroup.tradeSequenceQuest == 6 && player_area() == Depths)
    || (questUberStateGroup.tradeSequenceQuest == 7 && player_area() == Pools)
    || (questUberStateGroup.tradeSequenceQuest == 9 && player_area() == Wastes)
    || (questUberStateGroup.tradeSequenceQuest == 10 && player_area() == Ruins)
)) }
!if into_darkness { !augment_fun(write_missing_quests(), if Glades.IntoDarkness.Completed == false add_missing_goal_in_area(
    "Into Darkness", player_area() == Glades
)) }
!if kwoloks_wisdom { !augment_fun(write_missing_quests(), if Hollow.KwoloksWisdom.Completed == false add_missing_goal_in_area(
    "Kwolok's Wisdom",
    (questUberStateGroup.kwoloksWisdomQuest != 3 && player_area() == Pools)
    || (questUberStateGroup.kwoloksWisdomQuest == 3 && player_area() == Hollow)
)) }
!if rebuilding_the_glades { !augment_fun(write_missing_quests(), if Glades.RebuildGlades.Completed == false add_missing_goal_in_area(
    "Rebuilding the Glades", player_area() == Glades
)) }
!if regrowing_the_glades { !augment_fun(write_missing_quests(), if Glades.RegrowGlades.Completed == false add_missing_goal_in_area(
    "Regrowing the Glades", player_area() == Glades
)) }
!augment_fun(write_missing_quests(), add_current_row())

!if silent_teeth {
    on Hollow.SilentTeeth.Completed {
        create_stats_entry(QuestEnd, "The Silent Teeth")
        store(tracker.questsFinished, tracker.questsFinished + 1)
    }
    on Hollow.SilentTeeth.Completed == false store(tracker.questsFinished, tracker.questsFinished - 1)
}

!if missing_key {
    on Marsh.MissingKey.Completed {
        create_stats_entry(QuestEnd, "The Missing Key")
        store(tracker.questsFinished, tracker.questsFinished + 1)
    }
    // TODO optimization for state > n == false?
    on Marsh.MissingKey.Completed == false store(tracker.questsFinished, tracker.questsFinished - 1)
}

!if into_burrows {
    on Marsh.IntoBurrows.Completed {
        create_stats_entry(QuestEnd, "Into the Burrows")
        store(tracker.questsFinished, tracker.questsFinished + 1)
    }
    on Marsh.IntoBurrows.Completed == false store(tracker.questsFinished, tracker.questsFinished - 1)
}

!if lost_compass {
    on Wellspring.LostCompass.Completed {
        create_stats_entry(QuestEnd, "The Lost Compass")
        store(tracker.questsFinished, tracker.questsFinished + 1)
    }
    on Wellspring.LostCompass.Completed == false store(tracker.questsFinished, tracker.questsFinished - 1)
}

!if little_braver {
    on Marsh.LittleBraver.Completed {
        create_stats_entry(QuestEnd, "A Little Braver")
        store(tracker.questsFinished, tracker.questsFinished + 1)
    }
    on Marsh.LittleBraver.Completed == false store(tracker.questsFinished, tracker.questsFinished - 1)
}

!if family_reunion {
    on Glades.FamilyReunion.Completed {
        create_stats_entry(QuestEnd, "Family Reunion")
        store(tracker.questsFinished, tracker.questsFinished + 1)
    }
    on Glades.FamilyReunion.Completed == false store(tracker.questsFinished, tracker.questsFinished - 1)
}

!if tree_keeper {
    on Woods.TreeKeeper.Completed {
        create_stats_entry(QuestEnd, "The Tree Keeper")
        store(tracker.questsFinished, tracker.questsFinished + 1)
    }
    on Woods.TreeKeeper.Completed == false store(tracker.questsFinished, tracker.questsFinished - 1)
}

!if rough_diamond {
    on Glades.RoughDiamond.Completed {
        create_stats_entry(QuestEnd, "A Diamond in the Rough")
        store(tracker.questsFinished, tracker.questsFinished + 1)
    }
    on Glades.RoughDiamond.Completed == false store(tracker.questsFinished, tracker.questsFinished - 1)
}

!if hand_to_hand {
    on Ruins.HandToHand.Completed {
        create_stats_entry(QuestEnd, "Hand To Hand")
        store(tracker.questsFinished, tracker.questsFinished + 1)
    }
    on Ruins.HandToHand.Completed == false store(tracker.questsFinished, tracker.questsFinished - 1)
}

!if into_darkness {
    on Glades.IntoDarkness.Completed {
        create_stats_entry(QuestEnd, "Into the Darkness")
        store(tracker.questsFinished, tracker.questsFinished + 1)
    }
    on Glades.IntoDarkness.Completed == false store(tracker.questsFinished, tracker.questsFinished - 1)
}

!if kwoloks_wisdom {
    on Hollow.KwoloksWisdom.Completed {
        create_stats_entry(QuestEnd, "Kwolok's Wisdom")
        store(tracker.questsFinished, tracker.questsFinished + 1)
    }
    on Hollow.KwoloksWisdom.Completed == false store(tracker.questsFinished, tracker.questsFinished - 1)
}

!if rebuilding_the_glades {
    on Glades.RebuildGlades.Completed {
        create_stats_entry(QuestEnd, "Rebuilding the Glades")
        store(tracker.questsFinished, tracker.questsFinished + 1)
    }
    on Glades.RebuildGlades.Completed == false store(tracker.questsFinished, tracker.questsFinished - 1)
}

!if regrowing_the_glades {
    on Glades.RegrowGlades.Completed {
        create_stats_entry(QuestEnd, "Regrowing the Glades")
        store(tracker.questsFinished, tracker.questsFinished + 1)
    }
    on Glades.RegrowGlades.Completed == false store(tracker.questsFinished, tracker.questsFinished - 1)
}

// have to update on every quest step because of the area highlighting above
!if silent_teeth { on change kwolokGroupDescriptor.cleanseWellspringQuestUberState update_goals() }
!if missing_key { on change npcsStateGroup.marshKeystoneQuest update_goals() }
!if into_burrows { on change npcsStateGroup.inkwaterWellQuest update_goals() }
!if lost_compass { on change questUberStateGroup.lostCompassQuest update_goals() }
!if little_braver { on change questUberStateGroup.braveMokiQuest update_goals() }
!if family_reunion { on change questUberStateGroup.familyReunionQuest update_goals() }
!if tree_keeper { on change questUberStateGroup.treeKeeperQuest update_goals() }
!if rough_diamond { on change questUberStateGroup.desertCogQuest update_goals() }
!if hand_to_hand { on change questUberStateGroup.tradeSequenceQuest update_goals() }
!if into_darkness { on change questUberStateGroup.darkCaveQuest update_goals() }
!if kwoloks_wisdom { on change questUberStateGroup.kwoloksWisdomQuest update_goals() }
!if rebuilding_the_glades { on change questUberStateGroup.rebuildGladesQuest update_goals() }
!if regrowing_the_glades { on change questUberStateGroup.regrowGladesQuest update_goals() }
