#category("Goals")
#name("All Side Quests")
#description("Require finishing all side quests before fighting Shriek (you poor soul...)")

!tags("All Side Quests")

!include("goal_mode_core", write_goal_progress_message, check_goals_completed, write_goals_incomplete_message, update_goals_completed)

!let(max_quests, 12)

!augment_fun(write_goal_progress_message, {
    if get_boolean("comma") set_string("goal_progress_message", get_string("goal_progress_message") + ", ")
    set_boolean("comma", true)
    set_string("color", "")
    if itemTracker.questsCount == max_quests set_string("color", "$")
    write_quests_message()
    set_string("goal_progress_message", get_string("goal_progress_message") + get_string("quest_message"))
})

!augment_fun(check_goals_completed, {
    if itemTracker.questsCount < max_quests set_boolean("goals_completed", false)
})

on spawn store(itemTracker.questsRequired, max_quests)

on MarshSpawn.TokkKeystoneQuest store(itemTracker.questsCount, itemTracker.questsCount + 1)
// TODO optimization for state > n == false?
on MarshSpawn.TokkKeystoneQuest == false store(itemTracker.questsCount, itemTracker.questsCount - 1)
on MarshSpawn.TokkTabletQuest store(itemTracker.questsCount, itemTracker.questsCount + 1)
on MarshSpawn.TokkTabletQuest == false store(itemTracker.questsCount, itemTracker.questsCount - 1)
on OuterWellspring.TheLostCompass store(itemTracker.questsCount, itemTracker.questsCount + 1)
on OuterWellspring.TheLostCompass == false store(itemTracker.questsCount, itemTracker.questsCount - 1)
on MarshSpawn.MokkFangQuest store(itemTracker.questsCount, itemTracker.questsCount + 1)
on MarshSpawn.MokkFangQuest == false store(itemTracker.questsCount, itemTracker.questsCount - 1)
on questUberStateGroup.familyReunionQuest >= 4 store(itemTracker.questsCount, itemTracker.questsCount + 1)
on questUberStateGroup.familyReunionQuest >= 4 == false store(itemTracker.questsCount, itemTracker.questsCount - 1)
on GladesTown.LastTree store(itemTracker.questsCount, itemTracker.questsCount + 1)
on GladesTown.LastTree == false store(itemTracker.questsCount, itemTracker.questsCount - 1)
on questUberStateGroup.desertCogQuest >= 5 store(itemTracker.questsCount, itemTracker.questsCount + 1)
on questUberStateGroup.desertCogQuest >= 5 == false store(itemTracker.questsCount, itemTracker.questsCount - 1)
on WindtornRuins.HandToHandComplete store(itemTracker.questsCount, itemTracker.questsCount + 1)
on WindtornRuins.HandToHandComplete == false store(itemTracker.questsCount, itemTracker.questsCount - 1)
on GladesTown.MokiAcornQuest store(itemTracker.questsCount, itemTracker.questsCount + 1)
on GladesTown.MokiAcornQuest == false store(itemTracker.questsCount, itemTracker.questsCount - 1)
on EastHollow.KwolokAmuletQuest store(itemTracker.questsCount, itemTracker.questsCount + 1)
on EastHollow.KwolokAmuletQuest == false store(itemTracker.questsCount, itemTracker.questsCount - 1)
on GladesTown.RebuildTheGlades store(itemTracker.questsCount, itemTracker.questsCount + 1)
on GladesTown.RebuildTheGlades == false store(itemTracker.questsCount, itemTracker.questsCount - 1)
on GladesTown.RegrowTheGlades store(itemTracker.questsCount, itemTracker.questsCount + 1)
on GladesTown.RegrowTheGlades == false store(itemTracker.questsCount, itemTracker.questsCount - 1)

on change itemTracker.questsCount update_goals_completed()

!augment_fun(write_goals_incomplete_message, {
    if itemTracker.questsCount < max_quests {
        set_string("color", "@")
        write_quests_message()
        set_string("goals_incomplete_message", get_string("goals_incomplete_message") + "\n" + get_string("quest_message"))
    }
})

fun write_quests_message() {
    set_string("quest_message", get_string("color") + "Quests: " + itemTracker.questsCount + "/" + max_quests + get_string("color"))
}
