#category("Item Pool")
#name("Bonus Items")
#description("Shuffles items unique to the randomizer into the world")

!tags("Bonus Items")
!config(health_regenerations, "Health Regeneration Count", "Gain Health over time", Integer, 3)
!config(energy_regenerations, "Energy Regeneration Count", "Gain Energy over time", Integer, 3)
!config(extra_double_jumps, "Extra Double Jump Count", "Add extra jumps when having Double Jump", Integer, 1)
!config(extra_air_dashes, "Extra Air Dash Count", "Allows dashing multiple times without a dash refresh", Integer, 1)
!config(blaze_efficiencies, "Blaze Efficiency Count", "Makes Blaze cost less energy", Integer, 1)
!config(spear_efficiencies, "Spear Efficiency Count", "Makes Spear cost less energy", Integer, 1)
!config(shuriken_efficiencies, "Shuriken Efficiency Count", "Makes Shuriken cost less energy", Integer, 1)
!config(sentry_efficiencies, "Sentry Efficiency Count", "Makes Sentry cost less energy", Integer, 1)
!config(bow_efficiencies, "Bow Efficiency Count", "Makes Bow cost less energy", Integer, 0)
!config(regenerate_efficiencies, "Regenerate Efficiency Count", "Makes Regenrate cost less energy", Integer, 0)
!config(flash_efficiencies, "Flash Efficiency Count", "Makes Flash cost less energy", Integer, 0)
!config(grenade_efficiencies, "Grenade Efficiency Count", "Make Grenade cost less energy", Integer, 1)

!include("bonus_item_core",
    health_regeneration,
    energy_regeneration,
    extra_double_jump,
    extra_air_dash,
    blaze_efficiency,
    spear_efficiency,
    shuriken_efficiency,
    sentry_efficiency,
    bow_efficiency,
    regenerate_efficiency,
    flash_efficiency,
    grenade_efficiency
)

!add_item(health_regeneration(), health_regenerations)
!add_item(energy_regeneration(), energy_regenerations)
!add_item(extra_double_jump(), extra_double_jumps)
!add_item(extra_air_dash(), extra_air_dashes)
!add_item(blaze_efficiency(), blaze_efficiencies)
!add_item(spear_efficiency(), spear_efficiencies)
!add_item(shuriken_efficiency(), shuriken_efficiencies)
!add_item(sentry_efficiency(), sentry_efficiencies)
!add_item(bow_efficiency(), bow_efficiencies)
!add_item(regenerate_efficiency(), regenerate_efficiencies)
!add_item(flash_efficiency(), flash_efficiencies)
!add_item(grenade_efficiency(), grenade_efficiencies)
