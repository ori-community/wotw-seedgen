#category("Item Pool")
#name("Bonus Items")
#description("Shuffles items unique to the randomizer into the world")

!tags("Bonus Items")
!config_integer(health_regenerations, 3, "Health Regeneration Count", "Gain Health over time")
!config_integer(energy_regenerations, 3, "Energy Regeneration Count", "Gain Energy over time")
!config_integer(extra_double_jumps, 1, "Extra Double Jump Count", "Add extra jumps when having Double Jump")
!config_integer(extra_air_dashes, 1, "Extra Air Dash Count", "Allows dashing multiple times without a dash refresh")
!config_integer(blaze_efficiencies, 1, "Blaze Efficiency Count", "Makes Blaze cost less energy")
!config_integer(spear_efficiencies, 1, "Spear Efficiency Count", "Makes Spear cost less energy")
!config_integer(shuriken_efficiencies, 1, "Shuriken Efficiency Count", "Makes Shuriken cost less energy")
!config_integer(sentry_efficiencies, 1, "Sentry Efficiency Count", "Makes Sentry cost less energy")
!config_integer(bow_efficiencies, 0, "Bow Efficiency Count", "Makes Bow cost less energy")
!config_integer(regenerate_efficiencies, 0, "Regenerate Efficiency Count", "Makes Regenerate cost less energy")
!config_integer(flash_efficiencies, 0, "Flash Efficiency Count", "Makes Flash cost less energy")
!config_integer(grenade_efficiencies, 1, "Grenade Efficiency Count", "Make Grenade cost less energy")

!include("bonus_item_core",
    health_regeneration,
    energy_regeneration,
    extra_double_jump,
    extra_air_dash,
    blaze_efficiency,
    spear_efficiency,
    shuriken_efficiency,
    sentry_efficiency,
    bow_efficiency,
    regenerate_efficiency,
    flash_efficiency,
    grenade_efficiency
)

!add_item(health_regeneration(), health_regenerations)
!add_item(energy_regeneration(), energy_regenerations)
!add_item(extra_double_jump(), extra_double_jumps)
!add_item(extra_air_dash(), extra_air_dashes)
!add_item(blaze_efficiency(), blaze_efficiencies)
!add_item(spear_efficiency(), spear_efficiencies)
!add_item(shuriken_efficiency(), shuriken_efficiencies)
!add_item(sentry_efficiency(), sentry_efficiencies)
!add_item(bow_efficiency(), bow_efficiencies)
!add_item(regenerate_efficiency(), regenerate_efficiencies)
!add_item(flash_efficiency(), flash_efficiencies)
!add_item(grenade_efficiency(), grenade_efficiencies)
