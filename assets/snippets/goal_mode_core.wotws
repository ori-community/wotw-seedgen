#hidden
#name("Goal Mode Core")
#description("Manages access to Shriek and goal progress messages")

!builtin_icon(message_icon, "icons/game/message.png")

!include("progress_helper", write_progress_message, update_progress_message, disable_keybinds)
!include("list_core", new_column, new_row, add_row_item, add_current_row)

!export(add_row_item)

!export(check_goals_completed)
fun check_goals_completed() {
    set_boolean("goals_completed", true)
}

!export(write_short_goals_row)
fun write_short_goals_row() {
    new_row("")
}

!export(write_missing_goals)
fun write_missing_goals() {
    new_column("")
}

!export(update_goals)
fun update_goals() {
    check_goals_completed()
    store(randoState.shriekBarrier, get_boolean("goals_completed") == false)

    update_progress_message()
    update_missing_goals()

    if get_boolean("in_shriek_room") && get_boolean("goals_completed") destroy_message("missing_goals")
}

// TODO try shrinking or graying the Trees: etc. labels to make the numbers easier to parse
!augment_fun(write_progress_message(), {
    write_short_goals_row()
    add_current_row()
})

on binding1 if disable_keybinds == false show_missing_goals()

fun show_missing_goals() {
    if randoState.shriekBarrier {
        if get_boolean("in_shriek_room") priority_message("Already at Shriek")
        if get_boolean("in_shriek_room") == false {
            write_missing_goals()
            controlled_priority_message("missing_goals", get_string("column"), 6)
        }
    }
    if randoState.shriekBarrier == false priority_message("All Goals completed")
}

on reload {
    set_wheel_item_data(
        "progress_helper",
        TopRight,
        "Missing Goals",
        "[Ability1]View Missing Goals",
        message_icon,
    )
    set_wheel_item_all_actions("progress_helper", TopRight, show_missing_goals())

    position_trigger_rectangle("shriek_room", 520, -3617, 744, -3503)
    position_trigger_enter_callback("shriek_room", {
        set_boolean("in_shriek_room", true)
        if randoState.shriekBarrier {
            write_missing_goals()
            set_string("column", "<s_0.9><ls_0.9>@" + get_string("column") + "@")
            free_message("missing_goals", get_string("column"))
            set_message_vertical_anchor("missing_goals", Bottom)
            set_message_position("missing_goals", 0.5, 0.84)
        }
    })
    position_trigger_leave_callback("shriek_room", {
        set_boolean("in_shriek_room", false)
        destroy_message("missing_goals")
    })
    update_goals()
}

on change player.currentArea update_missing_goals() // Need this because the zone updates 1 frame delayed from the position change
fun update_missing_goals() {
    write_missing_goals()
    if get_boolean("in_shriek_room") set_string("column", "<s_0.9><ls_0.9>@" + get_string("column") + "@")
    set_message_text("missing_goals", get_string("column"))
}

on player.currentMapArea < 12 free_message_hide("missing_goals", false)
on player.currentMapArea >= 12 free_message_show("missing_goals", true, false)
