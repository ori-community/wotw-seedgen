#category("Hints")
#name("Knowledge Hints")
#description("Interactively displays useful hints on niche randomizer knowledge while playing the seed")

!config_boolean(gate_hints, true, "Unintuitive Gates", "Explain unintuitive gates such as Depths entrance")
!config_boolean(regen_logic_hint, true, "Required Regenerate", "Explains areas logically requiring Regenerate")
!config_boolean(tp_logic_hints, true, "Teleporter Skill Requirements", "Explains logical teleporter requirements such as Flap for Reach teleporter")

// TODO explain key hints?

!if gate_hints {
    on reload {
        position_trigger_rectangle("depths_entrance", 127, -4306, 183, -4268)
        position_trigger_enter_callback("depths_entrance", if Hollow.DepthsOpen == false && skills.glide == false
            item_message("#Motay's Note#\nThe moki will only open the entrance once you find " + skill_string(Glide))
        )

        position_trigger_rectangle("baurs_sleep", -527, -4033, -461, -4018)
        position_trigger_enter_callback("baurs_sleep", if Reach.Baur.Sneezed == false && skills.flap == false
            item_message("#Motay's Note#\nThe bear will only wake if you use " + skill_string(Flap))
        )

        position_trigger_rectangle("voice_door", -102, -4200, -41, -4250)
        position_trigger_enter_callback("voice_door", {
            if Hollow.Kwolok.Met == false && is_in_rectangle(-60, -4218, -41, -4200) == false
                item_message("#Motay's Note#\nThe moki will only open the door to Glades once you get the #Voice of the Forest# from Kwolok")
        })
    }
}

!if regen_logic_hint {
    !state(regen_message_shown, Boolean)

    // TODO on change current area / regenerate?
    on tick if
    (
        player_area() == Woods
        || player_area() == Reach
        || player_area() == Depths
        || player_area() == Pools
        || player_area() == Wastes
        || player_area() == Ruins
        || player_area() == Willow
    )
    && is_in_rectangle(-486, -3773, -476, -3763) == false
    && skills.regenerate == false {
        store(regen_message_shown, true)
    }

    on regen_message_shown item_message("#Motay's Note#\nIn Moki and Gorlek, entering areas after #The Wellspring# won't be required until you find " + skill_string(Regenerate))
}

!if tp_logic_hints {
    // TODO adjust teleporter names
    // TODO interface the settings to check the difficulty
    on Reach.Teleporter if skills.flap == false && mapSegments.segment75735 < 2
        item_message("#Motay's Note#\nUsing the " + teleporter_string(Reach) + " won't be required until you find " + skill_string(Flap))
    on Depths.Teleporter if skills.glide == false && mapSegments.segment95083 < 2
        item_message("#Motay's Note#\nUsing the " + teleporter_string(Depths) + " won't be required until you find " + skill_string(Glide))
    on Pools.CentralTeleporter if worldEvents.cleanWater == false && mapSegments.segment86073 < 2
        item_message("#Motay's Note#\nUsing the " + teleporter_string(CentralPools) + " won't be required until you find " + clean_water_string())
    on Pools.BossTeleporter if worldEvents.cleanWater == false && mapSegments.segment86148 < 2
        item_message("#Motay's Note#\nUsing the " + teleporter_string(PoolsBoss) + " won't be required until you find " + clean_water_string() + " and " + skill_string(WaterDash))
    on Wastes.CentralTeleporter if skills.burrow == false && mapSegments.segment116092 < 2
        item_message("#Motay's Note#\nUsing the " + teleporter_string(CentralWastes) + " won't be required until you find " + skill_string(Burrow))
    on Wastes.UpperTeleporter if skills.burrow == false && mapSegments.segment116119 < 2
        item_message("#Motay's Note#\nUsing the " + teleporter_string(UpperWastes) + " won't be required until you find " + skill_string(Burrow))
    on Ruins.Teleporter if skills.burrow == false && mapSegments.segment135448 < 2
        item_message("#Motay's Note#\nUsing the " + teleporter_string(Ruins) + " won't be required until you find " + skill_string(Burrow))
    on Willow.Teleporter if skills.burrow == false && mapSegments.segment146124 < 2
        item_message("#Motay's Note#\nUsing the " + teleporter_string(Willow) + " won't be required until you find " + skill_string(Burrow))
    on Burrows.Teleporter if skills.bash == false && mapSegments.segment54817 < 2
        item_message("#Motay's Note#\nUsing the " + teleporter_string(Burrows) + " won't be required until you find " + skill_string(Bash))
}
