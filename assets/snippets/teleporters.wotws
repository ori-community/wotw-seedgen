#category("Item Pool")
#name("Teleporters")
#description("Find teleporter activations as pickups")

!tags("Teleporters")

!config_boolean(marsh, true, "Marsh Teleporter")
!config_boolean(howls_den, true, "Den Teleporter")
!config_boolean(hollow, true, "Hollow Teleporter")
!config_boolean(glades, true, "Glades Teleporter")
!config_boolean(wellspring, true, "Wellspring Teleporter")
!config_boolean(burrows, true, "Burrows Teleporter")
!config_boolean(woods_entrance, true, "Woods Entrance Teleporter")
!config_boolean(woods_exit, true, "Woods Exit Teleporter")
!config_boolean(reach, true, "Reach Teleporter")
!config_boolean(depths, true, "Depths Teleporter")
!config_boolean(central_pools, true, "Central Pools Teleporter")
!config_boolean(pools_boss, false, "Pools Boss Teleporter")
!config_boolean(feeding_grounds, true, "Feeding Grounds Teleporter")
!config_boolean(central_wastes, true, "Central Wastes Teleporter")
!config_boolean(outer_ruins, true, "Outer Ruins Teleporter")
!config_boolean(inner_ruins, false, "Inner Ruins Teleporter")
!config_boolean(willow, true, "Willow Teleporter")
!config_boolean(shriek, false, "Shriek Teleporter")

!if marsh { !add_item(teleporter(Marsh), 1) }
!if howls_den { !add_item(teleporter(Den), 1) }
!if hollow { !add_item(teleporter(Hollow), 1) }
!if glades { !add_item(teleporter(Glades), 1) }
!if wellspring { !add_item(teleporter(Wellspring), 1) }
!if burrows { !add_item(teleporter(Burrows), 1) }
!if woods_entrance { !add_item(teleporter(WoodsEntrance), 1) }
!if woods_exit { !add_item(teleporter(WoodsExit), 1) }
!if reach { !add_item(teleporter(Reach), 1) }
!if depths { !add_item(teleporter(Depths), 1) }
!if central_pools { !add_item(teleporter(CentralPools), 1) }
!if pools_boss { !add_item(teleporter(PoolsBoss), 1) }
!if feeding_grounds { !add_item(teleporter(FeedingGrounds), 1) }
!if central_wastes { !add_item(teleporter(CentralWastes), 1) }
!if outer_ruins { !add_item(teleporter(OuterRuins), 1) }
!if inner_ruins { !add_item(teleporter(InnerRuins), 1) }
!if willow { !add_item(teleporter(Willow), 1) }
!if shriek { !add_item(teleporter(Shriek), 1) }
