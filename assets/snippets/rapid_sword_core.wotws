#hidden
#name("Rapid Sword Core")
#description("Adds support for toggleable Rapid Sword")

!state(enabled, Boolean)
!state(collected, Integer)

!include("bonus_core", update_bonus_wheel, any_collected, any_enabled, enable_all, disable_all)
!include("bonus_progress_helper", write_bonus_items, add_colored_row_item, update_bonus_items)

!augment_fun(any_collected(), if collected > 0 set_boolean("any_collected", true))
!augment_fun(any_enabled(), if collected > 0 && enabled set_boolean("any_enabled", true))
!augment_fun(enable_all(), if enabled == false store(enabled, true))
!augment_fun(disable_all(), if enabled store(enabled, false))

!builtin_icon(rapid_sword_icon, "icons/bonus/rapidsword.png")

fun rapid_sword() {
    item_message("#Rapid Sword x" + (collected + 1) + "#")
    store(collected, collected + 1)
    update_bonus_items()
}
!export(rapid_sword)

!augment_fun(write_bonus_items(), if collected != 0 add_colored_row_item("Rapid Sword x" + collected))

!item_data(rapid_sword(),
    "#Rapid Sword#",
    200,
    "Sword attacks are faster",
    rapid_sword_icon,
    BonusItem
)

on spawn store(enabled, true)

on enabled && collected > 0 {
    set_wheel_item_disable()
    update_bonus_wheel()
    store(randoUpgrades.swordSpeedMultiplier, 1 + collected * 0.25)
}

on enabled == false && collected > 0 {
    set_wheel_item_enable()
    update_bonus_wheel()
    store(randoUpgrades.swordSpeedMultiplier, 1)
}

on reload if collected > 0 {
    create_wheel_item()
    if enabled set_wheel_item_disable()
    if enabled == false set_wheel_item_enable()
}
on collected > 0 create_wheel_item()

fun create_wheel_item() {
    set_wheel_item_name("bonus_upgrades", Right, "Toggle Rapid Sword")
    set_wheel_item_icon("bonus_upgrades", Right, rapid_sword_icon)
    set_wheel_item_all_actions("bonus_upgrades", Right, store(enabled, enabled == false))
}

fun set_wheel_item_disable() {
    set_wheel_item_description("bonus_upgrades", Right, "[Ability1]Toggle off")
    set_wheel_item_color("bonus_upgrades", Right, 255, 255, 255, 255)
}

fun set_wheel_item_enable() {
    set_wheel_item_description("bonus_upgrades", Right, "[Ability1]Toggle on")
    set_wheel_item_color("bonus_upgrades", Right, 128, 128, 128, 196)
}
