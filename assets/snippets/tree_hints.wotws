#category("Hints")
#name("Tree Hints")
#description("
Every tree gives a hint for the skill located there
The Flap hint is on the Glades Ancestral Light Tree
The Glide hint is on the Marsh Ancestral Light Tree
The Clean Water Hint is on the Wellspring Escape")

!tags("Tree Hints")

!zone_of(regenerate_zone, store(skills.regenerate, true))
!zone_of(sword_zone, store(skills.sword, true))
!zone_of(double_jump_zone, store(skills.doubleJump, true))
!zone_of(bow_zone, store(skills.bow, true))
!zone_of(dash_zone, store(skills.dash, true))
!zone_of(bash_zone, store(skills.bash, true))
!zone_of(grapple_zone, store(skills.grapple, true))
!zone_of(clean_water_zone, store(randoState.cleanWater, true))
!zone_of(flap_zone, store(skills.flap, true))
!zone_of(glide_zone, store(skills.glide, true))
!zone_of(grenade_zone, store(skills.grenade, true))
!zone_of(flash_zone, store(skills.flash, true))
!zone_of(water_dash_zone, store(skills.waterDash, true))
!zone_of(burrow_zone, store(skills.burrow, true))
!zone_of(launch_zone, store(skills.launch, true))

!include("progress_helper", write_progress_message, write_map_progress_message)
!include("list_core", new_row, add_row_item, add_current_row)

!augment_fun(write_progress_message(), write_hints())
!augment_fun(write_map_progress_message(), write_hints())

fun write_hints() {
    new_row("")

    if MarshSpawn.RegenTree {
        write_regenerate_hint()
        add_row_item(get_string("hint"))
    }
    if HowlsDen.SwordTree {
        write_sword_hint()
        add_row_item(get_string("hint"))
    }
    if HowlsDen.DoubleJumpTree {
        write_double_jump_hint()
        add_row_item(get_string("hint"))
    }
    if MarshPastOpher.BowTree {
        write_bow_hint()
        add_row_item(get_string("hint"))
    }
    if WestHollow.DashTree {
        write_dash_hint()
        add_row_item(get_string("hint"))
    }
    if EastHollow.BashTree {
        write_bash_hint()
        add_row_item(get_string("hint"))
    }
    if InnerWellspring.GrappleTree {
        write_grapple_hint()
        add_row_item(get_string("hint"))
    }
    if InnerWellspring.WaterEscape {
        write_clean_water_hint()
        add_row_item(get_string("hint"))
    }
    if GladesTown.DamageTree {
        write_flap_hint()
        add_row_item(get_string("hint"))
    }
    if MarshSpawn.DamageTree {
        write_glide_hint()
        add_row_item(get_string("hint"))
    }
    if UpperReach.GrenadeTree {
        write_grenade_hint()
        add_row_item(get_string("hint"))
    }
    if LowerDepths.FlashTree {
        write_flash_hint()
        add_row_item(get_string("hint"))
    }
    if UpperPools.WaterDashTree {
        write_water_dash_hint()
        add_row_item(get_string("hint"))
    }
    if LowerWastes.BurrowTree {
        write_burrow_hint()
        add_row_item(get_string("hint"))
    }
    if WeepingRidge.LaunchTree {
        write_launch_hint()
        add_row_item(get_string("hint"))
    }

    add_current_row()
}

on MarshSpawn.RegenTree {
    write_regenerate_hint()
    item_message(get_string("hint"))
}
on HowlsDen.SwordTree {
    write_sword_hint()
    item_message(get_string("hint"))
}
on HowlsDen.DoubleJumpTree {
    write_double_jump_hint()
    item_message(get_string("hint"))
}
on MarshPastOpher.BowTree {
    write_bow_hint()
    item_message(get_string("hint"))
}
on WestHollow.DashTree {
    write_dash_hint()
    item_message(get_string("hint"))
}
on EastHollow.BashTree {
    write_bash_hint()
    item_message(get_string("hint"))
}
on InnerWellspring.GrappleTree {
    write_grapple_hint()
    item_message(get_string("hint"))
}
on InnerWellspring.WaterEscape {
    write_clean_water_hint()
    item_message(get_string("hint"))
}
on GladesTown.DamageTree {
    write_flap_hint()
    item_message(get_string("hint"))
}
on MarshSpawn.DamageTree {
    write_glide_hint()
    item_message(get_string("hint"))
}
on UpperReach.GrenadeTree {
    write_grenade_hint()
    item_message(get_string("hint"))
}
on LowerDepths.FlashTree {
    write_flash_hint()
    item_message(get_string("hint"))
}
on UpperPools.WaterDashTree {
    write_water_dash_hint()
    item_message(get_string("hint"))
}
on LowerWastes.BurrowTree {
    write_burrow_hint()
    item_message(get_string("hint"))
}
on WeepingRidge.LaunchTree {
    write_launch_hint()
    item_message(get_string("hint"))
}

fun write_regenerate_hint() {
    set_string("color", "")
    if skills.regenerate set_string("color", "$")
    set_string("hint", get_string("color") + "Regenerate: " + regenerate_zone + get_string("color"))
}
fun write_sword_hint() {
    set_string("color", "")
    if skills.sword set_string("color", "$")
    set_string("hint", get_string("color") + "Sword: " + sword_zone + get_string("color"))
}
