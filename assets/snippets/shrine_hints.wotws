#category("Hints")
#name("Shrine Hints")
#description("Reveal the reward a Combat Shrine gives when starting it")

!builtin_icon(message_icon, "icons/game/message.png")

!include("list_core", new_column, add_row, add_current_row, new_row, add_row_item)

!state(marsh_visited, Boolean)
!state(howls_den_visited, Boolean)
!state(glades_visited, Boolean)
!state(woods_visited, Boolean)
!state(depths_visited, Boolean)

!item_on(marsh_shrine_item, MarshPastOpher.CombatShrine)
!item_on(den_shrine_item, HowlsDen.CombatShrine)
!item_on(glades_shrine_item, WestGlades.CombatShrine)
!item_on(woods_shrine_item, WoodsMain.CombatShrine)
!item_on(depths_shrine_item, LowerDepths.CombatShrine)

on shrines.marshWave == 1 {
    store(marsh_visited, true)
    if MarshPastOpher.CombatShrineCompleted == false item_message("Complete the Marsh Combat Shrine to gain\n" + marsh_shrine_item)
}
on shrines.howlsDenWave == 1 {
    store(howls_den_visited, true)
    if HowlsDen.CombatShrineCompleted == false item_message("Complete the Howl's Den Combat Shrine to gain\n" + den_shrine_item)
}
on shrines.gladesWave == 1 {
    store(glades_visited, true)
    if WestGlades.CombatShrineCompleted == false item_message("Complete the Glades Combat Shrine to gain\n" + glades_shrine_item)
}
on shrines.woodsWave == 1 {
    store(woods_visited, true)
    if WoodsMain.CombatShrineCompleted == false item_message("Complete the Woods Combat Shrine to gain\n" + woods_shrine_item)
}
on shrines.depthsWave == 1 {
    store(depths_visited, true)
    if LowerDepths.CombatShrineCompleted == false item_message("Complete the Depths Combat Shrine to gain\n" + depths_shrine_item)
}

on reload {
    set_wheel_item_name("progress_helper", Left, "Shrine Hints")
    set_wheel_item_icon("progress_helper", Left, message_icon)
    set_wheel_item_all_actions("progress_helper", Left, {
        write_shrine_hints()
        controlled_priority_message("shrine_hints", get_string("column"), 4)
    })
}

on reload update_wheel()
on change marsh_visited update_wheel()
on change howls_den_visited update_wheel()
on change glades_visited update_wheel()
on change woods_visited update_wheel()
on change depths_visited update_wheel()
on change MarshPastOpher.CombatShrineCompleted update_wheel()
on change HowlsDen.CombatShrineCompleted update_wheel()
on change WestGlades.CombatShrineCompleted update_wheel()
on change WoodsMain.CombatShrineCompleted update_wheel()
on change LowerDepths.CombatShrineCompleted update_wheel()
fun update_wheel() {
    set_boolean(
        "any_unlocked",
        marsh_visited
        || howls_den_visited
        || glades_visited
        || woods_visited
        || depths_visited
        || MarshPastOpher.CombatShrineCompleted
        || HowlsDen.CombatShrineCompleted
        || WestGlades.CombatShrineCompleted
        || WoodsMain.CombatShrineCompleted
        || LowerDepths.CombatShrineCompleted
    )

    if get_boolean("any_unlocked") {
        set_wheel_item_description("progress_helper", Left, "[Ability1]View Hints")
        set_wheel_item_color("progress_helper", Left, 255, 255, 255, 255)
    }
    if get_boolean("any_unlocked") == false {
        set_wheel_item_description("progress_helper", Left, "No Combat Shrines visited")
        set_wheel_item_color("progress_helper", Left, 128, 128, 128, 196)
    }
}

on change marsh_visited update_shrine_hints()
on change howls_den_visited update_shrine_hints()
on change glades_visited update_shrine_hints()
on change woods_visited update_shrine_hints()
on change depths_visited update_shrine_hints()
on change MarshPastOpher.CombatShrineCompleted update_shrine_hints()
on change HowlsDen.CombatShrineCompleted update_shrine_hints()
on change WestGlades.CombatShrineCompleted update_shrine_hints()
on change WoodsMain.CombatShrineCompleted update_shrine_hints()
on change LowerDepths.CombatShrineCompleted update_shrine_hints()
fun update_shrine_hints() {
    write_shrine_hints()
    set_message_text("shrine_hints", get_string("column"))
}

fun write_shrine_hints() {
    new_column("")

    if marsh_visited && MarshPastOpher.CombatShrineCompleted == false add_row("#Marsh Reward#: " + marsh_shrine_item)
    if howls_den_visited && HowlsDen.CombatShrineCompleted == false add_row("#Den Reward#: " + den_shrine_item)
    if glades_visited && WestGlades.CombatShrineCompleted == false add_row("#Glades Reward#: " + glades_shrine_item)
    if woods_visited && WoodsMain.CombatShrineCompleted == false add_row("#Woods Reward#: " + woods_shrine_item)
    if depths_visited && LowerDepths.CombatShrineCompleted == false add_row("#Depths Reward#: " + depths_shrine_item)

    new_row("$Completed$: ")

    if MarshPastOpher.CombatShrineCompleted add_row_item("Marsh")
    if HowlsDen.CombatShrineCompleted add_row_item("Den")
    if WestGlades.CombatShrineCompleted add_row_item("Glades")
    if WoodsMain.CombatShrineCompleted add_row_item("Woods")
    if LowerDepths.CombatShrineCompleted add_row_item("Depths")

    add_current_row()

    if get_integer("lines") == 0 set_string("column", "No Combat Shrines visited")
}
