#category("World Changes")
#name("No KS Doors")
#description("All keystone doors start open")

!tags("No KS Doors")

on spawn {
    store(Wastes.KeystoneDoor, true)
    store(Marsh.Howl.KeystoneDoor, true)
    store(Marsh.Den.KeystoneDoor, true)
    store(Depths.FirstKeystoneDoor, true)
    store(Depths.SecondKeystoneDoor, true)
    store(Pools.KeystoneDoor, true)
    store(Reach.Trial.KeystoneDoor, true)
    store(Reach.TopKeystoneDoor, true)
    store(Burrows.KeystoneDoor, true)
    store(Woods.FirstKeystoneDoor, true)
    store(Woods.KuKeystoneDoor, true)
    store(kwolokGroupDescriptor.eyesPlacedIntoStatue, 3)
    store(Marsh.EyestoneDoor, true)
}

!remove_item(keystone(), 34)
