#category("Goals")
#name("Wisps")
#description("Require collecting Wisps before fighting Shriek")

!config_boolean(randomize, false, "Randomize", "Overrides all other settings with random values")

!config_boolean(voice, true, "Voice")
!config_boolean(strength, true, "Strength")
!config_boolean(memory, true, "Memory")
!config_boolean(eyes, true, "Eyes")
!config_boolean(heart, true, "Heart")

!include("goal_mode_core", add_row_item, write_short_goals_row, check_goals_completed, write_missing_goals, update_goals)
!include("list_core", new_row, add_current_row)
!include("wisp_count")

!if randomize {
    !random_boolean(voice)
    !random_boolean(strength)
    !random_boolean(memory)
    !random_boolean(eyes)
    !random_boolean(heart)
}

!let(wisps_required, 0)
!if voice { !let(wisps_required, wisps_required + 1) }
!if strength { !let(wisps_required, wisps_required + 1) }
!if memory { !let(wisps_required, wisps_required + 1) }
!if eyes { !let(wisps_required, wisps_required + 1) }
!if heart { !let(wisps_required, wisps_required + 1) }

!let(max_wisps, 5)
!let(tag, "Wisps (" + wisps_required + "/" + max_wisps + ")")
!if randomize { !tags("Random " + tag) }
!if randomize == false {
    !if wisps_required == max_wisps { !tags("All Wisps") }
    !if wisps_required < max_wisps { !tags(tag) }
}

on spawn store(itemTracker.wispsRequired, wisps_required)

!augment_fun(check_goals_completed(), {
    if itemTracker.wispsCount < wisps_required set_boolean("goals_completed", false)
})

!augment_fun(write_short_goals_row(), {
    set_string("wisps_message", "Wisps: " + itemTracker.wispsCount + "/" + wisps_required)
    if itemTracker.wispsCount == wisps_required set_string("wisps_message", "$" + get_string("wisps_message") + "$")
    add_row_item(get_string("wisps_message"))
})

!augment_fun(write_missing_goals(), if itemTracker.wispsCount < wisps_required write_missing_wisps())

fun write_missing_wisps() { new_row("#Missing Wisps (" + (wisps_required - itemTracker.wispsCount) + ")#: ") }
!if voice { !augment_fun(write_missing_wisps(), if EastHollow.ForestsVoice == false add_row_item("Voice")) }
!if strength { !augment_fun(write_missing_wisps(), if LowerReach.ForestsMemory == false add_row_item("Memory")) }
!if memory { !augment_fun(write_missing_wisps(), if UpperDepths.ForestsEyes == false add_row_item("Eyes")) }
!if eyes { !augment_fun(write_missing_wisps(), if WestPools.ForestsStrength == false add_row_item("Strength")) }
!if heart { !augment_fun(write_missing_wisps(), if WindtornRuins.Seir == false add_row_item("Heart")) }
!augment_fun(write_missing_wisps(), add_current_row())

on change itemTracker.wispsCount update_goals()

!if voice { on EastHollow.ForestsVoice create_stats_entry(Wisp, "Voice") }
!if strength { on WestPools.ForestsStrength create_stats_entry(Wisp, "Strength") }
!if memory { on LowerReach.ForestsMemory create_stats_entry(Wisp, "Memory") }
!if eyes { on UpperDepths.ForestsEyes create_stats_entry(Wisp, "Eyes") }
!if heart { on WindtornRuins.Seir create_stats_entry(Wisp, "Heart") }
