#category("Goals")
#name("All Wisps")
#description("Require visiting all Wisps before fighting Shriek")

!tags("All Wisps")

!include("goal_mode_core", write_goal_progress_message, check_goals_completed, write_goals_incomplete_message, update_goals_completed)
!include("wisp_count")

!let(max_wisps, 5)

!augment_fun(write_goal_progress_message(), {
    if get_boolean("comma") set_string("goal_progress_message", get_string("goal_progress_message") + ", ")
    set_boolean("comma", true)
    set_string("color", "")
    if itemTracker.wispsCount == max_wisps set_string("color", "$")
    write_wisps_message(get_string("color"))
    set_string("goal_progress_message", get_string("goal_progress_message") + get_string("wisps_message"))
})

!augment_fun(check_goals_completed(), {
    if itemTracker.wispsCount < max_wisps set_boolean("goals_completed", false)
})

on spawn store(itemTracker.wispsRequired, max_wisps)

on EastHollow.ForestsVoice create_stats_entry(Wisp, "Voice")
on WestPools.ForestsStrength create_stats_entry(Wisp, "Strength")
on LowerReach.ForestsMemory create_stats_entry(Wisp, "Memory")
on UpperDepths.ForestsEyes create_stats_entry(Wisp, "Eyes")
on WindtornRuins.Seir create_stats_entry(Wisp, "Heart")

on change itemTracker.wispsCount update_goals_completed()

!augment_fun(write_goals_incomplete_message(), {
    if itemTracker.wispsCount < max_wisps {
        write_wisps_message("@")
        set_string("goals_incomplete_message", get_string("goals_incomplete_message") + "\n" + get_string("wisps_message"))
    }
})

fun write_wisps_message(color: String) {
    set_string("wisps_message", color + "Wisps: " + itemTracker.wispsCount + "/" + max_wisps + color)
}
