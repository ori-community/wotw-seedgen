#category("Goals")
#name("Wisps")
#description("Require collecting Wisps before fighting Shriek")

!config_boolean(randomize, false, "Randomize", "Overrides all other settings with random values")

!config_boolean(voice, true, "Voice")
!config_boolean(strength, true, "Strength")
!config_boolean(memory, true, "Memory")
!config_boolean(eyes, true, "Eyes")
!config_boolean(heart, true, "Heart")

!include("goal_mode_core", write_short_goals_row, check_goals_completed, write_missing_goals, add_missing_goal_in_area, update_goals)
!include("list_core", new_row, add_row_item, add_current_row)

!if randomize {
    !random_boolean(voice)
    !random_boolean(strength)
    !random_boolean(memory)
    !random_boolean(eyes)
    !random_boolean(heart)
}

!let(wisps_required, 0)
!if voice { !let(wisps_required, wisps_required + 1) }
!if strength { !let(wisps_required, wisps_required + 1) }
!if memory { !let(wisps_required, wisps_required + 1) }
!if eyes { !let(wisps_required, wisps_required + 1) }
!if heart { !let(wisps_required, wisps_required + 1) }

!let(max_wisps, 5)
!let(tag, "Wisps (" + wisps_required + "/" + max_wisps + ")")
!if randomize { !tags("Random " + tag) }
!if randomize == false {
    !if wisps_required == max_wisps { !tags("All Wisps") }
    !if wisps_required < max_wisps { !tags(tag) }
}

on spawn store(tracker.wispsRequired, wisps_required)

!augment_fun(check_goals_completed(), {
    if tracker.wispsCollected < wisps_required set_boolean("goals_completed", false)
})

!augment_fun(write_short_goals_row(), {
    set_string("wisps_message", "Wisps: " + tracker.wispsCollected + "/" + wisps_required)
    if tracker.wispsCollected >= wisps_required set_string("wisps_message", "$" + get_string("wisps_message") + "$")
    add_row_item(get_string("wisps_message"))
})

!augment_fun(write_missing_goals(), if tracker.wispsCollected < wisps_required write_missing_wisps())

fun write_missing_wisps() { new_row("Missing Wisps (" + (wisps_required - tracker.wispsCollected) + "): ") }
!if voice { !augment_fun(write_missing_wisps(), if Hollow.Wisp == false add_missing_goal_in_area("Voice", player_area() == Hollow)) }
!if strength { !augment_fun(write_missing_wisps(), if Pools.Wisp == false add_missing_goal_in_area("Strength", player_area() == Pools)) }
!if memory { !augment_fun(write_missing_wisps(), if Reach.Wisp == false add_missing_goal_in_area("Memory", player_area() == Reach)) }
!if eyes { !augment_fun(write_missing_wisps(), if Depths.Wisp == false add_missing_goal_in_area("Eyes", player_area() == Depths)) }
!if heart { !augment_fun(write_missing_wisps(), if Ruins.Wisp == false add_missing_goal_in_area("Heart", player_area() == Ruins)) }
!augment_fun(write_missing_wisps(), add_current_row())

on change tracker.wispsCollected update_goals()

!if voice {
    on Hollow.Wisp {
        create_stats_entry(Wisp, "Voice")
        store(tracker.wispsCollected, tracker.wispsCollected + 1)
    }
    on Hollow.Wisp == false store(tracker.wispsCollected, tracker.wispsCollected - 1)
}

!if strength {
    on Pools.Wisp {
        create_stats_entry(Wisp, "Strength")
        store(tracker.wispsCollected, tracker.wispsCollected + 1)
    }
    on Pools.Wisp == false store(tracker.wispsCollected, tracker.wispsCollected - 1)
}

!if memory {
    on Reach.Wisp {
        create_stats_entry(Wisp, "Memory")
        store(tracker.wispsCollected, tracker.wispsCollected + 1)
    }
    on Reach.Wisp == false store(tracker.wispsCollected, tracker.wispsCollected - 1)
}

!if eyes {
    on Depths.Wisp {
        create_stats_entry(Wisp, "Eyes")
        store(tracker.wispsCollected, tracker.wispsCollected + 1)
    }
    on Depths.Wisp == false store(tracker.wispsCollected, tracker.wispsCollected - 1)
}

!if heart {
    on Ruins.Wisp {
        create_stats_entry(Wisp, "Heart")
        store(tracker.wispsCollected, tracker.wispsCollected + 1)
    }
    on Ruins.Wisp == false store(tracker.wispsCollected, tracker.wispsCollected - 1)
}
