#category("Item Pool")
#name("Bonus+")
#description("Game balance is now optional")

!tags("Bonus+")

!include("bonus_item_core",
    rapid_grenade,
    quickshot_upgrade,
    melting_blaze,
    melting_sword,
    melting_shuriken,
    uncharged_bashnade,
    extra_grenade,
    splinter_grenade,
    unlimited_sentries,
    sentry_burst_upgrade,
    sentry_fire_rate_upgrade,
    extra_shuriken,
    splinter_shuriken,
    bashable_shuriken,
    ultra_flap
)
!include("rapid_hammer_core", rapid_hammer)
!include("rapid_sword_core", rapid_sword)
!include("rapid_spear_core", rapid_spear)
!include("rapid_regenerate_core", rapid_regenerate)

!config(rapid_hammers, "Rapid Hammer Count", "Makes Hammer swing faster", Integer, 3)
!config(rapid_swords, "Rapid Sword Count", "Makes Sword swing faster", Integer, 0)
!config(rapid_spears, "Rapid Spear Count", "Makes Spear shoot faster", Integer, 2)
!config(rapid_regenerates, "Rapid Regenerate Count", "Makes Regenerate heal faster", Integer, 1)
!config(rapid_grenades, "Rapid Grenade Count", "Reduces the cooldown for Grenade", Integer, 2)
!config(quickshot_upgrades, "Quickshot Upgrade Count", "Makes Bow shoot faster with Quickshot equipped", Integer, 2)
!config(melting_blazes, "Melting Blaze Count", "Makes Blaze melt ice and light lanterns", Integer, 1)
!config(melting_swords, "Melting Sword Count", "Makes Sword melt ice and light lanterns", Integer, 1)
!config(melting_shurikens, "Melting Shuriken Count", "Makes Shuriken melt ice and light lanterns", Integer, 1)
!config(uncharged_bashnades, "Uncharged Bashgrenade Count", "Allows to bash Grenades that have been thrown midair", Integer, 1)
!config(extra_grenades, "Extra Grenade Count", "Allows having multiple Grenades on screen", Integer, 1)
!config(splinter_grenades, "Splinter Grenade Count", "Throw multiple Grenades at once", Integer, 2)
!config(unlimited_sentries, "Unlimited Sentry Count", "Allows spawning an unlimited amount of Sentries", Integer, 1)
!config(sentry_burst_upgrades, "Sentry Burst Upgrade Count", "Makes Sentries shoot more per burst", Integer, 1)
!config(sentry_fire_rate_upgrades, "Sentry Fire Rate Upgrade Count", "Makes Sentries shoot fastet", Integer, 1)
!config(extra_shurikens, "Extra Shuriken Count", "Allows having multiple Shurikens on screen", Integer, 1)
!config(splinter_shurikens, "Splinter Shuriken Count", "Throw multiple Shurikens at once", Integer, 2)
!config(bashable_shurikens, "Bashable Shuriken Count", "Allows bashing Shurikens", Integer, 1)
!config(ultra_flaps, "Ultra Flap Count", "Makes Flap deal damage", Integer, 3)

!add_item(rapid_hammer(), rapid_hammers)
!add_item(rapid_sword(), rapid_swords)
!add_item(rapid_spear(), rapid_spears)
!add_item(rapid_regenerate(), rapid_regenerates)
!add_item(rapid_grenade(), rapid_grenades)
!add_item(quickshot_upgrade(), quickshot_upgrades)
!add_item(melting_blaze(), melting_blazes)
!add_item(melting_sword(), melting_swords)
!add_item(melting_shuriken(), melting_shurikens)
!add_item(uncharged_bashnade(), uncharged_bashnades)
!add_item(extra_grenade(), extra_grenades)
!add_item(splinter_grenade(), splinter_grenades)
!add_item(unlimited_sentries(), unlimited_sentries)
!add_item(sentry_burst_upgrade(), sentry_burst_upgrades)
!add_item(sentry_fire_rate_upgrade(), sentry_fire_rate_upgrades)
!add_item(extra_shuriken(), extra_shurikens)
!add_item(splinter_shuriken(), splinter_shurikens)
!add_item(bashable_shuriken(), bashable_shurikens)
!add_item(ultra_flap(), ultra_flaps)
