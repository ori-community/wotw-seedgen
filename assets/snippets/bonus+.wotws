#category("Item Pool")
#name("Bonus+")
#description("Game balance is now optional")

!tags("Bonus+")

// TODO why is jumpgrades separate from this?

!include("bonus_item_core",
    rapid_grenade,
    quickshot_upgrade,
    melting_blaze,
    melting_sword,
    melting_shuriken,
    uncharged_bashnade,
    extra_grenade,
    splinter_grenade,
    unlimited_sentries,
    sentry_burst_upgrade,
    sentry_fire_rate_upgrade,
    extra_shuriken,
    splinter_shuriken,
    bashable_shuriken,
    ultra_flap,
    extra_launch
)
!include("rapid_hammer_core", rapid_hammer)
!include("rapid_sword_core", rapid_sword)
!include("rapid_spear_core", rapid_spear)
!include("rapid_regenerate_core", rapid_regenerate)

!config_integer(rapid_hammers, 3, "Rapid Hammer Count", "Makes Hammer swing faster")
!config_integer(rapid_swords, 0, "Rapid Sword Count", "Makes Sword swing faster")
!config_integer(rapid_spears, 2, "Rapid Spear Count", "Makes Spear shoot faster")
!config_integer(rapid_regenerates, 1, "Rapid Regenerate Count", "Makes Regenerate heal faster")
!config_integer(rapid_grenades, 2, "Rapid Grenade Count", "Reduces the cooldown for Grenade")
!config_integer(quickshot_upgrades, 2, "Quickshot Upgrade Count", "Makes Bow shoot faster with Quickshot equipped")
!config_integer(melting_blazes, 1, "Melting Blaze Count", "Makes Blaze melt ice and light lanterns")
!config_integer(melting_swords, 1, "Melting Sword Count", "Makes Sword melt ice and light lanterns")
!config_integer(melting_shurikens, 1, "Melting Shuriken Count", "Makes Shuriken melt ice and light lanterns")
!config_integer(uncharged_bashnades, 1, "Uncharged Bashgrenade Count", "Allows to bash Grenades that have been thrown midair")
!config_integer(extra_grenades, 1, "Extra Grenade Count", "Allows having multiple Grenades on screen")
!config_integer(splinter_grenades, 2, "Splinter Grenade Count", "Throw multiple Grenades at once")
!config_integer(unlimited_sentries, 1, "Unlimited Sentry Count", "Allows spawning an unlimited amount of Sentries")
!config_integer(sentry_burst_upgrades, 1, "Sentry Burst Upgrade Count", "Makes Sentries shoot more per burst")
!config_integer(sentry_fire_rate_upgrades, 1, "Sentry Fire Rate Upgrade Count", "Makes Sentries shoot fastet")
!config_integer(extra_shurikens, 1, "Extra Shuriken Count", "Allows having multiple Shurikens on screen")
!config_integer(splinter_shurikens, 2, "Splinter Shuriken Count", "Throw multiple Shurikens at once")
!config_integer(bashable_shurikens, 1, "Bashable Shuriken Count", "Allows bashing Shurikens")
!config_integer(ultra_flaps, 3, "Ultra Flap Count", "Makes Flap deal damage")
!config_integer(extra_launch, 0, "Extra Launch Count", "Add extra launches when having Launch")

!add_item(rapid_hammer(), rapid_hammers)
!add_item(rapid_sword(), rapid_swords)
!add_item(rapid_spear(), rapid_spears)
!add_item(rapid_regenerate(), rapid_regenerates)
!add_item(rapid_grenade(), rapid_grenades)
!add_item(quickshot_upgrade(), quickshot_upgrades)
!add_item(melting_blaze(), melting_blazes)
!add_item(melting_sword(), melting_swords)
!add_item(melting_shuriken(), melting_shurikens)
!add_item(uncharged_bashnade(), uncharged_bashnades)
!add_item(extra_grenade(), extra_grenades)
!add_item(splinter_grenade(), splinter_grenades)
!add_item(unlimited_sentries(), unlimited_sentries)
!add_item(sentry_burst_upgrade(), sentry_burst_upgrades)
!add_item(sentry_fire_rate_upgrade(), sentry_fire_rate_upgrades)
!add_item(extra_shuriken(), extra_shurikens)
!add_item(splinter_shuriken(), splinter_shurikens)
!add_item(bashable_shuriken(), bashable_shurikens)
!add_item(ultra_flap(), ultra_flaps)
!add_item(extra_launch(), extra_launch)
