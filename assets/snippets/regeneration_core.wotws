#hidden
#name("Regeneration Core")
#description("Implements passive energy and health regeneration")

!include("delta_time", tick)

!state(energy_per_second, Float)
!export(energy_per_second)

!state(health_per_second, Float)
!export(health_per_second)

!augment_fun(tick(delta: Float), {
    if energy_per_second != 0 store(player.energy, player.energy + energy_per_second * delta)
    if health_per_second != 0 store(player.health, player.health + health_per_second * delta)
})
