#hidden
#name("Tuley Shop Core")
#description("Exposes states to control Tuley shop behavior")

!state(lightcatchers, Boolean)
!export(lightcatchers)
!state(sela_flowers, Boolean)
!export(sela_flowers)
!state(blue_moon, Boolean)
!export(blue_moon)
!state(sticky_grass, Boolean)
!export(sticky_grass)
!state(spring_plants, Boolean)
!export(spring_plants)
!state(last_tree, Boolean)
!export(last_tree)

on spawn set_shop_item_hidden(tuleyShop.lightcatchers, lightcatchers == false)
on change lightcatchers set_shop_item_hidden(tuleyShop.lightcatchers, lightcatchers == false)
on spawn set_shop_item_hidden(tuleyShop.selaFlowers, sela_flowers == false)
on change sela_flowers set_shop_item_hidden(tuleyShop.selaFlowers, sela_flowers == false)
on spawn set_shop_item_hidden(tuleyShop.blueMoon, blue_moon == false)
on change blue_moon set_shop_item_hidden(tuleyShop.blueMoon, blue_moon == false)
on spawn set_shop_item_hidden(tuleyShop.stickyGrass, sticky_grass == false)
on change sticky_grass set_shop_item_hidden(tuleyShop.stickyGrass, sticky_grass == false)
on spawn set_shop_item_hidden(tuleyShop.springPlants, spring_plants == false)
on change spring_plants set_shop_item_hidden(tuleyShop.springPlants, spring_plants == false)
on spawn set_shop_item_hidden(tuleyShop.lastTree, last_tree == false)
on change last_tree set_shop_item_hidden(tuleyShop.lastTree, last_tree == false)
