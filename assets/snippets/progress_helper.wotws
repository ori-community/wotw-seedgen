fun update_entrance_progress() {
    write_entrance_progress()
    set_message_text("entrance_progress", get_string("entrance_progress"))
}

!let(door_side_color, "<hex_ffaa00cc>")
!let(outside, door_side_color + "Outside</>")
!let(inside, door_side_color + "Inside</>")
!let(moki_father_hut_outside, "#Moki Father Hut# " + outside)
!let(moki_father_hut_inside, "#Moki Father Hut# " + inside)
