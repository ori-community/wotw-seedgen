#category("Quality of Life")
#category("Quality of Life")
#name("Progress Helper")
#description("
Tracks your progress as you play
By default those are bound to
- Alt+P (general progress)
- Alt+1 (missing goals)
- Alt+2 (trees and wisps)
- Alt+3 (quests)
- Alt+4 (teleporters)
- Alt+5 (entrances)
")

// TODO interface settings instead
!config(entrance_helper, "Entrance Helper", "Documents entrance connections", Boolean, true)

// TODO there's a regression here because previously progress messages were in a consistent order

// To add a progress message from your header, use the write_progress_message event and add_row
// If you also want to add to the progress displayed over the map, use the write_map_progress_message event and add_row
//
// This example shows how to add a line "Fun: 10/10" into both the progress message and the map:
// !include("progress_helper", write_progress_message, write_map_progress_message)
// !include("list_core", add_row)
//
// !augment_fun(write_progress_message(), add_row("Fun: 10/10"))
// !augment_fun(write_map_progress_message(), add_row("Fun: 10/10"))

!include("color_core", transparent, invisible)
!include("list_core", new_column, add_row, next_item_first, new_colored_row, add_colored_row_item)
!include("stats")

!builtin_icon(progress_summary_icon, "icons/wheel/progress_summary.blue.png") // TODO inconsistent casing in the icon filenames
!builtin_icon(tree_progress_icon, "icons/wheel/tree_progress.blue.png")
!builtin_icon(wisp_progress_icon, "icons/wheel/wisps_progress.png") // TODO why do others have blue and this one not
!builtin_icon(quest_progress_icon, "icons/wheel/quests_progress.blue.png") // TODO some filenames are singular, some plural...
!builtin_icon(teleporter_icon, "icons/game/teleporter.png")
!builtin_icon(entrance_connections_icon, "icons/wheel/entrance_connections.blue.png")

!export(write_progress_message)
fun write_progress_message() {
    new_column("")
    add_pickups_row("", randoStats.pickupsCollected, randoStats.pickupsTotal)
    add_zone_pickups_row(player.currentArea)
}

!export(write_map_progress_message)
fun write_map_progress_message() {
    new_column("")
    add_zone_pickups_row(player.currentMapArea)
}

fun add_zone_pickups_row(zone: Integer) {
    if zone == 0 {
        add_pickups_row("Marsh ", randoStats.pickupsCollectedMarsh, randoStats.pickupsTotalMarsh)
    }
    if zone == 1 {
        add_pickups_row("Hollow ", randoStats.pickupsCollectedHollow, randoStats.pickupsTotalHollow)
    }
    if zone == 2 {
        add_pickups_row("Glades ", randoStats.pickupsCollectedGlades, randoStats.pickupsTotalGlades)
    }
    if zone == 3 {
        add_pickups_row("Wellspring ", randoStats.pickupsCollectedWellspring, randoStats.pickupsTotalWellspring)
    }
    if zone == 4 {
        add_pickups_row("Woods ", randoStats.pickupsCollectedWoods, randoStats.pickupsTotalWoods)
    }
    if zone == 5 {
        add_pickups_row("Reach ", randoStats.pickupsCollectedReach, randoStats.pickupsTotalReach)
    }
    if zone == 6 {
        add_pickups_row("Depths ", randoStats.pickupsCollectedDepths, randoStats.pickupsTotalDepths)
    }
    if zone == 7 {
        add_pickups_row("Pools ", randoStats.pickupsCollectedPools, randoStats.pickupsTotalPools)
    }
    if zone == 8 {
        add_pickups_row("Wastes ", randoStats.pickupsCollectedWastes, randoStats.pickupsTotalWastes)
    }
    if zone == 9 {
        add_pickups_row("Ruins ", randoStats.pickupsCollectedRuins, randoStats.pickupsTotalRuins)
    }
    if zone == 10 {
        add_pickups_row("Willow ", randoStats.pickupsCollectedWillow, randoStats.pickupsTotalWillow)
    }
    if zone == 11 {
        add_pickups_row("Burrows ", randoStats.pickupsCollectedBurrows, randoStats.pickupsTotalBurrows)
    }
}

fun add_pickups_row(zone: String, collected: Integer, total: Integer) {
    set_string("color", "")
    if collected >= total set_string("color", "$")
    add_row(zone + "Pickups: " + get_string("color") + collected + "/" + total + get_string("color"))
}

!state(disable_keybinds, Boolean)
!export(disable_keybinds)

on reload {
    set_wheel_item_data(
        "root",
        Top,
        "Progress Helper",
        "[Ability1]Open Menu\n[Ability2]View Summary",
        progress_summary_icon,
    )
    set_wheel_item_action("root", Top, Ability1, switch_wheel("progress_helper"))
    set_wheel_item_action("root", Top, Ability2, trigger_client_event(progress_message))
    set_wheel_item_action("root", Top, Ability3, trigger_client_event(progress_message))

    set_wheel_item_data(
        "progress_helper",
        Top,
        "Summary",
        "[Ability1]View Summary",
        progress_summary_icon,
    )
    set_wheel_item_all_actions("progress_helper", Top, trigger_client_event(progress_message))

    set_wheel_item_data(
        "progress_helper",
        RightTop,
        "Tree Progress",
        "[Ability1]View Progress",
        tree_progress_icon,
    )
    set_wheel_item_all_actions("progress_helper", RightTop, {
        write_tree_progress()
        controlled_priority_message("tree_progress", get_string("tree_progress"), 4)
    })

    set_wheel_item_data(
        "progress_helper",
        Right,
        "Wisp Progress",
        "[Ability1]View Progress",
        wisp_progress_icon,
    )
    set_wheel_item_all_actions("progress_helper", Right, {
        write_wisp_progress()
        controlled_priority_message("wisp_progress", get_string("wisp_progress"), 4)
    })

    set_wheel_item_data(
        "progress_helper",
        RightBottom,
        "Quest Progress",
        "[Ability1]View Progress",
        quest_progress_icon,
    )
    set_wheel_item_all_actions("progress_helper", RightBottom, show_quest_progress())

    set_wheel_item_data(
        "progress_helper",
        BottomRight,
        "Teleporter Progress",
        "[Ability1]View Progress",
        teleporter_icon,
    )
    set_wheel_item_all_actions("progress_helper", BottomRight, show_teleporter_progress())
}

!if entrance_helper {
    on reload {
        set_wheel_item_data(
            "progress_helper",
            Bottom,
            "Entrance Progress",
            "[Ability1]View Progress",
            entrance_connections_icon,
        )
        set_wheel_item_all_actions("progress_helper", Bottom, show_entrance_progress())
    }
}

on progress_message {
    write_progress_message()
    controlled_priority_message("progress_message", get_string("column"), 4)
}

!export(update_progress_message)
fun update_progress_message() {
    write_progress_message()
    set_message_text("progress_message", get_string("column"))
}

on change randoStats.pickupsCollected update_progress_message()
on change randoStats.pickupsTotal update_progress_message()
on change player.currentArea update_progress_message()

on reload {
    free_message("map_message", "")
    set_message_position("map_message", 0.5, 0.84)
    set_message_vertical_anchor("map_message", Bottom)
    set_message_background("map_message", false)
}

// TODO we call this "zone", not "area"
on change player.currentMapArea {
    if player.currentMapArea < 12 {
        write_map_progress_message()
        set_integer("length", string_length(get_string("column")))

        if get_integer("length") > 125 {
            if get_integer("length") > 250 {
                set_string("column", "<s_0.7><ls_0.7>" + get_string("column") + "</></>")
            }
            if get_integer("length") <= 250 {
                set_string("column", "<s_0.85><ls_0.85>" + get_string("column") + "</></>")
            }
        }

        set_message_text("map_message", get_string("column"))
    }
    if player.currentMapArea >= 12 set_message_text("map_message", "")
}

on binding2 if disable_keybinds == false {
    write_tree_progress()
    write_wisp_progress()
    controlled_priority_message("tree_wisp_progress", get_string("tree_progress") + "\n" + get_string("wisp_progress"), 4)
}
on binding3 if disable_keybinds == false show_quest_progress()
on binding4 if disable_keybinds == false show_teleporter_progress()

!if entrance_helper {
    on binding5 if disable_keybinds == false show_entrance_progress()
}

fun write_tree_progress() {
    new_colored_row("#Trees found#: ")
    tree_string(true)

    new_colored_row(get_string("row") + "\n#Trees remaining#: ")
    tree_string(false)

    set_string("tree_progress", get_string("row"))
}

on change MarshSpawn.RegenTree update_tree_progress()
on change HowlsDen.SwordTree update_tree_progress()
on change HowlsDen.DoubleJumpTree update_tree_progress()
on change MarshPastOpher.BowTree update_tree_progress()
on change WestHollow.DashTree update_tree_progress()
on change EastHollow.BashTree update_tree_progress()
on change InnerWellspring.GrappleTree update_tree_progress()
on change MarshSpawn.DamageTree update_tree_progress()
on change GladesTown.DamageTree update_tree_progress()
on change LowerWastes.BurrowTree update_tree_progress()
on change UpperReach.GrenadeTree update_tree_progress()
on change LowerDepths.FlashTree update_tree_progress()
on change UpperPools.WaterDashTree update_tree_progress()
on change WeepingRidge.LaunchTree update_tree_progress()
fun update_tree_progress() {
    write_tree_progress()
    set_message_text("tree_progress", get_string("tree_progress"))
    set_message_text("tree_wisp_progress", get_string("tree_progress") + "\n" + get_string("wisp_progress"))
}

fun tree_string(found: Boolean) {
    if MarshSpawn.RegenTree == found add_colored_row_item("Regenerate")
    if HowlsDen.SwordTree == found add_colored_row_item("Sword")
    if HowlsDen.DoubleJumpTree == found add_colored_row_item("Double Jump")
    if MarshPastOpher.BowTree == found add_colored_row_item("Bow")
    if WestHollow.DashTree == found add_colored_row_item("Dash")
    if EastHollow.BashTree == found add_colored_row_item("Bash")
    if InnerWellspring.GrappleTree == found add_colored_row_item("Grapple")
    if MarshSpawn.DamageTree == found add_colored_row_item("Marsh Ancestral Light")
    if GladesTown.DamageTree == found add_colored_row_item("Glades Ancestral Light")
    if LowerWastes.BurrowTree == found add_colored_row_item("Burrow")
    if UpperReach.GrenadeTree == found add_colored_row_item("Grenade")
    if LowerDepths.FlashTree == found add_colored_row_item("Flash")
    if UpperPools.WaterDashTree == found add_colored_row_item("Water Dash")
    if WeepingRidge.LaunchTree == found add_colored_row_item("Launch")

    if get_integer("next_item") == next_item_first set_string("row", get_string("row") + "None")
}

fun write_wisp_progress() {
    new_colored_row("#Wisps found#: ")
    wisp_string(true)

    new_colored_row(get_string("row") + "\n#Wisps remaining#: ")
    wisp_string(false)

    set_string("wisp_progress", get_string("row"))
}

on change EastHollow.ForestsVoice update_wisp_progress()
on change LowerReach.ForestsMemory update_wisp_progress()
on change UpperDepths.ForestsEyes update_wisp_progress()
on change WestPools.ForestsStrength update_wisp_progress()
on change WindtornRuins.Seir update_wisp_progress()
fun update_wisp_progress() {
    write_wisp_progress()
    set_message_text("wisp_progress", get_string("wisp_progress"))
    set_message_text("tree_wisp_progress", get_string("tree_progress") + "\n" + get_string("wisp_progress"))
}

fun wisp_string(found: Boolean) {
    if EastHollow.ForestsVoice == found add_colored_row_item("Voice")
    if LowerReach.ForestsMemory == found add_colored_row_item("Memory")
    if UpperDepths.ForestsEyes == found add_colored_row_item("Eyes")
    if WestPools.ForestsStrength == found add_colored_row_item("Strength")
    if WindtornRuins.Seir == found add_colored_row_item("Heart")

    if get_integer("next_item") == next_item_first set_string("row", get_string("row") + "None")
}

fun show_quest_progress() {
    write_quest_progress()
    controlled_priority_message("quest_progress", get_string("quest_progress"), 6.0)
}

on change kwolokGroupDescriptor.cleanseWellspringQuestUberState update_quest_progress()
on change npcsStateGroup.marshKeystoneQuest update_quest_progress()
on change npcsStateGroup.inkwaterWellQuest update_quest_progress()
on change questUberStateGroup.lostCompassQuest update_quest_progress()
on change questUberStateGroup.braveMokiQuest update_quest_progress()
on change questUberStateGroup.familyReunionQuest update_quest_progress()
on change questUberStateGroup.braveMokiQuest update_quest_progress()
on change questUberStateGroup.desertCogQuest update_quest_progress()
on change questUberStateGroup.tradeSequenceQuest update_quest_progress()
on change questUberStateGroup.darkCaveQuest update_quest_progress()
on change questUberStateGroup.kwoloksWisdomQuest update_quest_progress()
on change questUberStateGroup.rebuildGladesQuest update_quest_progress()
on change questUberStateGroup.regrowGladesQuest update_quest_progress()
fun update_quest_progress() {
    write_quest_progress()
    set_message_text("quest_progress", get_string("quest_progress"))
}

fun write_quest_progress() {
    // TODO add quest aliases?
    set_string("quest_progress", "#Silent Teeth# - ")
    if kwolokGroupDescriptor.cleanseWellspringQuestUberState == 0 set_string("quest_progress", get_string("quest_progress") + "Meet Kwolok")
    if kwolokGroupDescriptor.cleanseWellspringQuestUberState == 1 set_string("quest_progress", get_string("quest_progress") + "Restart the Mill")
    if kwolokGroupDescriptor.cleanseWellspringQuestUberState == 2 set_string("quest_progress", get_string("quest_progress") + "Search the Mill")
    if kwolokGroupDescriptor.cleanseWellspringQuestUberState == 3 set_string("quest_progress", get_string("quest_progress") + "Return to Kwolok")
    if kwolokGroupDescriptor.cleanseWellspringQuestUberState == 4 set_string("quest_progress", get_string("quest_progress") + "$Complete$")
    set_string("quest_progress", get_string("quest_progress") + "\n#Missing Key# - ")
    if npcsStateGroup.marshKeystoneQuest == 0 set_string("quest_progress", get_string("quest_progress") + "Meet Tokk in a Cave")
    if npcsStateGroup.marshKeystoneQuest == 1 set_string("quest_progress", get_string("quest_progress") + "Find the Keystone")
    if npcsStateGroup.marshKeystoneQuest == 2 set_string("quest_progress", get_string("quest_progress") + "Show the Keystone to Tokk")
    if npcsStateGroup.marshKeystoneQuest == 3 set_string("quest_progress", get_string("quest_progress") + "$Complete$")
    set_string("quest_progress", get_string("quest_progress") + "\n#Into Burrows# - ")
    if npcsStateGroup.inkwaterWellQuest == 0 set_string("quest_progress", get_string("quest_progress") + "Meet Tokk above the Midnight Burrows")
    if npcsStateGroup.inkwaterWellQuest == 1 || npcsStateGroup.inkwaterWellQuest == 2 set_string("quest_progress", get_string("quest_progress") + "Find the artifact in the Midnight Burrows")
    if npcsStateGroup.inkwaterWellQuest == 3 set_string("quest_progress", get_string("quest_progress") + "Return to Tokk")
    if npcsStateGroup.inkwaterWellQuest == 4 set_string("quest_progress", get_string("quest_progress") + "$Complete$")
    set_string("quest_progress", get_string("quest_progress") + "\n#Lost Compass# - ")
    if questUberStateGroup.lostCompassQuest == 0 set_string("quest_progress", get_string("quest_progress") + "Meet Tokk at the Wellspring")
    if questUberStateGroup.lostCompassQuest == 1 set_string("quest_progress", get_string("quest_progress") + "Find Tokk's Compass")
    if questUberStateGroup.lostCompassQuest == 2 set_string("quest_progress", get_string("quest_progress") + "Return the iron needle to Tokk")
    if questUberStateGroup.lostCompassQuest == 3 set_string("quest_progress", get_string("quest_progress") + "$Complete$")
    set_string("quest_progress", get_string("quest_progress") + "\n#Little Braver# - ")
    if questUberStateGroup.braveMokiQuest == 0 set_string("quest_progress", get_string("quest_progress") + "Meet Mokk the Brave near where you fought Howl")
    if questUberStateGroup.braveMokiQuest == 1 set_string("quest_progress", get_string("quest_progress") + "Find a Howl fang near where you fought Howl")
    if questUberStateGroup.braveMokiQuest == 2 set_string("quest_progress", get_string("quest_progress") + "Give the Howl fang to Mokk the Brave")
    if questUberStateGroup.braveMokiQuest == 3 set_string("quest_progress", get_string("quest_progress") + "$Complete$")
    set_string("quest_progress", get_string("quest_progress") + "\n#Family Reunion# - ")
    if questUberStateGroup.familyReunionQuest == 0 set_string("quest_progress", get_string("quest_progress") + "Meet a father Moki in the Wellspring Glades")
    if questUberStateGroup.familyReunionQuest == 1 set_string("quest_progress", get_string("quest_progress") + "Talk to Grom about building a home")
    if questUberStateGroup.familyReunionQuest == 2 set_string("quest_progress", get_string("quest_progress") + "Find the Moki family near the Silent Woods")
    if questUberStateGroup.familyReunionQuest == 3 set_string("quest_progress", get_string("quest_progress") + "Return to the Moki father with the bad news")
    if questUberStateGroup.familyReunionQuest == 4 set_string("quest_progress", get_string("quest_progress") + "@Complete@")
    set_string("quest_progress", get_string("quest_progress") + "\n#Tree Keeper# - ")
    if questUberStateGroup.treeKeeperQuest == 0 set_string("quest_progress", get_string("quest_progress") + "Meet the Tree Keeper in the Silent Woods")
    if questUberStateGroup.treeKeeperQuest == 1 set_string("quest_progress", get_string("quest_progress") + "Find someone who knows a lot about plants")
    if questUberStateGroup.treeKeeperQuest == 2 set_string("quest_progress", get_string("quest_progress") + "Bring the Tree Keeper the bad news")
    if questUberStateGroup.treeKeeperQuest == 3 set_string("quest_progress", get_string("quest_progress") + "$Complete$")
    set_string("quest_progress", get_string("quest_progress") + "\n#Rough Diamond# - ")
    if questUberStateGroup.desertCogQuest <= 1 set_string("quest_progress", get_string("quest_progress") + "Explore the Windswept Wastes near the Shovel")
    if questUberStateGroup.desertCogQuest == 2 set_string("quest_progress", get_string("quest_progress") + "Find a use for the metal cog")
    if questUberStateGroup.desertCogQuest == 3 set_string("quest_progress", get_string("quest_progress") + "Go treasure hunting in the Gorlek Mines")
    if questUberStateGroup.desertCogQuest == 4 set_string("quest_progress", get_string("quest_progress") + "Take the eerie gem to a specialist (Twillen)")
    if questUberStateGroup.desertCogQuest == 5 set_string("quest_progress", get_string("quest_progress") + "$Complete$")
    set_string("quest_progress", get_string("quest_progress") + "\n#Hand to Hand# - ")
    if questUberStateGroup.tradeSequenceQuest == 0 set_string("quest_progress", get_string("quest_progress") + "Meet a Moki near where you fought Hornbeetle")
    if questUberStateGroup.tradeSequenceQuest == 1 set_string("quest_progress", get_string("quest_progress") + "Find a wanderer with an interest in maps (Tokk)")
    if questUberStateGroup.tradeSequenceQuest == 2 set_string("quest_progress", get_string("quest_progress") + "Find an aspiring adventurer who might need a small bag (Moki in Wellspring)")
    if questUberStateGroup.tradeSequenceQuest == 3 set_string("quest_progress", get_string("quest_progress") + "Find someone who might have a use for herbs (Veral in Glades)")
    if questUberStateGroup.tradeSequenceQuest == 4 set_string("quest_progress", get_string("quest_progress") + "Find someone in need of a warm meal (Moki in Reach)")
    if questUberStateGroup.tradeSequenceQuest == 5 set_string("quest_progress", get_string("quest_progress") + "Find someone who needs a hat (Moki in Glades)")
    if questUberStateGroup.tradeSequenceQuest == 6 set_string("quest_progress", get_string("quest_progress") + "Find someone in need of light (Moki in Depths)")
    if questUberStateGroup.tradeSequenceQuest == 7 set_string("quest_progress", get_string("quest_progress") + "Find someone who needs string (Moki in Pools)")
    if questUberStateGroup.tradeSequenceQuest == 8 set_string("quest_progress", get_string("quest_progress") + "Find someone who needs a spyglass (Motay in Glades)")
    if questUberStateGroup.tradeSequenceQuest == 9 set_string("quest_progress", get_string("quest_progress") + "Find someone in need of drinking water (Gorlek Miner in Wastes)")
    if questUberStateGroup.tradeSequenceQuest == 10 set_string("quest_progress", get_string("quest_progress") + "Find the ancient Map Stone (Windtorn Ruins)")
    if questUberStateGroup.tradeSequenceQuest == 11 set_string("quest_progress", get_string("quest_progress") + "$Complete$")
    set_string("quest_progress", get_string("quest_progress") + "\n#Into Darkness# - ")
    if questUberStateGroup.darkCaveQuest == 0 set_string("quest_progress", get_string("quest_progress") + "Meet the Moki in front of a cave in Glades")
    if questUberStateGroup.darkCaveQuest == 1 set_string("quest_progress", get_string("quest_progress") + "Find a way into the Cave to retrieve the Moki's keepsake")
    if questUberStateGroup.darkCaveQuest == 2 set_string("quest_progress", get_string("quest_progress") + "Return the acorn to the Moki")
    if questUberStateGroup.darkCaveQuest == 3 set_string("quest_progress", get_string("quest_progress") + "$Complete$")
    set_string("quest_progress", get_string("quest_progress") + "\n#Kwolok's Wisdom# - ")
    if questUberStateGroup.kwoloksWisdomQuest == 0 set_string("quest_progress", get_string("quest_progress") + "Meet a Moki in Luma Pools")
    if questUberStateGroup.kwoloksWisdomQuest == 1 set_string("quest_progress", get_string("quest_progress") + "Find Kwolok and report back")
    if questUberStateGroup.kwoloksWisdomQuest == 2 set_string("quest_progress", get_string("quest_progress") + "Give the Amulet to Kwolok")
    if questUberStateGroup.kwoloksWisdomQuest == 3 set_string("quest_progress", get_string("quest_progress") + "Take the Amulet to Kwolok's Altar")
    if questUberStateGroup.kwoloksWisdomQuest == 4 set_string("quest_progress", get_string("quest_progress") + "$Complete$")
    set_string("quest_progress", get_string("quest_progress") + "\n#Rebuilding the Glades# - ")
    if GladesTown.RebuildTheGlades == false set_string("quest_progress", get_string("quest_progress") + "Help Grom rebuild the Wellspring Glades")
    if GladesTown.RebuildTheGlades set_string("quest_progress", get_string("quest_progress") + "$Complete$")
    set_string("quest_progress", get_string("quest_progress") + "\n#Regrowing the Glades# - ")
    if GladesTown.RegrowTheGlades == false set_string("quest_progress", get_string("quest_progress") + "Help Tuley regrow the flora of the Wellspring Glades")
    if GladesTown.RegrowTheGlades set_string("quest_progress", get_string("quest_progress") + "$Complete$")
}

fun show_teleporter_progress() {
    write_teleporter_progress()
    controlled_priority_message("teleporter_progress", get_string("row"), 4)
}

on change MarshSpawn.TeleporterActive update_teleporter_progress()
on change HowlsDen.TeleporterActive update_teleporter_progress()
on change EastHollow.TeleporterActive update_teleporter_progress()
on change GladesTown.TeleporterActive update_teleporter_progress()
on change InnerWellspring.TeleporterActive update_teleporter_progress()
on change MidnightBurrows.TeleporterActive update_teleporter_progress()
on change WoodsEntry.TeleporterActive update_teleporter_progress()
on change WoodsMain.TeleporterActive update_teleporter_progress()
on change LowerReach.TeleporterActive update_teleporter_progress()
on change UpperDepths.TeleporterActive update_teleporter_progress()
on change EastPools.TeleporterActive update_teleporter_progress()
on change WestPools.TeleporterActive update_teleporter_progress()
on change LowerWastes.FeedingGroundsTeleporterActive update_teleporter_progress()
on change LowerWastes.CentralTeleporterActive update_teleporter_progress()
on change UpperWastes.TeleporterActive update_teleporter_progress()
on change WindtornRuins.TeleporterActive update_teleporter_progress()
on change WillowsEnd.InnerTeleporterActive update_teleporter_progress()
on change WillowsEnd.ShriekTeleporterActive update_teleporter_progress()
fun update_teleporter_progress() {
    write_teleporter_progress()
    set_message_text("teleporter_progress", get_string("row"))
}

fun write_teleporter_progress() {
    new_colored_row("#Teleporters activated#: ")

    if MarshSpawn.TeleporterActive add_colored_row_item("Inkwater Marsh")
    if HowlsDen.TeleporterActive add_colored_row_item("Howl's Den")
    if EastHollow.TeleporterActive add_colored_row_item("Kwolok's Hollow")
    if GladesTown.TeleporterActive add_colored_row_item("Glades")
    if InnerWellspring.TeleporterActive add_colored_row_item("Wellspring")
    if MidnightBurrows.TeleporterActive add_colored_row_item("Midnight Burrows")
    if WoodsEntry.TeleporterActive add_colored_row_item("Woods Entrance")
    if WoodsMain.TeleporterActive add_colored_row_item("Woods Exit")
    if LowerReach.TeleporterActive add_colored_row_item("Baur's Reach")
    if UpperDepths.TeleporterActive add_colored_row_item("Mouldwood Depths")
    if EastPools.TeleporterActive add_colored_row_item("Central Pools")
    if WestPools.TeleporterActive add_colored_row_item("Pools Boss")
    if LowerWastes.FeedingGroundsTeleporterActive add_colored_row_item("Feeding Grounds")
    if LowerWastes.CentralTeleporterActive add_colored_row_item("Central Wastes")
    if UpperWastes.TeleporterActive add_colored_row_item("Outer Ruins")
    if WindtornRuins.TeleporterActive add_colored_row_item("Inner Ruins")
    if WillowsEnd.InnerTeleporterActive add_colored_row_item("Willow's End")
    if WillowsEnd.ShriekTeleporterActive add_colored_row_item("Shriek")

    if get_integer("next_item") == next_item_first set_string("row", get_string("row") + "None")
}

