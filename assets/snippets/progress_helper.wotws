    fun write_entrance_progress() {
        // negative margin hack
        set_string("entrance_progress", "<ls_-1.5>" + invisible + ".</></>\n<s_0.7><ls_0.7>")
        entrance_string_piece(moki_father_hut_outside, knownEntranceConnections.mokiFatherHutOutside, entrances.mokiFatherHutOutside)
        entrance_string_piece("\n" + moki_father_hut_inside, knownEntranceConnections.mokiFatherHutInside, entrances.mokiFatherHutInside)
        entrance_string_piece("\n" + hut_above_motay_outside, knownEntranceConnections.hutAboveMotayOutside, entrances.hutAboveMotayOutside)
        entrance_string_piece("\n" + hut_above_motay_inside, knownEntranceConnections.hutAboveMotayInside, entrances.hutAboveMotayInside)
        entrance_string_piece("\n" + storage_hut_outside, knownEntranceConnections.storageHutOutside, entrances.storageHutOutside)
        entrance_string_piece("\n" + storage_hut_inside, knownEntranceConnections.storageHutInside, entrances.storageHutInside)
        entrance_string_piece("\n" + tree_hut_outside, knownEntranceConnections.treeHutOutside, entrances.treeHutOutside)
        entrance_string_piece("\n" + tree_hut_inside, knownEntranceConnections.treeHutInside, entrances.treeHutInside)
        entrance_string_piece("\n" + last_hut_outside, knownEntranceConnections.lastHutOutside, entrances.lastHutOutside)
        entrance_string_piece("\n" + last_hut_inside, knownEntranceConnections.lastHutInside, entrances.lastHutInside)
        entrance_string_piece("\n" + cave_outside, knownEntranceConnections.caveOutside, entrances.caveOutside)
        entrance_string_piece("\n" + cave_inside, knownEntranceConnections.caveInside, entrances.caveInside)
        entrance_string_piece("\n" + lupo_shop_outside, knownEntranceConnections.lupoShopOutside, entrances.lupoShopOutside)
        entrance_string_piece("\n" + lupo_shop_inside, knownEntranceConnections.lupoShopInside, entrances.lupoShopInside)
        entrance_string_piece("\n" + wellspring_1st_floor_bottom_outside, knownEntranceConnections.wellspring1stFloorBottomOutside, entrances.wellspring1stFloorBottomOutside)
        entrance_string_piece("\n" + wellspring_1st_floor_bottom_inside, knownEntranceConnections.wellspring1stFloorBottomInside, entrances.wellspring1stFloorBottomInside)
        entrance_string_piece("\n" + wellspring_1st_floor_top_outside, knownEntranceConnections.wellspring1stFloorTopOutside, entrances.wellspring1stFloorTopOutside)
        entrance_string_piece("\n" + wellspring_1st_floor_top_inside, knownEntranceConnections.wellspring1stFloorTopInside, entrances.wellspring1stFloorTopInside)
        entrance_string_piece("\n" + wellspring_2nd_floor_outside, knownEntranceConnections.wellspring2ndFloorOutside, entrances.wellspring2ndFloorOutside)
        entrance_string_piece("\n" + wellspring_2nd_floor_inside, knownEntranceConnections.wellspring2ndFloorInside, entrances.wellspring2ndFloorInside)
        entrance_string_piece("\n" + wellspring_3rd_floor_outside, knownEntranceConnections.wellspring3rdFloorOutside, entrances.wellspring3rdFloorOutside)
        entrance_string_piece("\n" + wellspring_3rd_floor_inside, knownEntranceConnections.wellspring3rdFloorInside, entrances.wellspring3rdFloorInside)
        entrance_string_piece("\n" + teddy_hut_outside, knownEntranceConnections.teddyHutOutside, entrances.teddyHutOutside)
        entrance_string_piece("\n" + teddy_hut_inside, knownEntranceConnections.teddyHutInside, entrances.teddyHutInside)
        entrance_string_piece("\n" + reach_hut_outside, knownEntranceConnections.reachSeedOutside, entrances.reachSeedOutside)
        entrance_string_piece("\n" + reach_hut_inside, knownEntranceConnections.reachSeedInside, entrances.reachSeedInside)
        entrance_string_piece("\n" + ruins_outside, knownEntranceConnections.ruinsOutside, entrances.ruinsOutside)
        entrance_string_piece("\n" + ruins_inside, knownEntranceConnections.ruinsInside, entrances.ruinsInside)
        entrance_string_piece("\n" + willow_bottom_outside, knownEntranceConnections.willowBottomOutside, entrances.willowBottomOutside)
        entrance_string_piece("\n" + willow_bottom_inside, knownEntranceConnections.willowBottomInside, entrances.willowBottomInside)
        entrance_string_piece("\n" + willow_top_outside, knownEntranceConnections.willowTopOutside, entrances.willowTopOutside)
        entrance_string_piece("\n" + willow_top_inside, knownEntranceConnections.willowTopInside, entrances.willowTopInside)
    }

    fun entrance_string_piece(entrance: String, known: Boolean, target: Integer) {
        set_string("entrance_progress", get_string("entrance_progress") + entrance)
        if known {
            entrance(target)
            set_string("entrance_progress", get_string("entrance_progress") + get_string("entrance"))
        }
        if known == false set_string("entrance_progress", get_string("entrance_progress") + " - " + transparent + "Undiscovered</>")
    }

    fun entrance(target: Integer) {
        if target == 0 set_string("entrance", " - @Closed@")
        if target == 9 set_string("entrance", " to " + moki_father_hut_outside)
        if target == 10 set_string("entrance", " to " + moki_father_hut_inside)
        if target == 5 set_string("entrance", " to " + hut_above_motay_outside)
        if target == 6 set_string("entrance", " to " + hut_above_motay_inside)
        if target == 11 set_string("entrance", " to " + storage_hut_outside)
        if target == 12 set_string("entrance", " to " + storage_hut_inside)
        if target == 7 set_string("entrance", " to " + tree_hut_outside)
        if target == 8 set_string("entrance", " to " + tree_hut_inside)
        if target == 3 set_string("entrance", " to " + last_hut_outside)
        if target == 4 set_string("entrance", " to " + last_hut_inside)
        if target == 13 set_string("entrance", " to " + cave_outside)
        if target == 14 set_string("entrance", " to " + cave_inside)
        if target == 1 set_string("entrance", " to " + lupo_shop_outside)
        if target == 2 set_string("entrance", " to " + lupo_shop_inside)
        if target == 15 set_string("entrance", " to " + wellspring_1st_floor_bottom_outside)
        if target == 16 set_string("entrance", " to " + wellspring_1st_floor_bottom_inside)
        if target == 17 set_string("entrance", " to " + wellspring_1st_floor_top_outside)
        if target == 18 set_string("entrance", " to " + wellspring_1st_floor_top_inside)
        if target == 19 set_string("entrance", " to " + wellspring_2nd_floor_outside)
        if target == 20 set_string("entrance", " to " + wellspring_2nd_floor_inside)
        if target == 21 set_string("entrance", " to " + wellspring_3rd_floor_outside)
        if target == 22 set_string("entrance", " to " + wellspring_3rd_floor_inside)
        if target == 25 set_string("entrance", " to " + teddy_hut_outside)
        if target == 26 set_string("entrance", " to " + teddy_hut_inside)
        if target == 23 set_string("entrance", " to " + reach_hut_outside)
        if target == 24 set_string("entrance", " to " + reach_hut_inside)
        if target == 27 set_string("entrance", " to " + ruins_outside)
        if target == 28 set_string("entrance", " to " + ruins_inside)
        if target == 29 set_string("entrance", " to " + willow_bottom_outside)
        if target == 30 set_string("entrance", " to " + willow_bottom_inside)
        if target == 31 set_string("entrance", " to " + willow_top_outside)
        if target == 32 set_string("entrance", " to " + willow_top_inside)
    }
