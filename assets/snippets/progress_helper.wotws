fun write_entrance_progress() {
    has_default_entrance_connections()
    if get_boolean("default_entrance_connections") {
        set_string("entrance_progress", "Default entrance connections")
    }
    if get_boolean("default_entrance_connections") == false {
        // negative margin hack
        set_string("entrance_progress", "<ls_-1.5>" + invisible + ".</></>\n<s_0.7><ls_0.7>")
        entrance_string_piece(moki_father_hut_outside, entrancesKnown.mokiFatherHutOutside, entrances.mokiFatherHutOutside)
        entrance_string_piece("\n" + moki_father_hut_inside, entrancesKnown.mokiFatherHutInside, entrances.mokiFatherHutInside)
        entrance_string_piece("\n" + hut_above_motay_outside, entrancesKnown.hutAboveMotayOutside, entrances.hutAboveMotayOutside)
        entrance_string_piece("\n" + hut_above_motay_inside, entrancesKnown.hutAboveMotayInside, entrances.hutAboveMotayInside)
        entrance_string_piece("\n" + storage_hut_outside, entrancesKnown.storageHutOutside, entrances.storageHutOutside)
        entrance_string_piece("\n" + storage_hut_inside, entrancesKnown.storageHutInside, entrances.storageHutInside)
        entrance_string_piece("\n" + tree_hut_outside, entrancesKnown.treeHutOutside, entrances.treeHutOutside)
        entrance_string_piece("\n" + tree_hut_inside, entrancesKnown.treeHutInside, entrances.treeHutInside)
        entrance_string_piece("\n" + last_hut_outside, entrancesKnown.lastHutOutside, entrances.lastHutOutside)
        entrance_string_piece("\n" + last_hut_inside, entrancesKnown.lastHutInside, entrances.lastHutInside)
        entrance_string_piece("\n" + cave_outside, entrancesKnown.caveOutside, entrances.caveOutside)
        entrance_string_piece("\n" + cave_inside, entrancesKnown.caveInside, entrances.caveInside)
        entrance_string_piece("\n" + lupo_shop_outside, entrancesKnown.lupoShopOutside, entrances.lupoShopOutside)
        entrance_string_piece("\n" + lupo_shop_inside, entrancesKnown.lupoShopInside, entrances.lupoShopInside)
        entrance_string_piece("\n" + wellspring_1st_floor_bottom_outside, entrancesKnown.wellspring1stFloorBottomOutside, entrances.wellspring1stFloorBottomOutside)
        entrance_string_piece("\n" + wellspring_1st_floor_bottom_inside, entrancesKnown.wellspring1stFloorBottomInside, entrances.wellspring1stFloorBottomInside)
        entrance_string_piece("\n" + wellspring_1st_floor_top_outside, entrancesKnown.wellspring1stFloorTopOutside, entrances.wellspring1stFloorTopOutside)
        entrance_string_piece("\n" + wellspring_1st_floor_top_inside, entrancesKnown.wellspring1stFloorTopInside, entrances.wellspring1stFloorTopInside)
        entrance_string_piece("\n" + wellspring_2nd_floor_outside, entrancesKnown.wellspring2ndFloorOutside, entrances.wellspring2ndFloorOutside)
        entrance_string_piece("\n" + wellspring_2nd_floor_inside, entrancesKnown.wellspring2ndFloorInside, entrances.wellspring2ndFloorInside)
        entrance_string_piece("\n" + wellspring_3rd_floor_outside, entrancesKnown.wellspring3rdFloorOutside, entrances.wellspring3rdFloorOutside)
        entrance_string_piece("\n" + wellspring_3rd_floor_inside, entrancesKnown.wellspring3rdFloorInside, entrances.wellspring3rdFloorInside)
        entrance_string_piece("\n" + teddy_hut_outside, entrancesKnown.teddyHutOutside, entrances.teddyHutOutside)
        entrance_string_piece("\n" + teddy_hut_inside, entrancesKnown.teddyHutInside, entrances.teddyHutInside)
        entrance_string_piece("\n" + reach_hut_outside, entrancesKnown.reachSeedOutside, entrances.reachSeedOutside)
        entrance_string_piece("\n" + reach_hut_inside, entrancesKnown.reachSeedInside, entrances.reachSeedInside)
        entrance_string_piece("\n" + ruins_outside, entrancesKnown.ruinsOutside, entrances.ruinsOutside)
        entrance_string_piece("\n" + ruins_inside, entrancesKnown.ruinsInside, entrances.ruinsInside)
        entrance_string_piece("\n" + willow_bottom_outside, entrancesKnown.willowBottomOutside, entrances.willowBottomOutside)
        entrance_string_piece("\n" + willow_bottom_inside, entrancesKnown.willowBottomInside, entrances.willowBottomInside)
        entrance_string_piece("\n" + willow_top_outside, entrancesKnown.willowTopOutside, entrances.willowTopOutside)
        entrance_string_piece("\n" + willow_top_inside, entrancesKnown.willowTopInside, entrances.willowTopInside)
    }
}

fun has_default_entrance_connections() {
    // TODO manual right-to-left ordering is currently required to compile this expression
    set_boolean(
        "default_entrance_connections",
        entrancesKnown.mokiFatherHutOutside && (entrances.mokiFatherHutOutside == 10
        && (entrancesKnown.mokiFatherHutInside && (entrances.mokiFatherHutInside == 9
        && (entrancesKnown.hutAboveMotayOutside && (entrances.hutAboveMotayOutside == 6
        && (entrancesKnown.hutAboveMotayInside && (entrances.hutAboveMotayInside == 5
        && (entrancesKnown.storageHutOutside && (entrances.storageHutOutside == 12
        && (entrancesKnown.storageHutInside && (entrances.storageHutInside == 11
        && (entrancesKnown.treeHutOutside && (entrances.treeHutOutside == 8
        && (entrancesKnown.treeHutInside && (entrances.treeHutInside == 7
        && (entrancesKnown.lastHutOutside && (entrances.lastHutOutside == 4
        && (entrancesKnown.lastHutInside && (entrances.lastHutInside == 3
        && (entrancesKnown.caveOutside && (entrances.caveOutside == 14
        && (entrancesKnown.caveInside && (entrances.caveInside == 13
        && (entrancesKnown.lupoShopOutside && (entrances.lupoShopOutside == 2
        && (entrancesKnown.lupoShopInside && (entrances.lupoShopInside == 1
        && (entrancesKnown.wellspring1stFloorBottomOutside && (entrances.wellspring1stFloorBottomOutside == 16
        && (entrancesKnown.wellspring1stFloorBottomInside && (entrances.wellspring1stFloorBottomInside == 15
        && (entrancesKnown.wellspring1stFloorTopOutside && (entrances.wellspring1stFloorTopOutside == 18
        && (entrancesKnown.wellspring1stFloorTopInside && (entrances.wellspring1stFloorTopInside == 17
        && (entrancesKnown.wellspring2ndFloorOutside && (entrances.wellspring2ndFloorOutside == 20
        && (entrancesKnown.wellspring2ndFloorInside && (entrances.wellspring2ndFloorInside == 19
        && (entrancesKnown.wellspring3rdFloorOutside && (entrances.wellspring3rdFloorOutside == 22
        && (entrancesKnown.wellspring3rdFloorInside && (entrances.wellspring3rdFloorInside == 21
        && (entrancesKnown.teddyHutOutside && (entrances.teddyHutOutside == 26
        && (entrancesKnown.teddyHutInside && (entrances.teddyHutInside == 25
        && (entrancesKnown.reachSeedOutside && (entrances.reachSeedOutside == 24
        && (entrancesKnown.reachSeedInside && (entrances.reachSeedInside == 23
        && (entrancesKnown.ruinsOutside && (entrances.ruinsOutside == 28
        && (entrancesKnown.ruinsInside && (entrances.ruinsInside == 27
        && (entrancesKnown.willowBottomOutside && (entrances.willowBottomOutside == 30
        && (entrancesKnown.willowBottomInside && (entrances.willowBottomInside == 29
        && (entrancesKnown.willowTopOutside && (entrances.willowTopOutside == 31
        && (entrancesKnown.willowTopInside && entrances.willowTopInside == 32))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
    )
}

fun entrance_string_piece(entrance: String, known: Boolean, target: Integer) {
    set_string("entrance_progress", get_string("entrance_progress") + entrance)
    if known {
        entrance(target)
        set_string("entrance_progress", get_string("entrance_progress") + get_string("entrance"))
    }
    if known == false set_string("entrance_progress", get_string("entrance_progress") + " - " + transparent + "Undiscovered</>")
}

fun entrance(target: Integer) {
    if target == 0 set_string("entrance", " - @Closed@")
    if target == 9 set_string("entrance", " to " + moki_father_hut_outside)
    if target == 10 set_string("entrance", " to " + moki_father_hut_inside)
    if target == 5 set_string("entrance", " to " + hut_above_motay_outside)
    if target == 6 set_string("entrance", " to " + hut_above_motay_inside)
    if target == 11 set_string("entrance", " to " + storage_hut_outside)
    if target == 12 set_string("entrance", " to " + storage_hut_inside)
    if target == 7 set_string("entrance", " to " + tree_hut_outside)
    if target == 8 set_string("entrance", " to " + tree_hut_inside)
    if target == 3 set_string("entrance", " to " + last_hut_outside)
    if target == 4 set_string("entrance", " to " + last_hut_inside)
    if target == 13 set_string("entrance", " to " + cave_outside)
    if target == 14 set_string("entrance", " to " + cave_inside)
    if target == 1 set_string("entrance", " to " + lupo_shop_outside)
    if target == 2 set_string("entrance", " to " + lupo_shop_inside)
    if target == 15 set_string("entrance", " to " + wellspring_1st_floor_bottom_outside)
    if target == 16 set_string("entrance", " to " + wellspring_1st_floor_bottom_inside)
    if target == 17 set_string("entrance", " to " + wellspring_1st_floor_top_outside)
    if target == 18 set_string("entrance", " to " + wellspring_1st_floor_top_inside)
    if target == 19 set_string("entrance", " to " + wellspring_2nd_floor_outside)
    if target == 20 set_string("entrance", " to " + wellspring_2nd_floor_inside)
    if target == 21 set_string("entrance", " to " + wellspring_3rd_floor_outside)
    if target == 22 set_string("entrance", " to " + wellspring_3rd_floor_inside)
    if target == 25 set_string("entrance", " to " + teddy_hut_outside)
    if target == 26 set_string("entrance", " to " + teddy_hut_inside)
    if target == 23 set_string("entrance", " to " + reach_hut_outside)
    if target == 24 set_string("entrance", " to " + reach_hut_inside)
    if target == 27 set_string("entrance", " to " + ruins_outside)
    if target == 28 set_string("entrance", " to " + ruins_inside)
    if target == 29 set_string("entrance", " to " + willow_bottom_outside)
    if target == 30 set_string("entrance", " to " + willow_bottom_inside)
    if target == 31 set_string("entrance", " to " + willow_top_outside)
    if target == 32 set_string("entrance", " to " + willow_top_inside)
}
