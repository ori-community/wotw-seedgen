#hidden
#name("Rapid Spear Core")
#description("Adds support for toggleable Rapid Spear")

!state(enabled, Boolean)
!state(collected, Integer)

!include("bonus_core", update_bonus_wheel, any_collected, any_enabled, enable_all, disable_all)

!augment_fun(any_collected(), if collected > 0 set_boolean("any_collected", true))
!augment_fun(any_enabled(), if collected > 0 && enabled set_boolean("any_enabled", true))
!augment_fun(enable_all(), if enabled == false store(enabled, true))
!augment_fun(disable_all(), if enabled store(enabled, false))

!builtin_icon(rapid_spear_icon, "icons/bonus/rapidspear.png")

fun rapid_spear() {
    item_message("#Rapid Spear x" + (collected + 1) + "#")
    store(collected, collected + 1)
}
!export(rapid_spear)

!item_data(rapid_spear(),
    "#Rapid Spear#",
    200,
    "Spear attacks are faster",
    rapid_spear_icon,
    BonusItem
)

on spawn store(enabled, true)

on enabled && collected > 0 {
    set_wheel_item_disable()
    update_bonus_wheel()
    store(randoUpgrades.spearSpeedMultiplier, 1 + collected * 0.4)
}

on enabled == false && collected > 0 {
    set_wheel_item_enable()
    update_bonus_wheel()
    store(randoUpgrades.spearSpeedMultiplier, 1)
}

on reload if collected > 0 {
    create_wheel_item()
    if enabled set_wheel_item_disable()
    if enabled == false set_wheel_item_enable()
}
on collected > 0 create_wheel_item()

fun create_wheel_item() {
    set_wheel_item_name("bonus_upgrades", RightBottom, "Toggle Rapid Spear")
    set_wheel_item_icon("bonus_upgrades", RightBottom, rapid_spear_icon)
    set_wheel_item_all_actions("bonus_upgrades", RightBottom, store(enabled, enabled == false))
}

fun set_wheel_item_disable() {
    set_wheel_item_description("bonus_upgrades", RightBottom, "[Ability1]Toggle off")
    set_wheel_item_color("bonus_upgrades", RightBottom, 255, 255, 255, 255)
}

fun set_wheel_item_enable() {
    set_wheel_item_description("bonus_upgrades", RightBottom, "[Ability1]Toggle on")
    set_wheel_item_color("bonus_upgrades", RightBottom, 128, 128, 128, 196)
}
