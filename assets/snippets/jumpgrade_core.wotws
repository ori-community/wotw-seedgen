#hidden
#name("Jumpgrade Core")
#description("Adds support for toggleable Jumpgrades")

!state(enabled, Boolean)
!state(collected, Integer)

!include("bonus_core", update_bonus_wheel, any_collected, any_enabled, enable_all, disable_all)

!augment_fun(any_collected(), if collected > 0 set_boolean("any_collected", true))
!augment_fun(any_enabled(), if collected > 0 && enabled set_boolean("any_enabled", true))
!augment_fun(enable_all(), if enabled == false store(enabled, true))
!augment_fun(disable_all(), if enabled store(enabled, false))

!builtin_icon(jumpgrade_icon, "icons/bonus/jumpgrade.png")

fun jumpgrade() {
    item_message("#Jumpgrade x" + (collected + 1) + "#")
    store(collected, collected + 1)
}
!export(jumpgrade)

!item_data(jumpgrade(),
    "#Jumpgrade#",
    200,
    "Jump higher",
    jumpgrade_icon,
    BonusItem
)

on spawn store(enabled, true)

on enabled && collected > 0 {
    set_wheel_item_disable()
    update_bonus_wheel()
    store(randoUpgrades.jumpHeightMultiplier, 1 + collected * 0.33)
    store(randoUpgrades.wallJumpHeightMultiplier, 1 + collected * 0.15)
    store(randoUpgrades.doubleJumpHeightMultiplier, 1 + collected * 0.15)
}

on enabled == false && collected > 0 {
    set_wheel_item_enable()
    update_bonus_wheel()
    store(randoUpgrades.jumpHeightMultiplier, 1)
    store(randoUpgrades.wallJumpHeightMultiplier, 1)
    store(randoUpgrades.doubleJumpHeightMultiplier, 1)
}

on reload if collected > 0 {
    create_wheel_item()
    if enabled set_wheel_item_disable()
    if enabled == false set_wheel_item_enable()
}
on collected > 0 create_wheel_item()

fun create_wheel_item() {
    set_wheel_item_name("bonus_upgrades", TopRight, "Toggle Jumpgrades")
    set_wheel_item_icon("bonus_upgrades", TopRight, jumpgrade_icon)
    set_wheel_item_all_actions("bonus_upgrades", TopRight, store(enabled, enabled == false))
}

fun set_wheel_item_disable() {
    set_wheel_item_description("bonus_upgrades", TopRight, "[Ability1]Toggle off")
    set_wheel_item_color("bonus_upgrades", TopRight, 255, 255, 255, 255)
}

fun set_wheel_item_enable() {
    set_wheel_item_description("bonus_upgrades", TopRight, "[Ability1]Toggle on")
    set_wheel_item_color("bonus_upgrades", TopRight, 128, 128, 128, 196)
}
