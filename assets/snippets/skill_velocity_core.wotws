#hidden
#name("Skill Velocity Core")
#description("Adds support for toggleable Skill Velocity")

!state(enabled, Boolean)
!state(collected, Integer)

!include("bonus_core", update_bonus_wheel, any_collected, any_enabled, enable_all, disable_all)
!include("bonus_progress_helper", write_bonus_items, write_bonus_items_part, update_bonus_items)

!augment_fun(any_collected(), if collected > 0 set_boolean("any_collected", true))
!augment_fun(any_enabled(), if collected > 0 && enabled set_boolean("any_enabled", true))
!augment_fun(enable_all(), if enabled == false store(enabled, true))
!augment_fun(disable_all(), if enabled store(enabled, false))

!builtin_icon(skill_velocity_icon, "icons/bonus/skillvelocity.png")

fun skill_velocity() {
    item_message("#Skill Velocity x" + (collected + 1) + "#")
    store(collected, collected + 1)
    update_bonus_items()
}
!export(skill_velocity)

!augment_fun(write_bonus_items(), if collected != 0 write_bonus_items_part("#Skill Velocity# x" + collected))

!item_data(skill_velocity(),
    "#Skill Velocity#",
    200,
    "Move faster when using abilities such as Dash and Bash",
    skill_velocity_icon,
    BonusItem
)

on spawn store(enabled, true)

on enabled && collected > 0 {
    set_wheel_item_disable()
    update_bonus_wheel()
    store(randoUpgrades.launchSpeedMultiplier, 1 + collected * 0.16)
    store(randoUpgrades.dashDistanceMultiplier, 1 + collected * 0.16)
    store(randoUpgrades.bashSpeedMultiplier, 1 + collected * 0.16)
    store(randoUpgrades.burrowDashSpeedMultiplier, 1 + collected * 0.16)
    store(randoUpgrades.waterDashSpeedMultiplier, 1 + collected * 0.16)
    store(randoUpgrades.grappleSpeedMultiplier, 1 + collected * 0.16)
}

on enabled == false && collected > 0 {
    set_wheel_item_enable()
    update_bonus_wheel()
    store(randoUpgrades.launchSpeedMultiplier, 1)
    store(randoUpgrades.dashDistanceMultiplier, 1)
    store(randoUpgrades.bashSpeedMultiplier, 1)
    store(randoUpgrades.burrowDashSpeedMultiplier, 1)
    store(randoUpgrades.waterDashSpeedMultiplier, 1)
    store(randoUpgrades.grappleSpeedMultiplier, 1)
}

on reload if collected > 0 {
    create_wheel_item()
    if enabled set_wheel_item_disable()
    if enabled == false set_wheel_item_enable()
}
on collected > 0 create_wheel_item()

fun create_wheel_item() {
    set_wheel_item_name("bonus_upgrades", Top, "Toggle Skill Velocity")
    set_wheel_item_icon("bonus_upgrades", Top, skill_velocity_icon)
    set_wheel_item_all_actions("bonus_upgrades", Top, store(enabled, enabled == false))
}

fun set_wheel_item_disable() {
    set_wheel_item_description("bonus_upgrades", Top, "[Ability1]Toggle off")
    set_wheel_item_color("bonus_upgrades", Top, 255, 255, 255, 255)
}

fun set_wheel_item_enable() {
    set_wheel_item_description("bonus_upgrades", Top, "[Ability1]Toggle on")
    set_wheel_item_color("bonus_upgrades", Top, 128, 128, 128, 196)
}
