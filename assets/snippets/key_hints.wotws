#category("Hints")
#name("Key Hints")
#description("
Npcs sell hints:
Opher after the Water escape tells the areas holding Water, Glide, Flap
Lupo in Glades tells the areas holding Burrow, Water Dash, Grenade and Flash
Twillen tells the areas holding Bow and Bash")

!tags("Key Hints")

// TODO have to stringify constant before compilation because they will be turned into numbers otherwise
!area_of(burrow_area, store(skills.burrow, true))
!area_of(water_dash_area, store(skills.waterDash, true))
!area_of(grenade_area, store(skills.grenade, true))
!area_of(flash_area, store(skills.flash, true))
!area_of(clean_water_area, store(worldEvents.cleanWater, true))
!area_of(flap_area, store(skills.flap, true))
!area_of(glide_area, store(skills.glide, true))
!area_of(bash_area, store(skills.bash, true))
!area_of(bow_area, store(skills.bow, true))

!include("progress_helper", write_progress_message, write_map_progress_message)
!include("list_core", add_row)

!augment_fun(write_progress_message(), write_hints())
!augment_fun(write_map_progress_message(), write_hints())

fun write_hints() {
    if Shop.Lupo.Slot3 {
        write_lupo_hint()
        add_row(get_string("hint"))
    }
    if Shop.Opher.Slot11 {
        write_opher_hint()
        add_row(get_string("hint"))
    }
    if Shop.Twillen.Slot8 {
        write_twillen_hint()
        add_row(get_string("hint"))
    }
}

fun write_lupo_hint() {
    set_string("burrow_color", "")
    if skills.burrow set_string("burrow_color", "$")
    set_string("water_dash_color", "")
    if skills.waterDash set_string("water_dash_color", "$")
    set_string("grenade_color", "")
    if skills.grenade set_string("grenade_color", "$")
    set_string("flash_color", "")
    if skills.flash set_string("flash_color", "$")

    set_string("hint",
        get_string("burrow_color") + "Burrow: " + burrow_area + get_string("burrow_color") + ", " +
        get_string("water_dash_color") + "Water Dash: " + water_dash_area + get_string("water_dash_color") + ", " +
        get_string("grenade_color") + "Grenade: " + grenade_area + get_string("grenade_color") + ", " +
        get_string("flash_color") + "Flash: " + flash_area + get_string("flash_color")
    )
}
fun write_opher_hint() {
    set_string("clean_water_color", "")
    if worldEvents.cleanWater set_string("clean_water_color", "$")
    set_string("flap_color", "")
    if skills.flap set_string("flap_color", "$")
    set_string("glide_color", "")
    if skills.glide set_string("glide_color", "$")

    set_string("hint",
        get_string("clean_water_color") + "Clean Water: " + clean_water_area + get_string("clean_water_color") + ", " +
        get_string("flap_color") + "Flap: " + flap_area + get_string("flap_color") + ", " +
        get_string("glide_color") + "Glide: " + glide_area + get_string("glide_color")
    )
}
fun write_twillen_hint() {
    set_string("bash_color", "")
    if skills.bash set_string("bash_color", "$")
    set_string("bow_color", "")
    if skills.bow set_string("bow_color", "$")

    set_string("hint",
        get_string("bash_color") + "Bash: " + bash_area + get_string("bash_color") + ", " +
        get_string("bow_color") + "Bow: " + bow_area + get_string("bow_color")
    )
}

on spawn {
    set_shop_item_data(
        Shop.Lupo.Slot3,
        4000,
        "Burrow, Water Dash, Grenade, Flash hint",
        "Costs 500 less for every item you found already",
        ShardsMap,
    )
    set_shop_item_data(
        Shop.Opher.Slot11,
        2500,
        "Clean Water, Flap, Glide hint",
        "Costs 500 less for every item you found already",
        ShardsMap,
    )
    if Wellspring.Escape.Reward == false {
        set_shop_item_description(Shop.Opher.Slot11, "Complete the Wellspring escape to unlock")
        set_shop_item_hidden(Shop.Opher.Slot11, true)
    }
    set_shop_item_data(
        Shop.Twillen.Slot8,
        1500,
        "Bash, Bow hint",
        "Costs 500 less for every item you found already",
        ShardsMap,
    )
    updateLupoHintPrice()
    updateOpherHintPrice()
    updateTwillenHintPrice()
}
on Wellspring.Escape.Reward {
    set_shop_item_description(Shop.Opher.Slot11, "Costs 500 less for every item you found already")
    set_shop_item_hidden(Shop.Opher.Slot11, false)
}

fun updateLupoHintPrice() {
    set_integer("lupo_hint_price", 4000)
    if skills.burrow set_integer("lupo_hint_price", get_integer("lupo_hint_price") - 500)
    if skills.waterDash set_integer("lupo_hint_price", get_integer("lupo_hint_price") - 500)
    if skills.grenade set_integer("lupo_hint_price", get_integer("lupo_hint_price") - 500)
    if skills.flash set_integer("lupo_hint_price", get_integer("lupo_hint_price") - 500)
    if get_integer("lupo_hint_price") == 2000 set_integer("lupo_hint_price", 0)
    set_shop_item_price(Shop.Lupo.Slot3, get_integer("lupo_hint_price"))
}
fun updateOpherHintPrice() {
    set_integer("opher_hint_price", 2500)
    if worldEvents.cleanWater set_integer("opher_hint_price", get_integer("opher_hint_price") - 500)
    if skills.flap set_integer("opher_hint_price", get_integer("opher_hint_price") - 500)
    if skills.glide set_integer("opher_hint_price", get_integer("opher_hint_price") - 500)
    if get_integer("opher_hint_price") == 1000 set_integer("opher_hint_price", 0)
    set_shop_item_price(Shop.Opher.Slot11, get_integer("opher_hint_price"))
}
fun updateTwillenHintPrice() {
    set_integer("twillen_hint_price", 1500)
    if skills.bash set_integer("twillen_hint_price", get_integer("twillen_hint_price") - 500)
    if skills.bow set_integer("twillen_hint_price", get_integer("twillen_hint_price") - 500)
    if get_integer("twillen_hint_price") == 500 set_integer("twillen_hint_price", 0)
    set_shop_item_price(Shop.Twillen.Slot8, get_integer("twillen_hint_price"))
}

on skills.burrow updateLupoHintPrice()
on skills.waterDash updateLupoHintPrice()
on skills.grenade updateLupoHintPrice()
on skills.flash updateLupoHintPrice()
on worldEvents.cleanWater updateOpherHintPrice()
on skills.flap updateOpherHintPrice()
on skills.glide updateOpherHintPrice()
on skills.bash updateTwillenHintPrice()
on skills.bow updateTwillenHintPrice()

!no_random_placement(Shop.Lupo.Slot3)
on Shop.Lupo.Slot3 {
    create_stats_entry(Lupo, "Lupo Hint")
    write_lupo_hint()
    item_message(get_string("hint"))
}
!no_random_placement(Shop.Opher.Slot11)
on Shop.Opher.Slot11 {
    create_stats_entry(Opher, "Opher Hint")
    write_opher_hint()
    item_message(get_string("hint"))
}
!no_random_placement(Shop.Twillen.Slot8)
on Shop.Twillen.Slot8 {
    create_stats_entry(Twillen, "Twillen Hint")
    write_twillen_hint()
    item_message(get_string("hint"))
}
