#category("Hints")
#name("Zone Hints")
#description("Lupo's maps give information about the number of important items in the current zone. Lupo in Glades sells the hints for Woods and Glades.")

!tags("Zone Hints")

!config(skill_hints, "Skill Hints", "Lupo reveals the amount of skills in an area", Boolean, true)
!config(teleporter_hints, "Teleporter Hints", "Lupo reveals the amount of teleporters in an area", Boolean, true)

!include("progress_helper", write_progress_message, write_map_progress_message)
!include("list_core", add_row)

!augment_fun(write_progress_message(), write_hints(player.currentArea))
!augment_fun(write_map_progress_message(), write_hints(player.currentMapArea))

fun write_hints(zone: Integer) {
    set_string("hint", "")

    // TODO have to write the zone integers here, no way to pass the zone type around
    if zone == 0 && MarshSpawn.LupoMap write_marsh_hint()
    if zone == 1 && WestHollow.LupoMap write_hollow_hint()
    if zone == 2 && LupoShop.Slot1 write_glades_hint()
    if zone == 3 && InnerWellspring.LupoMap write_wellspring_hint()
    if zone == 4 && LupoShop.Slot2 write_woods_hint()
    if zone == 5 && LowerReach.LupoMap write_reach_hint()
    if zone == 6 && LowerDepths.LupoMap write_depths_hint()
    if zone == 7 && EastPools.LupoMap write_pools_hint()
    if zone == 8 && LowerWastes.LupoMap write_wastes_hint()
    if zone == 10 && WillowsEnd.LupoMap write_willow_hint()
    if zone == 11 && MidnightBurrows.LupoMap write_burrows_hint()

    if get_string("hint") != "" add_row(get_string("hint"))
}

fun write_marsh_hint() {}
fun write_hollow_hint() {}
fun write_glades_hint() {}
fun write_wellspring_hint() {}
fun write_woods_hint() {}
fun write_reach_hint() {}
fun write_depths_hint() {}
fun write_pools_hint() {}
fun write_wastes_hint() {}
fun write_willow_hint() {}
fun write_burrows_hint() {}

!let(description, "")

!if skill_hints {
    !let(description, "skills")

    !count_in_zone(
        [
            (skills_in_marsh, Marsh),
            (skills_in_hollow, Hollow),
            (skills_in_glades, Glades),
            (skills_in_wellspring, Wellspring),
            (skills_in_woods, Woods),
            (skills_in_reach, Reach),
            (skills_in_depths, Depths),
            (skills_in_pools, Pools),
            (skills_in_wastes, Wastes),
            (skills_in_willow, Willow),
            (skills_in_burrows, Burrows),
        ],
        [
            skill(Bash),
            skill(DoubleJump),
            skill(Launch),
            skill(Glide),
            skill(WaterBreath),
            skill(Grenade),
            skill(Grapple),
            skill(Flash),
            skill(Spear),
            skill(Regenerate),
            skill(Bow),
            skill(Hammer),
            skill(Sword),
            skill(Burrow),
            skill(Dash),
            skill(WaterDash),
            skill(Shuriken),
            skill(Blaze),
            skill(Sentry),
            skill(Flap),
            clean_water(),
        ]
    )

    !augment_fun(write_marsh_hint(), {
        set_string("hint", get_string("hint") + "Marsh Skills - " + skills_in_marsh)
    })
    !augment_fun(write_hollow_hint(), {
        set_string("hint", get_string("hint") + "Hollow Skills - " + skills_in_hollow)
    })
    !augment_fun(write_glades_hint(), {
        set_string("hint", get_string("hint") + "Glades Skills - " + skills_in_glades)
    })
    !augment_fun(write_wellspring_hint(), {
        set_string("hint", get_string("hint") + "Wellspring Skills - " + skills_in_wellspring)
    })
    !augment_fun(write_woods_hint(), {
        set_string("hint", get_string("hint") + "Woods Skills - " + skills_in_woods)
    })
    !augment_fun(write_reach_hint(), {
        set_string("hint", get_string("hint") + "Reach Skills - " + skills_in_reach)
    })
    !augment_fun(write_depths_hint(), {
        set_string("hint", get_string("hint") + "Depths Skills - " + skills_in_depths)
    })
    !augment_fun(write_pools_hint(), {
        set_string("hint", get_string("hint") + "Pools Skills - " + skills_in_pools)
    })
    !augment_fun(write_wastes_hint(), {
        set_string("hint", get_string("hint") + "Wastes Skills - " + skills_in_wastes)
    })
    !augment_fun(write_willow_hint(), {
        set_string("hint", get_string("hint") + "Willow Skills - " + skills_in_willow)
    })
    !augment_fun(write_burrows_hint(), {
        set_string("hint", get_string("hint") + "Burrows Skills - " + skills_in_burrows)
    })
}

!if teleporter_hints {
    !if skill_hints {
        !let(separator, "\n")
        !let(description, "skills and teleporters")
    }
    !if skill_hints == false {
        !let(separator, "")
        !let(description, "teleporters")
    }

    !count_in_zone(
        [
            (teleporters_in_marsh, Marsh),
            (teleporters_in_hollow, Hollow),
            (teleporters_in_glades, Glades),
            (teleporters_in_wellspring, Wellspring),
            (teleporters_in_woods, Woods),
            (teleporters_in_reach, Reach),
            (teleporters_in_depths, Depths),
            (teleporters_in_pools, Pools),
            (teleporters_in_wastes, Wastes),
            (teleporters_in_willow, Willow),
            (teleporters_in_burrows, Burrows),
        ],
        [
            teleporter(Marsh),
            teleporter(Den),
            teleporter(Hollow),
            teleporter(Glades),
            teleporter(Wellspring),
            teleporter(Burrows),
            teleporter(WoodsEntrance),
            teleporter(WoodsExit),
            teleporter(Reach),
            teleporter(Depths),
            teleporter(CentralPools),
            teleporter(PoolsBoss),
            teleporter(FeedingGrounds),
            teleporter(CentralWastes),
            teleporter(OuterRuins),
            teleporter(InnerRuins),
            teleporter(Willow),
            teleporter(Shriek),
        ]
    )

    !augment_fun(write_marsh_hint(), {
        set_string("hint", get_string("hint") + separator + "Marsh TPs - " + teleporters_in_marsh)
    })
    !augment_fun(write_hollow_hint(), {
        set_string("hint", get_string("hint") + separator + "Hollow TPs - " + teleporters_in_hollow)
    })
    !augment_fun(write_glades_hint(), {
        set_string("hint", get_string("hint") + separator + "Glades TPs - " + teleporters_in_glades)
    })
    !augment_fun(write_wellspring_hint(), {
        set_string("hint", get_string("hint") + separator + "Wellspring TPs - " + teleporters_in_wellspring)
    })
    !augment_fun(write_woods_hint(), {
        set_string("hint", get_string("hint") + separator + "Woods TPs - " + teleporters_in_woods)
    })
    !augment_fun(write_reach_hint(), {
        set_string("hint", get_string("hint") + separator + "Reach TPs - " + teleporters_in_reach)
    })
    !augment_fun(write_depths_hint(), {
        set_string("hint", get_string("hint") + separator + "Depths TPs - " + teleporters_in_depths)
    })
    !augment_fun(write_pools_hint(), {
        set_string("hint", get_string("hint") + separator + "Pools TPs - " + teleporters_in_pools)
    })
    !augment_fun(write_wastes_hint(), {
        set_string("hint", get_string("hint") + separator + "Wastes TPs - " + teleporters_in_wastes)
    })
    !augment_fun(write_willow_hint(), {
        set_string("hint", get_string("hint") + separator + "Willow TPs - " + teleporters_in_willow)
    })
    !augment_fun(write_burrows_hint(), {
        set_string("hint", get_string("hint") + separator + "Burrows TPs - " + teleporters_in_burrows)
    })
}

!if description != "" {
    !let(description, "how many " + description + " there are")
}
!if description == "" {
    !let(description, "nothing")
}

on spawn {
    set_shop_item_data(
        LupoShop.Slot1,
        200,
        "Glades Items Hint",
        "Reveals " + description + " in Glades",
        HealthFragmentsMap,
    )

    set_shop_item_data(
        LupoShop.Slot2,
        200,
        "Woods Items Hint",
        "Reveals " + description + " in Woods",
        EnergyFragmentsMap,
    )

    set_shop_item_price(MarshSpawn.LupoMap, 200)
    set_shop_item_price(WestHollow.LupoMap, 150)
    set_shop_item_price(InnerWellspring.LupoMap, 150)
    set_shop_item_price(LowerReach.LupoMap, 150)
    set_shop_item_price(LowerDepths.LupoMap, 150)
    set_shop_item_price(EastPools.LupoMap, 150)
    set_shop_item_price(LowerWastes.LupoMap, 150)
    set_shop_item_price(WillowsEnd.LupoMap, 50)
    set_shop_item_price(MidnightBurrows.LupoMap, 50)
}

!remove_location(MarshSpawn.LupoMap)
on MarshSpawn.LupoMap {
    set_string("hint", "")
    write_marsh_hint()
    item_message(get_string("hint"))
}
