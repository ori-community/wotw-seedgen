#hidden
#name("Rapid Regenerate Core")
#description("Adds support for toggleable Rapid Regenerate")

!state(enabled, Boolean)
!state(collected, Integer)

!include("bonus_core", update_bonus_wheel, any_collected, any_enabled, enable_all, disable_all)
!include("bonus_progress_helper", write_bonus_items, write_bonus_items_part, update_bonus_items)

!augment_fun(any_collected(), if collected > 0 set_boolean("any_collected", true))
!augment_fun(any_enabled(), if collected > 0 && enabled set_boolean("any_enabled", true))
!augment_fun(enable_all(), if enabled == false store(enabled, true))
!augment_fun(disable_all(), if enabled store(enabled, false))

!builtin_icon(rapid_regenerate_icon, "icons/bonus/rapidregenerate.png")

fun rapid_regenerate() {
    item_message("#Rapid Regenerate x" + (collected + 1) + "#") // TODO I don't think this item message is used in the display
    store(collected, collected + 1)
    update_bonus_items()
}
!export(rapid_regenerate)

!augment_fun(write_bonus_items(), if collected != 0 write_bonus_items_part("#Rapid Regenerate# x" + collected))

!item_data(
    rapid_regenerate(),
    "#Rapid Regenerate#",
    200,
    "Heal faster with Regenerate",
    rapid_regenerate_icon,
    BonusItem
)

on spawn store(enabled, true)

on enabled && collected > 0 {
    set_wheel_item_disable()
    update_bonus_wheel()
    store(randoUpgrades.regenerateSpeedMultiplier, 1 + collected * 0.25)
}

on enabled == false && collected > 0 {
    set_wheel_item_enable()
    update_bonus_wheel()
    store(randoUpgrades.regenerateSpeedMultiplier, 1)
}

on reload if collected > 0 {
    create_wheel_item()
    if enabled set_wheel_item_disable()
    if enabled == false set_wheel_item_enable()
}
on collected > 0 create_wheel_item()

fun create_wheel_item() {
    set_wheel_item_name("bonus_upgrades", BottomRight, "Toggle Rapid Regenerate")
    set_wheel_item_icon("bonus_upgrades", BottomRight, rapid_regenerate_icon)
    set_wheel_item_all_actions("bonus_upgrades", BottomRight, store(enabled, enabled == false))
}

fun set_wheel_item_disable() {
    set_wheel_item_description("bonus_upgrades", BottomRight, "[Ability1]Toggle off")
    set_wheel_item_color("bonus_upgrades", BottomRight, 255, 255, 255, 255)
}

fun set_wheel_item_enable() {
    set_wheel_item_description("bonus_upgrades", BottomRight, "[Ability1]Toggle on")
    set_wheel_item_color("bonus_upgrades", BottomRight, 128, 128, 128, 196)
}
