#hidden
#name("Rapid Hammer Core")
#description("Adds support for toggleable Rapid Hammer")

!state(enabled, Boolean)
!state(collected, Integer)

!include("bonus_core", update_bonus_wheel, any_collected, any_enabled, enable_all, disable_all)
!include("bonus_progress_helper", write_bonus_items, add_bonus_item, update_bonus_items)

!augment_fun(any_collected(), if collected > 0 set_boolean("any_collected", true))
!augment_fun(any_enabled(), if collected > 0 && enabled set_boolean("any_enabled", true))
!augment_fun(enable_all(), if enabled == false store(enabled, true))
!augment_fun(disable_all(), if enabled store(enabled, false))

!builtin_icon(rapid_hammer_icon, "icons/bonus/rapidsmash.png")

fun rapid_hammer() {
    // TODO this strange ordering should be obsolete?
    item_message("#Rapid Hammer x" + (collected + 1) + "#")
    store(collected, collected + 1)
    update_bonus_items()
}
!export(rapid_hammer)

!augment_fun(write_bonus_items(relevant: Boolean), {
    if skills.hammer == relevant && collected != 0 add_bonus_item("Rapid Hammer x" + collected)
})

!item_data(rapid_hammer(),
    "#Rapid Hammer#",
    200,
    "Hammer attacks are faster",
    rapid_hammer_icon,
    BonusItem
)

on spawn store(enabled, true)

on enabled && collected > 0 {
    set_wheel_item_disable()
    update_bonus_wheel()
    store(randoUpgrades.hammerSpeedMultiplier, 1 + collected * 0.25)
}

on enabled == false && collected > 0 {
    set_wheel_item_enable()
    update_bonus_wheel()
    store(randoUpgrades.hammerSpeedMultiplier, 1)
}

on reload if collected > 0 {
    create_wheel_item()
    if enabled set_wheel_item_disable()
    if enabled == false set_wheel_item_enable()
}
on collected > 0 create_wheel_item()

fun create_wheel_item() {
    set_wheel_item_name("bonus_upgrades", RightTop, "Toggle Rapid Hammer")
    set_wheel_item_icon("bonus_upgrades", RightTop, rapid_hammer_icon)
    set_wheel_item_all_actions("bonus_upgrades", RightTop, store(enabled, enabled == false))
}

fun set_wheel_item_disable() {
    set_wheel_item_description("bonus_upgrades", RightTop, "[Ability1]Toggle off")
    set_wheel_item_color("bonus_upgrades", RightTop, 255, 255, 255, 255)
}

fun set_wheel_item_enable() {
    set_wheel_item_description("bonus_upgrades", RightTop, "[Ability1]Toggle on")
    set_wheel_item_color("bonus_upgrades", RightTop, 128, 128, 128, 196)
}
