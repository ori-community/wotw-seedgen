#hidden
#name("Launch Fragments Core")
#description("Adds support for Launch Fragments")

!builtin_icon(launch_fragment_icon, "icons/bonus/launch_fragment.png")

!include("progress_helper", write_progress_message)
!include("list_core", add_row)

!augment_fun(write_progress_message(), {
    write_amount(tracker.launchFragmentsCollected)
    add_row("*Launch Fragments* " + get_string("amount"))
})

fun write_amount(amount: Integer) {
    set_string("color", "")
    if amount >= tracker.launchFragmentsRequired set_string("color", "$")
    set_string("amount", get_string("color") + "(" + amount + "/" + tracker.launchFragmentsRequired + ")" + get_string("color"))
}

fun launch_fragment() {
    create_stats_entry(LaunchFragment, "Launch Fragment")
    set_integer("amount", tracker.launchFragmentsCollected + 1)
    write_amount(get_integer("amount"))
    item_message("*Launch Fragment* " + get_string("amount"))
    store(tracker.launchFragmentsCollected, get_integer("amount"))
}
!export(launch_fragment)

!item_data(
    launch_fragment(),
    "*Launch Fragment*",
    200,
    "Collect *Launch Fragments* to get " + skill_string(Launch),
    launch_fragment_icon,
    LaunchFragment
)

on tracker.launchFragmentsCollected == tracker.launchFragmentsRequired skill(Launch)
