#hidden
#name("Launch Fragments Core")
#description("Adds support for Launch Fragments")

!builtin_icon(launch_fragment_icon, "icons/bonus/launchfragment.png")

!include("progress_helper", write_progress_message)

!augment_fun(write_progress_message(), {
    write_amount(itemTracker.launchFragmentsCount)
    set_string("progress_message", get_string("progress_message") + "\n*Launch Fragments* " + get_string("amount"))
})

fun write_amount(amount: Integer) {
    set_string("color", "")
    if amount >= itemTracker.launchFragmentsRequired set_string("color", "$")
    set_string("amount", get_string("color") + "(" + amount + "/" + itemTracker.launchFragmentsRequired + ")" + get_string("color"))
}

fun launch_fragment() {
    set_integer("amount", itemTracker.launchFragmentsCount + 1)
    write_amount(get_integer("amount"))
    item_message("*Launch Fragment* " + get_string("amount"))
    store(itemTracker.launchFragmentsCount, get_integer("amount"))
}
!export(launch_fragment)

!item_data(
    launch_fragment(),
    "*Launch Fragment*",
    200,
    "Collect *Launch Fragments* to get " + skill_string(Launch),
    launch_fragment_icon,
    LaunchFragment
)

on itemTracker.launchFragmentsCount == itemTracker.launchFragmentsRequired skill(Launch)
