// TODO flavour messages
!if marsh_relic_exists {
    fun marsh_relic() {
        create_stats_entry(MapstoneFragment, "Marsh Relic")
        item_message("@Marsh Relic@")
        store(marsh_relic_collected, true)
    }

    !preplace(marsh_relic(), Marsh)
    !item_data_name(marsh_relic(), "Marsh Relic")
    !item_data_map_icon(marsh_relic(), MapstoneFragment)

    on marsh_relic_collected store(itemTracker.relicsCount, itemTracker.relicsCount + 1)
    on marsh_relic_collected == false store(itemTracker.relicsCount, itemTracker.relicsCount - 1)
}

