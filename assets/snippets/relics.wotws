!if burrows_relic_exists { !augment_fun(write_map_progress_message(), {
    if current_map_zone() == Burrows write_map_progress_for(burrows_relic_collected)
})}

!augment_fun(write_map_progress_message(), {
    if get_boolean("exists") {
        if get_boolean("collected") {
            add_row("$Relic found$")
        }
        if get_boolean("collected") == false {
            add_row("#Relic not found#")
        }
    }
    if get_boolean("exists") == false {
        add_row("Relicless")
    }
})

fun write_map_progress_for(collected: Boolean) {
    set_boolean("exists", true)
    set_boolean("collected", collected)
}

!augment_fun(write_missing_goals(), if itemTracker.relicsCount < itemTracker.relicsRequired write_missing_relics())

fun write_missing_relics() { new_row("#Missing Relics (" + (itemTracker.relicsRequired - itemTracker.relicsCount) + ")#: ") }
!if marsh_relic_exists { !augment_fun(write_missing_relics(), if marsh_relic_collected == false add_row_item("Marsh")) }
!if hollow_relic_exists { !augment_fun(write_missing_relics(), if hollow_relic_collected == false add_row_item("Hollow")) }
!if glades_relic_exists { !augment_fun(write_missing_relics(), if glades_relic_collected == false add_row_item("Glades")) }
!if wellspring_relic_exists { !augment_fun(write_missing_relics(), if wellspring_relic_collected == false add_row_item("Wellspring")) }
!if woods_relic_exists { !augment_fun(write_missing_relics(), if woods_relic_collected == false add_row_item("Woods")) }
!if reach_relic_exists { !augment_fun(write_missing_relics(), if reach_relic_collected == false add_row_item("Reach")) }
!if depths_relic_exists { !augment_fun(write_missing_relics(), if depths_relic_collected == false add_row_item("Depths")) }
!if pools_relic_exists { !augment_fun(write_missing_relics(), if pools_relic_collected == false add_row_item("Pools")) }
!if wastes_relic_exists { !augment_fun(write_missing_relics(), if wastes_relic_collected == false add_row_item("Wastes")) }
!if willow_relic_exists { !augment_fun(write_missing_relics(), if willow_relic_collected == false add_row_item("Willow")) }
!if burrows_relic_exists { !augment_fun(write_missing_relics(), if burrows_relic_collected == false add_row_item("Burrows")) }
!augment_fun(write_missing_relics(), add_current_row())

on change itemTracker.relicsCount update_goals()
on change itemTracker.relicsRequired update_goals()

// TODO don't update inside reach corner in wellspring escape

on reload update_current_area_has_uncollected_relic()
on change player.currentArea update_current_area_has_uncollected_relic()
on change itemTracker.relicsCount update_current_area_has_uncollected_relic()
fun update_current_area_has_uncollected_relic() {
    if current_zone() == Ruins store(itemTracker.currentAreaHasUncollectedRelic, false)
}

!if marsh_relic_exists { !augment_fun(update_current_area_has_uncollected_relic(), {
    if current_zone() == Marsh store(itemTracker.currentAreaHasUncollectedRelic, marsh_relic_collected == false)
})}
