#category("Goals")
#name("Relics")
#description("You have to find Relics randomly scattered throughout Niwen before fighting Shriek")

// TODO how define the constraints? Some kind of range type?
!config(relic_chance, "Relic Chance", "Chance for each individual area of the game to have a relic", Float, 0.6)
!config(relic_count, "Relic Count", "If not zero, overrides relic chance. How many relics to place", Integer, 0)

!include("progress_helper", write_progress_message, write_map_progress_message)
!include("goal_mode_core", check_goals_completed, write_missing_goals, update_goals)
!include("list_core", new_row, add_row_item, add_row, add_current_row)

!let(marsh_relic_exists, false)
!let(hollow_relic_exists, false)
!let(glades_relic_exists, false)
!let(wellspring_relic_exists, false)
!let(woods_relic_exists, false)
!let(reach_relic_exists, false)
!let(depths_relic_exists, false)
!let(pools_relic_exists, false)
!let(wastes_relic_exists, false)
!let(willow_relic_exists, false)
!let(burrows_relic_exists, false)

!if relic_count == 0 {
    !random_float(marsh_relic, 0, 1)
    !if marsh_relic <= relic_chance { !let(marsh_relic_exists, true) }

    !random_float(hollow_relic, 0, 1)
    !if hollow_relic <= relic_chance { !let(hollow_relic_exists, true) }

    !random_float(glades_relic, 0, 1)
    !if glades_relic <= relic_chance { !let(glades_relic_exists, true) }

    !random_float(wellspring_relic, 0, 1)
    !if wellspring_relic <= relic_chance { !let(wellspring_relic_exists, true) }

    !random_float(woods_relic, 0, 1)
    !if woods_relic <= relic_chance { !let(woods_relic_exists, true) }

    !random_float(reach_relic, 0, 1)
    !if reach_relic <= relic_chance { !let(reach_relic_exists, true) }

    !random_float(depths_relic, 0, 1)
    !if depths_relic <= relic_chance { !let(depths_relic_exists, true) }

    !random_float(pools_relic, 0, 1)
    !if pools_relic <= relic_chance { !let(pools_relic_exists, true) }

    !random_float(wastes_relic, 0, 1)
    !if wastes_relic <= relic_chance { !let(wastes_relic_exists, true) }

    !random_float(willow_relic, 0, 1)
    !if willow_relic <= relic_chance { !let(willow_relic_exists, true) }

    !random_float(burrows_relic, 0, 1)
    !if burrows_relic <= relic_chance { !let(burrows_relic_exists, true) }
}
!if relic_count > 0 {
    !random_pool(relics, String, ["marsh", "hollow", "glades", "wellspring", "woods", "reach", "depths", "pools", "wastes", "willow", "burrows"])

    !repeat relic_count {
        !random_from_pool(relic, relics)
        !if relic == "marsh" { !let(marsh_relic_exists, true) }
        !if relic == "hollow" { !let(hollow_relic_exists, true) }
        !if relic == "glades" { !let(glades_relic_exists, true) }
        !if relic == "wellspring" { !let(wellspring_relic_exists, true) }
        !if relic == "woods" { !let(woods_relic_exists, true) }
        !if relic == "reach" { !let(reach_relic_exists, true) }
        !if relic == "depths" { !let(depths_relic_exists, true) }
        !if relic == "pools" { !let(pools_relic_exists, true) }
        !if relic == "wastes" { !let(wastes_relic_exists, true) }
        !if relic == "willow" { !let(willow_relic_exists, true) }
        !if relic == "burrows" { !let(burrows_relic_exists, true) }
    }
}

!let(total_relic_count, 0)
!if marsh_relic_exists { !let(total_relic_count, total_relic_count + 1) }
!if hollow_relic_exists { !let(total_relic_count, total_relic_count + 1) }
!if glades_relic_exists { !let(total_relic_count, total_relic_count + 1) }
!if wellspring_relic_exists { !let(total_relic_count, total_relic_count + 1) }
!if woods_relic_exists { !let(total_relic_count, total_relic_count + 1) }
!if reach_relic_exists { !let(total_relic_count, total_relic_count + 1) }
!if depths_relic_exists { !let(total_relic_count, total_relic_count + 1) }
!if pools_relic_exists { !let(total_relic_count, total_relic_count + 1) }
!if wastes_relic_exists { !let(total_relic_count, total_relic_count + 1) }
!if willow_relic_exists { !let(total_relic_count, total_relic_count + 1) }
!if burrows_relic_exists { !let(total_relic_count, total_relic_count + 1) }

!tags("Relics (" + total_relic_count + ")")

on spawn store(itemTracker.relicsRequired, total_relic_count)

!if marsh_relic_exists { !state(marsh_relic_collected, Boolean) }
!if hollow_relic_exists { !state(hollow_relic_collected, Boolean) }
!if glades_relic_exists { !state(glades_relic_collected, Boolean) }
!if wellspring_relic_exists { !state(wellspring_relic_collected, Boolean) }
!if woods_relic_exists { !state(woods_relic_collected, Boolean) }
!if reach_relic_exists { !state(reach_relic_collected, Boolean) }
!if depths_relic_exists { !state(depths_relic_collected, Boolean) }
!if pools_relic_exists { !state(pools_relic_collected, Boolean) }
!if wastes_relic_exists { !state(wastes_relic_collected, Boolean) }
!if willow_relic_exists { !state(willow_relic_collected, Boolean) }
!if burrows_relic_exists { !state(burrows_relic_collected, Boolean) }

!augment_fun(check_goals_completed(), {
    if itemTracker.relicsCount < itemTracker.relicsRequired set_boolean("goals_completed", false)
})

!augment_fun(write_progress_message(), {
    new_row("Relics (" + itemTracker.relicsCount + "/" + itemTracker.relicsRequired  + "): ")
    if itemTracker.relicsCount < itemTracker.relicsRequired write_unfinished_relic_progress()
    if itemTracker.relicsCount == itemTracker.relicsRequired write_finished_relic_progress()
    add_row(get_string("row"))
})

fun write_unfinished_relic_progress() {}

!if marsh_relic_exists { !augment_fun(write_unfinished_relic_progress(),
    add_relic_row_item(current_zone() == Marsh, marsh_relic_collected, "Marsh")
)}
!if hollow_relic_exists { !augment_fun(write_unfinished_relic_progress(),
    add_relic_row_item(current_zone() == Hollow, hollow_relic_collected, "Hollow")
)}
!if glades_relic_exists { !augment_fun(write_unfinished_relic_progress(),
    add_relic_row_item(current_zone() == Glades, glades_relic_collected, "Glades")
)}
!if wellspring_relic_exists { !augment_fun(write_unfinished_relic_progress(),
    add_relic_row_item(current_zone() == Wellspring, wellspring_relic_collected, "Wellspring")
)}
!if woods_relic_exists { !augment_fun(write_unfinished_relic_progress(),
    add_relic_row_item(current_zone() == Woods, woods_relic_collected, "Woods")
)}
!if reach_relic_exists { !augment_fun(write_unfinished_relic_progress(),
    add_relic_row_item(current_zone() == Reach, reach_relic_collected, "Reach")
)}
!if depths_relic_exists { !augment_fun(write_unfinished_relic_progress(),
    add_relic_row_item(current_zone() == Depths, depths_relic_collected, "Depths")
)}
!if pools_relic_exists { !augment_fun(write_unfinished_relic_progress(),
    add_relic_row_item(current_zone() == Pools, pools_relic_collected, "Pools")
)}
!if wastes_relic_exists { !augment_fun(write_unfinished_relic_progress(),
    add_relic_row_item(current_zone() == Wastes, wastes_relic_collected, "Wastes")
)}
!if willow_relic_exists { !augment_fun(write_unfinished_relic_progress(),
    add_relic_row_item(current_zone() == Willow, willow_relic_collected, "Willow")
)}
!if burrows_relic_exists { !augment_fun(write_unfinished_relic_progress(),
    add_relic_row_item(current_zone() == Burrows, burrows_relic_collected, "Burrows")
)}

fun add_relic_row_item(current_zone: Boolean, collected: Boolean, name: String) {
    set_string("color", "")
    if current_zone {
        set_string("color", "#")
    }
    if collected {
        set_string("color", "$")
    }
    add_row_item(get_string("color") + name + get_string("color"))
}

!let(finished_relic_progress, "")
!let(comma, false)
!if marsh_relic_exists {
    !let(comma, true)
    !let(finished_relic_progress, finished_relic_progress + "Marsh")
}
!if hollow_relic_exists {
    !if comma { !let(finished_relic_progress, finished_relic_progress + ", ") }
    !let(comma, true)
    !let(finished_relic_progress, finished_relic_progress + "Hollow")
}
