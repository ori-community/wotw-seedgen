!if depths_relic_exists {
    fun depths_relic() {
        create_stats_entry(MapstoneFragment, "Depths Relic")
        item_message("@Depths Relic@")
        store(depths_relic_collected, true)
    }

    !preplace(depths_relic(), Depths)
    !item_data_name(depths_relic(), "Depths Relic")
    !item_data_map_icon(depths_relic(), MapstoneFragment)

    on depths_relic_collected store(itemTracker.relicsCount, itemTracker.relicsCount + 1)
    on depths_relic_collected == false store(itemTracker.relicsCount, itemTracker.relicsCount - 1)
}

