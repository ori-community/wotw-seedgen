}

fun write_finished_relic_progress() {
    set_string("row", "$" + get_string("row") + finished_relic_progress + "$")
}

!augment_fun(write_map_progress_message(), {
    set_boolean("exists", false)
    set_boolean("collected", false)
})

!if marsh_relic_exists { !augment_fun(write_map_progress_message(), {
    if current_map_zone() == Marsh write_map_progress_for(marsh_relic_collected)
})}
!if hollow_relic_exists { !augment_fun(write_map_progress_message(), {
    if current_map_zone() == Hollow write_map_progress_for(hollow_relic_collected)
})}
!if glades_relic_exists { !augment_fun(write_map_progress_message(), {
    if current_map_zone() == Glades write_map_progress_for(glades_relic_collected)
})}
!if wellspring_relic_exists { !augment_fun(write_map_progress_message(), {
    if current_map_zone() == Wellspring write_map_progress_for(wellspring_relic_collected)
})}
!if woods_relic_exists { !augment_fun(write_map_progress_message(), {
    if current_map_zone() == Woods write_map_progress_for(woods_relic_collected)
})}
!if reach_relic_exists { !augment_fun(write_map_progress_message(), {
    if current_map_zone() == Reach write_map_progress_for(reach_relic_collected)
})}
!if depths_relic_exists { !augment_fun(write_map_progress_message(), {
    if current_map_zone() == Depths write_map_progress_for(depths_relic_collected)
})}
!if pools_relic_exists { !augment_fun(write_map_progress_message(), {
