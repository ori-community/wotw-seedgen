#hidden
#name("Stats")
#description("Adds pickup stats")

// TODO fix burrows interrupting marsh in loc_data
!let(total_pickups_marsh, 56)
!let(total_pickups_hollow, 33)
!let(total_pickups_glades, 40)
!let(total_pickups_wellspring, 38)
// TODO fix pools being early in loc_data
// TODO fix woods being split in loc_data
!let(total_pickups_woods, 32)
!let(total_pickups_reach, 44)
!let(total_pickups_depths, 25)
!let(total_pickups_pools, 41)
!let(total_pickups_wastes, 39)
!let(total_pickups_ruins, 3)
!let(total_pickups_willow, 8)
!let(total_pickups_burrows, 7)
!let(total_pickups_shop, 23)
!let(total_pickups,
    total_pickups_marsh
    + total_pickups_hollow
    + total_pickups_glades
    + total_pickups_wellspring
    + total_pickups_woods
    + total_pickups_reach
    + total_pickups_depths
    + total_pickups_pools
    + total_pickups_wastes
    + total_pickups_ruins
    + total_pickups_willow
    + total_pickups_burrows
    + total_pickups_shop
)

!state(previous_spirit_light_collected, Integer)

on change player.spiritLight {
    set_integer("delta", player.spiritLight - previous_spirit_light_collected)

    if get_integer("delta") > 0 store(randoStats.spiritLightCollected, randoStats.spiritLightCollected + get_integer("delta"))

    store(previous_spirit_light_collected, player.spiritLight)
}

!state(previous_keystones_collected, Integer)

on change player.keystones {
    set_integer("delta", player.keystones - previous_keystones_collected)

    if get_integer("delta") > 0 store(randoStats.keystonesCollected, randoStats.keystonesCollected + get_integer("delta"))

    store(previous_keystones_collected, player.keystones)
}

!state(previous_ore_collected, Integer)

on change player.gorlekOre {
    set_integer("delta", player.gorlekOre - previous_ore_collected)

    if get_integer("delta") > 0 store(randoStats.oreCollected, randoStats.oreCollected + get_integer("delta"))

    store(previous_ore_collected, player.gorlekOre)
}

!state(after_spawn, Boolean)
on change statsUberStateGroup.distanceTravelledStatSettingSerializedFloatUberState store(after_spawn, true)
on after_spawn {
    store(randoStats.pickupsTotalMarsh, total_pickups_marsh - randoStats.pickupsCollectedMarsh)
    store(randoStats.pickupsCollectedMarsh, 0)
    store(randoStats.pickupsTotalHollow, total_pickups_hollow - randoStats.pickupsCollectedHollow)
    store(randoStats.pickupsCollectedHollow, 0)
    store(randoStats.pickupsTotalGlades, total_pickups_glades - randoStats.pickupsCollectedGlades)
    store(randoStats.pickupsCollectedGlades, 0)
    store(randoStats.pickupsTotalWellspring, total_pickups_wellspring - randoStats.pickupsCollectedWellspring)
    store(randoStats.pickupsCollectedWellspring, 0)
    store(randoStats.pickupsTotalWoods, total_pickups_woods - randoStats.pickupsCollectedWoods)
    store(randoStats.pickupsCollectedWoods, 0)
    store(randoStats.pickupsTotalReach, total_pickups_reach - randoStats.pickupsCollectedReach)
    store(randoStats.pickupsCollectedReach, 0)
    store(randoStats.pickupsTotalDepths, total_pickups_depths - randoStats.pickupsCollectedDepths)
    store(randoStats.pickupsCollectedDepths, 0)
    store(randoStats.pickupsTotalPools, total_pickups_pools - randoStats.pickupsCollectedPools)
    store(randoStats.pickupsCollectedPools, 0)
    store(randoStats.pickupsTotalWastes, total_pickups_wastes - randoStats.pickupsCollectedWastes)
    store(randoStats.pickupsCollectedWastes, 0)
    store(randoStats.pickupsTotalRuins, total_pickups_ruins - randoStats.pickupsCollectedRuins)
    store(randoStats.pickupsCollectedRuins, 0)
    store(randoStats.pickupsTotalWillow, total_pickups_willow - randoStats.pickupsCollectedWillow)
    store(randoStats.pickupsCollectedWillow, 0)
    store(randoStats.pickupsTotalBurrows, total_pickups_burrows - randoStats.pickupsCollectedBurrows)
    store(randoStats.pickupsCollectedBurrows, 0)
    store(randoStats.pickupsTotalShop, total_pickups_shop - randoStats.pickupsCollectedShop)
    store(randoStats.pickupsCollectedShop, 0)
    store(randoStats.pickupsTotal, total_pickups - randoStats.pickupsCollected)
    store(randoStats.pickupsCollected, 0)
    save()
}

