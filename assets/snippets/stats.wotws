#hidden
#name("Stats")
#description("Adds pickup stats")

!let(total_pickups_marsh, 56)
!let(total_pickups_hollow, 34)
!let(total_pickups_glades, 40)
!let(total_pickups_wellspring, 38)
!let(total_pickups_woods, 32)
!let(total_pickups_reach, 44)
!let(total_pickups_depths, 25)
!let(total_pickups_pools, 41)
!let(total_pickups_wastes, 39)
!let(total_pickups_ruins, 3)
!let(total_pickups_willow, 8)
!let(total_pickups_burrows, 7)
!let(total_pickups_shop, 23)
!let(total_pickups,
    total_pickups_marsh
    + total_pickups_hollow
    + total_pickups_glades
    + total_pickups_wellspring
    + total_pickups_woods
    + total_pickups_reach
    + total_pickups_depths
    + total_pickups_pools
    + total_pickups_wastes
    + total_pickups_ruins
    + total_pickups_willow
    + total_pickups_burrows
    + total_pickups_shop
)

!state(previous_spirit_light_collected, Integer)

on change player.spiritLight {
    set_integer("delta", player.spiritLight - previous_spirit_light_collected)

    if get_integer("delta") > 0 store(stats.spiritLightCollected, stats.spiritLightCollected + get_integer("delta"))

    store(previous_spirit_light_collected, player.spiritLight)
}

!state(previous_keystones_collected, Integer)

on change player.keystones {
    set_integer("delta", player.keystones - previous_keystones_collected)

    if get_integer("delta") > 0 store(stats.keystonesCollected, stats.keystonesCollected + get_integer("delta"))

    store(previous_keystones_collected, player.keystones)
}

!state(previous_ore_collected, Integer)

on change player.gorlekOre {
    set_integer("delta", player.gorlekOre - previous_ore_collected)

    if get_integer("delta") > 0 store(stats.oreCollected, stats.oreCollected + get_integer("delta"))

    store(previous_ore_collected, player.gorlekOre)
}

!state(after_spawn, Boolean)
on change statsUberStateGroup.distanceTravelledStatSettingSerializedFloatUberState store(after_spawn, true)
on after_spawn {
    store(stats.pickupsTotalMarsh, total_pickups_marsh - stats.pickupsCollectedMarsh)
    store(stats.pickupsCollectedMarsh, 0)
    store(stats.pickupsTotalHollow, total_pickups_hollow - stats.pickupsCollectedHollow)
    store(stats.pickupsCollectedHollow, 0)
    store(stats.pickupsTotalGlades, total_pickups_glades - stats.pickupsCollectedGlades)
    store(stats.pickupsCollectedGlades, 0)
    store(stats.pickupsTotalWellspring, total_pickups_wellspring - stats.pickupsCollectedWellspring)
    store(stats.pickupsCollectedWellspring, 0)
    store(stats.pickupsTotalWoods, total_pickups_woods - stats.pickupsCollectedWoods)
    store(stats.pickupsCollectedWoods, 0)
    store(stats.pickupsTotalReach, total_pickups_reach - stats.pickupsCollectedReach)
    store(stats.pickupsCollectedReach, 0)
    store(stats.pickupsTotalDepths, total_pickups_depths - stats.pickupsCollectedDepths)
    store(stats.pickupsCollectedDepths, 0)
    store(stats.pickupsTotalPools, total_pickups_pools - stats.pickupsCollectedPools)
    store(stats.pickupsCollectedPools, 0)
    store(stats.pickupsTotalWastes, total_pickups_wastes - stats.pickupsCollectedWastes)
    store(stats.pickupsCollectedWastes, 0)
    store(stats.pickupsTotalRuins, total_pickups_ruins - stats.pickupsCollectedRuins)
    store(stats.pickupsCollectedRuins, 0)
    store(stats.pickupsTotalWillow, total_pickups_willow - stats.pickupsCollectedWillow)
    store(stats.pickupsCollectedWillow, 0)
    store(stats.pickupsTotalBurrows, total_pickups_burrows - stats.pickupsCollectedBurrows)
    store(stats.pickupsCollectedBurrows, 0)
    store(stats.pickupsTotalShop, total_pickups_shop - stats.pickupsCollectedShop)
    store(stats.pickupsCollectedShop, 0)
    store(stats.pickupsTotal, total_pickups - stats.pickupsCollected)
    store(stats.pickupsCollected, 0)
    save()
}

