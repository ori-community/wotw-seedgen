#hidden
#name("Bonus Progress Helper")
#description("Tracks Bonus Items and their effects in a progress helper wheel item")

!builtin_icon(message_icon, "icons/game/message.png")

!include("list_core", new_column, add_row, add_current_colored_row, new_colored_row, add_colored_row_item, auto_negative_margin)
!include("regeneration_core", energy_per_second, health_per_second)

!export(add_colored_row_item)

!export(write_bonus_items)
fun write_bonus_items() {
    new_colored_row("")
}

!export(update_bonus_items)
fun update_bonus_items() {
    bonus_items_string()
    set_message_text("bonus_items", get_string("row"))
}

fun bonus_items_string() {
    write_bonus_items()
    if get_integer("color") == 0 set_string("row", "No Bonus Items")
}

on reload {
    set_wheel_item_data(
        "progress_helper",
        TopLeft,
        "Bonus Items",
        "[Ability1]View Bonus Items\n[Ability2]View Effects",
        message_icon,
    )
    set_wheel_item_action("progress_helper", TopLeft, Ability1, {
        bonus_items_string()
        controlled_priority_message("bonus_items", get_string("row"), 4)
    })
    set_wheel_item_action("progress_helper", TopLeft, Ability2, show_bonus_item_effects())
    set_wheel_item_action("progress_helper", TopLeft, Ability3, show_bonus_item_effects())
}

fun show_bonus_item_effects() {
    write_bonus_item_effects()
    controlled_priority_message("bonus_item_effects", get_string("column"), 6.0)
}

on change randoUpgrades.swordSpeedMultiplier update_bonus_item_effects()
on change randoUpgrades.swordAsFireSource update_bonus_item_effects()
on change randoUpgrades.bowCostMultiplier update_bonus_item_effects()
on change randoUpgrades.bowRapidFireIntervalDurationMultiplier update_bonus_item_effects()
on change randoUpgrades.bowAsFireSource update_bonus_item_effects()
on change randoUpgrades.spearCostMultiplier update_bonus_item_effects()
on change randoUpgrades.spearSpeedMultiplier update_bonus_item_effects()
on change randoUpgrades.spearAsFireSource update_bonus_item_effects()
on change randoUpgrades.hammerSpeedMultiplier update_bonus_item_effects()
on change randoUpgrades.hammerAsFireSource update_bonus_item_effects()
on change randoUpgrades.shurikenCostMultiplier update_bonus_item_effects()
on change randoUpgrades.shurikenDamageMultiplier update_bonus_item_effects()
on change randoUpgrades.shurikenAsFireSource update_bonus_item_effects()
on change randoUpgrades.shurikenBashable update_bonus_item_effects()
on change randoUpgrades.extraShurikens update_bonus_item_effects()
on change randoUpgrades.shurikenMultishotCount update_bonus_item_effects()
on change randoUpgrades.grenadeCostMultiplier update_bonus_item_effects()
on change randoUpgrades.grenadeChargeDurationMultiplier update_bonus_item_effects()
on change randoUpgrades.unchargedGrenadesBashable update_bonus_item_effects()
on change randoUpgrades.extraGrenades update_bonus_item_effects()
on change randoUpgrades.grenadeMultishotCount update_bonus_item_effects()
on change randoUpgrades.unchargedGrenadesBashable update_bonus_item_effects()
on change randoUpgrades.grenadesExplodeOnCollision update_bonus_item_effects()
on change randoUpgrades.regenerateCostMultiplier update_bonus_item_effects()
on change randoUpgrades.regenerateSpeedMultiplier update_bonus_item_effects()
on change randoUpgrades.flapDamage update_bonus_item_effects()
on change randoUpgrades.blazeCostMultiplier update_bonus_item_effects()
on change randoUpgrades.blazeAsFireSource update_bonus_item_effects()
on change randoUpgrades.flashCostMultiplier update_bonus_item_effects()
on change randoUpgrades.flashTickInterval update_bonus_item_effects()
on change randoUpgrades.flashDamageMultiplier update_bonus_item_effects()
on change randoUpgrades.sentryCostMultiplier update_bonus_item_effects()
on change randoUpgrades.sentryFireRateSpeed update_bonus_item_effects()
on change randoUpgrades.sentryShots update_bonus_item_effects()
on change randoUpgrades.extraSentries update_bonus_item_effects()
on change randoUpgrades.extraDoubleJumps update_bonus_item_effects()
on change randoUpgrades.jumpHeightMultiplier update_bonus_item_effects()
on change randoUpgrades.wallJumpHeightMultiplier update_bonus_item_effects()
on change randoUpgrades.doubleJumpHeightMultiplier update_bonus_item_effects()
on change randoUpgrades.extraDashes update_bonus_item_effects()
on change randoUpgrades.dashDistanceMultiplier update_bonus_item_effects()
on change randoUpgrades.bashSpeedMultiplier update_bonus_item_effects()
on change randoUpgrades.grappleSpeedMultiplier update_bonus_item_effects()
on change randoUpgrades.launchSpeedMultiplier update_bonus_item_effects()
on change randoUpgrades.burrowSpeedMultiplier update_bonus_item_effects()
on change randoUpgrades.burrowDashSpeedMultiplier update_bonus_item_effects()
on change randoUpgrades.swimSpeedMultiplier update_bonus_item_effects()
on change randoUpgrades.waterDashSpeedMultiplier update_bonus_item_effects()
on change energy_per_second update_bonus_item_effects()
on change health_per_second update_bonus_item_effects()
fun update_bonus_item_effects() {
    write_bonus_item_effects()
    set_message_text("bonus_item_effects", get_string("column"))
}

fun write_bonus_item_effects() {
    new_column("")

    new_colored_row("#Sword#: ")
    multiplier_row_item(randoUpgrades.swordSpeedMultiplier, "x Speed")
    melting_row_item(randoUpgrades.swordAsFireSource)
    add_current_colored_row()

    new_colored_row("#Bow#: ")
    multiplier_row_item(randoUpgrades.bowCostMultiplier, "x Cost")
    multiplier_row_item(1 / randoUpgrades.bowRapidFireIntervalDurationMultiplier, "x Quickshot Speed")
    melting_row_item(randoUpgrades.bowAsFireSource)
    add_current_colored_row()

    new_colored_row("#Spear#: ")
    multiplier_row_item(randoUpgrades.spearCostMultiplier, "x Cost")
    multiplier_row_item(randoUpgrades.spearSpeedMultiplier, "x Speed")
    melting_row_item(randoUpgrades.spearAsFireSource)
    add_current_colored_row()

    new_colored_row("#Hammer#: ")
    multiplier_row_item(randoUpgrades.hammerSpeedMultiplier, "x Speed")
    melting_row_item(randoUpgrades.hammerAsFireSource)
    add_current_colored_row()

    new_colored_row("#Shuriken#: ")
    multiplier_row_item(randoUpgrades.shurikenCostMultiplier, "x Cost")
    multiplier_row_item(randoUpgrades.shurikenDamageMultiplier, "x Damage")
    melting_row_item(randoUpgrades.shurikenAsFireSource)
    toggle_row_item(randoUpgrades.shurikenBashable, "Bashable")
    extra_row_item(randoUpgrades.extraShurikens, " Max")
    extra_row_item(randoUpgrades.shurikenMultishotCount, " Splinter")
    add_current_colored_row()

    new_colored_row("#Grenade#: ")
    multiplier_row_item(randoUpgrades.grenadeCostMultiplier, "x Cost")
    multiplier_row_item(1 / randoUpgrades.grenadeChargeDurationMultiplier, "x Charge Speed")
    toggle_row_item(randoUpgrades.unchargedGrenadesBashable, "Uncharged Bashable")
    extra_row_item(randoUpgrades.extraGrenades, " Max")
    extra_row_item(randoUpgrades.grenadeMultishotCount, " Splinter")
    toggle_row_item(randoUpgrades.unchargedGrenadesBashable, "Air Charge")
    toggle_row_item(randoUpgrades.grenadesExplodeOnCollision == false, "Manual Detonation")
    add_current_colored_row()

    new_colored_row("#Regenerate#: ")
    multiplier_row_item(randoUpgrades.regenerateCostMultiplier, "x Cost")
    multiplier_row_item(randoUpgrades.regenerateSpeedMultiplier, "x Speed")
    add_current_colored_row()

    if randoUpgrades.flapDamage != 0 add_row("#Flap#: " + randoUpgrades.flapDamage + " Damage")

    new_colored_row("#Blaze#: ")
    multiplier_row_item(randoUpgrades.blazeCostMultiplier, "x Cost")
    melting_row_item(randoUpgrades.blazeAsFireSource)
    add_current_colored_row()

    new_colored_row("#Flash#: ")
    multiplier_row_item(randoUpgrades.flashCostMultiplier, "x Cost")
    multiplier_row_item(1 / randoUpgrades.flashTickInterval, "x Speed")
    multiplier_row_item(randoUpgrades.flashDamageMultiplier, "x Damage")
    add_current_colored_row()

    new_colored_row("#Sentry#: ")
    multiplier_row_item(randoUpgrades.sentryCostMultiplier, "x Cost")
    multiplier_row_item(randoUpgrades.sentryFireRateSpeed, "x Fire Rate")
    integer_row_item(randoUpgrades.sentryShots, " Sentry Burst Shots", 3)
    extra_row_item(randoUpgrades.extraSentries, " Max")
    add_current_colored_row()

    new_colored_row("#Jumps#: ")
    extra_row_item(randoUpgrades.extraDoubleJumps, " Double Jumps")
    multiplier_row_item(randoUpgrades.jumpHeightMultiplier, "x Grounded Jump Height")
    multiplier_row_item(randoUpgrades.wallJumpHeightMultiplier, "x Wall Jump Height")
    multiplier_row_item(randoUpgrades.doubleJumpHeightMultiplier, "x Double Jump Height")
    add_current_colored_row()

    new_colored_row("#Dash#: ")
    extra_row_item(randoUpgrades.extraDashes, " Air Dashes")
    multiplier_row_item(randoUpgrades.dashDistanceMultiplier, "x Distance")
    if get_integer("color") == 0 set_string("row", "")
    if get_integer("color") == 1 set_integer("color", 2)
    if randoUpgrades.bashSpeedMultiplier != 1 add_colored_row_item("#Bash#: " + randoUpgrades.bashSpeedMultiplier + "x Speed")
    add_current_colored_row()

    new_colored_row("")
    if randoUpgrades.grappleSpeedMultiplier != 1 add_colored_row_item("#Grapple#: " + randoUpgrades.grappleSpeedMultiplier + "x Speed")
    if get_integer("color") == 1 set_integer("color", 2)
    if randoUpgrades.launchSpeedMultiplier != 1 add_colored_row_item("#Launch#: " + randoUpgrades.launchSpeedMultiplier + "x Speed")
    add_current_colored_row()

    set_string("right_row", "")
    new_colored_row("#Burrow#: ")
    multiplier_row_item(randoUpgrades.burrowSpeedMultiplier, "x Speed")
    multiplier_row_item(randoUpgrades.burrowDashSpeedMultiplier, "x Dash Speed")
    if get_integer("color") > 0 set_string("right_row", get_string("row"))
    new_colored_row("#Swimming#: ")
    multiplier_row_item(randoUpgrades.swimSpeedMultiplier, "x Speed")
    multiplier_row_item(randoUpgrades.waterDashSpeedMultiplier, "x Dash Speed")
    if get_string("right_row") != "" {
        if get_integer("color") == 1 set_integer("color", 2)
        add_colored_row_item(get_string("right_row"))
    }
    add_current_colored_row()

    new_colored_row("#Passive Regeneration#: ")
    if energy_per_second != 0 add_colored_row_item(energy_per_second + " Energy/s")
    if health_per_second != 0 add_colored_row_item(health_per_second + " Health/s")
    add_current_colored_row()

    // TODO remove?
    // randoUpgrades.healthRegenerationPerMinute
    // randoUpgrades.energyRegenerationPerMinute

    if get_integer("lines") == 0 set_string("column", "No Bonus Item Effects")
    auto_negative_margin()
}

fun multiplier_row_item(value: Float, name: String) {
    if value != 1 add_colored_row_item(value + name)
}

fun melting_row_item(value: Boolean) {
    toggle_row_item(value, "Melting")
}

fun toggle_row_item(value: Boolean, name: String) {
    if value add_colored_row_item(name)
}

fun extra_row_item(value: Integer, name: String) {
   if value != 0 add_colored_row_item((1 + value) + name)
}

fun integer_row_item(value: Integer, name: String, default: Integer) {
    if value != default add_colored_row_item(value + name)
}
