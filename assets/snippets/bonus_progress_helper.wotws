#hidden
#name("Bonus Progress Helper")
#description("Tracks Bonus Items and their effects in a progress helper wheel item")

!builtin_icon(message_icon, "icons/game/message.png")

!include("regeneration_core", energy_per_second, health_per_second)

!export(write_bonus_items)
fun write_bonus_items() {
    set_string("bonus_items", "")
    set_boolean("comma", false)
}

!export(write_bonus_items_part)
fun write_bonus_items_part(part: String) {
    if get_boolean("comma") set_string("bonus_items", get_string("bonus_items") + ", ")
    set_boolean("comma", true)
    set_string("bonus_items", get_string("bonus_items") + part)
}

!export(update_bonus_items)
fun update_bonus_items() {
    bonus_items_string()
    set_message_text("bonus_items", get_string("bonus_items"))
}

fun bonus_items_string() {
    write_bonus_items()
    if get_boolean("comma") == false set_string("bonus_items", "No Bonus Items")
}

on reload {
    set_wheel_item_data(
        "progress_helper",
        TopLeft,
        "Bonus Items",
        "[Ability1]View Bonus Items\n[Ability2]View Effects",
        message_icon,
    )
    set_wheel_item_action("progress_helper", TopLeft, Ability1, {
        bonus_items_string()
        controlled_priority_message("bonus_items", get_string("bonus_items"), 4)
    })
    set_wheel_item_action("progress_helper", TopLeft, Ability2, show_bonus_item_effects())
    set_wheel_item_action("progress_helper", TopLeft, Ability3, show_bonus_item_effects())
}

fun show_bonus_item_effects() {
    write_bonus_item_effects()
    controlled_priority_message("bonus_item_effects", get_string("bonus_items"), 6.0)
}

on change randoUpgrades.swordSpeedMultiplier update_bonus_item_effects()
on change randoUpgrades.swordAsFireSource update_bonus_item_effects()
on change randoUpgrades.bowCostMultiplier update_bonus_item_effects()
on change randoUpgrades.bowRapidFireIntervalDurationMultiplier update_bonus_item_effects()
on change randoUpgrades.bowAsFireSource update_bonus_item_effects()
on change randoUpgrades.spearCostMultiplier update_bonus_item_effects()
on change randoUpgrades.spearSpeedMultiplier update_bonus_item_effects()
on change randoUpgrades.spearAsFireSource update_bonus_item_effects()
on change randoUpgrades.hammerSpeedMultiplier update_bonus_item_effects()
on change randoUpgrades.hammerAsFireSource update_bonus_item_effects()
on change randoUpgrades.shurikenCostMultiplier update_bonus_item_effects()
on change randoUpgrades.shurikenDamageMultiplier update_bonus_item_effects()
on change randoUpgrades.shurikenAsFireSource update_bonus_item_effects()
on change randoUpgrades.shurikenBashable update_bonus_item_effects()
on change randoUpgrades.extraShurikens update_bonus_item_effects()
on change randoUpgrades.shurikenMultishotCount update_bonus_item_effects()
on change randoUpgrades.grenadeCostMultiplier update_bonus_item_effects()
on change randoUpgrades.grenadeChargeDurationMultiplier update_bonus_item_effects()
on change randoUpgrades.unchargedGrenadesBashable update_bonus_item_effects()
on change randoUpgrades.extraGrenades update_bonus_item_effects()
on change randoUpgrades.grenadeMultishotCount update_bonus_item_effects()
on change randoUpgrades.unchargedGrenadesBashable update_bonus_item_effects()
on change randoUpgrades.grenadesExplodeOnCollision update_bonus_item_effects()
on change randoUpgrades.regenerateCostMultiplier update_bonus_item_effects()
on change randoUpgrades.regenerateSpeedMultiplier update_bonus_item_effects()
on change randoUpgrades.flapDamage update_bonus_item_effects()
on change randoUpgrades.blazeCostMultiplier update_bonus_item_effects()
on change randoUpgrades.blazeAsFireSource update_bonus_item_effects()
on change randoUpgrades.flashCostMultiplier update_bonus_item_effects()
on change randoUpgrades.flashTickInterval update_bonus_item_effects()
on change randoUpgrades.flashDamageMultiplier update_bonus_item_effects()
on change randoUpgrades.sentryCostMultiplier update_bonus_item_effects()
on change randoUpgrades.sentryFireRateSpeed update_bonus_item_effects()
on change randoUpgrades.sentryShots update_bonus_item_effects()
on change randoUpgrades.extraSentries update_bonus_item_effects()
on change randoUpgrades.extraDoubleJumps update_bonus_item_effects()
on change randoUpgrades.jumpHeightMultiplier update_bonus_item_effects()
on change randoUpgrades.wallJumpHeightMultiplier update_bonus_item_effects()
on change randoUpgrades.doubleJumpHeightMultiplier update_bonus_item_effects()
on change randoUpgrades.extraDashes update_bonus_item_effects()
on change randoUpgrades.dashDistanceMultiplier update_bonus_item_effects()
on change randoUpgrades.bashSpeedMultiplier update_bonus_item_effects()
on change randoUpgrades.grappleSpeedMultiplier update_bonus_item_effects()
on change randoUpgrades.launchSpeedMultiplier update_bonus_item_effects()
on change randoUpgrades.burrowSpeedMultiplier update_bonus_item_effects()
on change randoUpgrades.burrowDashSpeedMultiplier update_bonus_item_effects()
on change randoUpgrades.swimSpeedMultiplier update_bonus_item_effects()
on change randoUpgrades.waterDashSpeedMultiplier update_bonus_item_effects()
on change energy_per_second update_bonus_item_effects()
on change health_per_second update_bonus_item_effects()
fun update_bonus_item_effects() {
    write_bonus_item_effects()
    set_message_text("bonus_item_effects", get_string("bonus_items"))
}

fun write_bonus_item_effects() {
    set_string("bonus_items", "")
    set_boolean("newline", false)

    set_string("line", "#Sword#: ")
    set_boolean("comma", false)
    write_multiplier_part(randoUpgrades.swordSpeedMultiplier, "x Speed")
    write_melting_part(randoUpgrades.swordAsFireSource)
    if get_boolean("comma") write_effects_line()

    set_string("line", "#Bow#: ")
    set_boolean("comma", false)
    write_multiplier_part(randoUpgrades.bowCostMultiplier, "x Cost")
    write_multiplier_part(1 / randoUpgrades.bowRapidFireIntervalDurationMultiplier, "x Quickshot Speed")
    write_melting_part(randoUpgrades.bowAsFireSource)
    if get_boolean("comma") write_effects_line()

    set_string("line", "#Spear#: ")
    set_boolean("comma", false)
    write_multiplier_part(randoUpgrades.spearCostMultiplier, "x Cost")
    write_multiplier_part(randoUpgrades.spearSpeedMultiplier, "x Speed")
    write_melting_part(randoUpgrades.spearAsFireSource)
    if get_boolean("comma") write_effects_line()

    set_string("line", "#Hammer#: ")
    set_boolean("comma", false)
    write_multiplier_part(randoUpgrades.hammerSpeedMultiplier, "x Speed")
    write_melting_part(randoUpgrades.hammerAsFireSource)
    if get_boolean("comma") write_effects_line()

    set_string("line", "#Shuriken#: ")
    set_boolean("comma", false)
    write_multiplier_part(randoUpgrades.shurikenCostMultiplier, "x Cost")
    write_multiplier_part(randoUpgrades.shurikenDamageMultiplier, "x Damage")
    write_melting_part(randoUpgrades.shurikenAsFireSource)
    write_toggle_part(randoUpgrades.shurikenBashable, "Bashable")
    write_extra_part(randoUpgrades.extraShurikens, " Max")
    write_extra_part(randoUpgrades.shurikenMultishotCount, " Splinter")
    if get_boolean("comma") write_effects_line()

    set_string("line", "#Grenade#: ")
    set_boolean("comma", false)
    write_multiplier_part(randoUpgrades.grenadeCostMultiplier, "x Cost")
    write_multiplier_part(1 / randoUpgrades.grenadeChargeDurationMultiplier, "x Charge Speed")
    write_toggle_part(randoUpgrades.unchargedGrenadesBashable, "Uncharged Bashable")
    write_extra_part(randoUpgrades.extraGrenades, " Max")
    write_extra_part(randoUpgrades.grenadeMultishotCount, " Splinter")
    write_toggle_part(randoUpgrades.unchargedGrenadesBashable, "Air Charge")
    write_toggle_part(randoUpgrades.grenadesExplodeOnCollision == false, "Manual Detonation")
    if get_boolean("comma") write_effects_line()

    set_string("line", "#Regenerate#: ")
    set_boolean("comma", false)
    write_multiplier_part(randoUpgrades.regenerateCostMultiplier, "x Cost")
    write_multiplier_part(randoUpgrades.regenerateSpeedMultiplier, "x Speed")
    if get_boolean("comma") write_effects_line()

    if randoUpgrades.flapDamage != 0 {
        set_string("line", "#Flap#: " + randoUpgrades.flapDamage + " Damage")
        write_effects_line()
    }

    set_string("line", "#Blaze#: ")
    set_boolean("comma", false)
    write_multiplier_part(randoUpgrades.blazeCostMultiplier, "x Cost")
    write_melting_part(randoUpgrades.blazeAsFireSource)
    if get_boolean("comma") write_effects_line()

    set_string("line", "#Flash#: ")
    set_boolean("comma", false)
    write_multiplier_part(randoUpgrades.flashCostMultiplier, "x Cost")
    write_multiplier_part(1 / randoUpgrades.flashTickInterval, "x Speed")
    write_multiplier_part(randoUpgrades.flashDamageMultiplier, "x Damage")
    if get_boolean("comma") write_effects_line()

    set_string("line", "#Sentry#: ")
    set_boolean("comma", false)
    write_multiplier_part(randoUpgrades.sentryCostMultiplier, "x Cost")
    write_multiplier_part(randoUpgrades.sentryFireRateSpeed, "x Fire Rate")
    write_integer_part(randoUpgrades.sentryShots, " Sentry Burst Shots", 3)
    write_extra_part(randoUpgrades.extraSentries, " Max")
    if get_boolean("comma") write_effects_line()

    set_string("line", "#Jumps#: ")
    set_boolean("comma", false)
    write_extra_part(randoUpgrades.extraDoubleJumps, " Double Jumps")
    write_multiplier_part(randoUpgrades.jumpHeightMultiplier, "x Grounded Jump Height")
    write_multiplier_part(randoUpgrades.wallJumpHeightMultiplier, "x Wall Jump Height")
    write_multiplier_part(randoUpgrades.doubleJumpHeightMultiplier, "x Double Jump Height")
    if get_boolean("comma") write_effects_line()

    set_string("line", "#Dash#: ")
    set_boolean("comma", false)
    write_extra_part(randoUpgrades.extraDashes, " Air Dashes")
    write_multiplier_part(randoUpgrades.dashDistanceMultiplier, "x Distance")
    if get_boolean("comma") == false set_string("line", "")
    if randoUpgrades.bashSpeedMultiplier != 1 write_effects_part("#Bash#: " + randoUpgrades.bashSpeedMultiplier + "x Speed")
    if get_boolean("comma") write_effects_line()

    set_string("line", "")
    set_boolean("comma", false)
    if randoUpgrades.grappleSpeedMultiplier != 1 write_effects_part("#Grapple#: " + randoUpgrades.grappleSpeedMultiplier + "x Speed")
    if randoUpgrades.launchSpeedMultiplier != 1 write_effects_part("#Launch#: " + randoUpgrades.launchSpeedMultiplier + "x Speed")
    if get_boolean("comma") write_effects_line()

    set_string("right_line", "")
    set_string("line", "#Burrow#: ")
    set_boolean("comma", false)
    write_multiplier_part(randoUpgrades.burrowSpeedMultiplier, "x Speed")
    write_multiplier_part(randoUpgrades.burrowDashSpeedMultiplier, "x Dash Speed")
    if get_boolean("comma") set_string("right_line", get_string("line"))
    set_string("line", "#Swimming#: ")
    set_boolean("comma", false)
    write_multiplier_part(randoUpgrades.swimSpeedMultiplier, "x Speed")
    write_multiplier_part(randoUpgrades.waterDashSpeedMultiplier, "x Dash Speed")
    if get_string("right_line") != "" write_effects_part(get_string("right_line"))
    if get_boolean("comma") write_effects_line()

    set_string("line", "#Passive Regeneration#: ")
    set_boolean("comma", false)
    if energy_per_second != 0 write_effects_part(energy_per_second + " Energy/s")
    if health_per_second != 0 write_effects_part(health_per_second + " Health/s")
    if get_boolean("comma") write_effects_line()

    // TODO remove?
    // randoUpgrades.healthRegenerationPerMinute
    // randoUpgrades.energyRegenerationPerMinute

    if get_boolean("newline") == false set_string("bonus_items", "No Bonus Item Effects")
}

fun write_multiplier_part(value: Float, name: String) {
    if value != 1 write_effects_part(value + name)
}

fun write_melting_part(value: Boolean) {
    write_toggle_part(value, "Melting")
}

fun write_toggle_part(value: Boolean, name: String) {
    if value write_effects_part(name)
}

fun write_extra_part(value: Integer, name: String) {
   if value != 0 write_effects_part((1 + value) + name)
}

fun write_integer_part(value: Integer, name: String, default: Integer) {
    if value != default write_effects_part(value + name)
}

fun write_effects_part(part: String) {
    if get_boolean("comma") set_string("line", get_string("line") + ", ")
    set_boolean("comma", true)
    set_string("line", get_string("line") + part)
}

fun write_effects_line() {
    if get_boolean("newline") set_string("bonus_items", get_string("bonus_items") + "\n")
    set_boolean("newline", true)
    set_string("bonus_items", get_string("bonus_items") + get_string("line"))
}
