#hidden
#name("Wisp Count")
#description("Counts the amount of collected Wisps")

on Hollow.Wisp store(itemTracker.wispsCount, itemTracker.wispsCount + 1)
on Hollow.Wisp == false store(itemTracker.wispsCount, itemTracker.wispsCount - 1)
on Pools.Wisp store(itemTracker.wispsCount, itemTracker.wispsCount + 1)
on Pools.Wisp == false store(itemTracker.wispsCount, itemTracker.wispsCount - 1)
on Reach.Wisp store(itemTracker.wispsCount, itemTracker.wispsCount + 1)
on Reach.Wisp == false store(itemTracker.wispsCount, itemTracker.wispsCount - 1)
on Depths.Wisp store(itemTracker.wispsCount, itemTracker.wispsCount + 1)
on Depths.Wisp == false store(itemTracker.wispsCount, itemTracker.wispsCount - 1)
on Ruins.Wisp store(itemTracker.wispsCount, itemTracker.wispsCount + 1)
on Ruins.Wisp == false store(itemTracker.wispsCount, itemTracker.wispsCount - 1)
