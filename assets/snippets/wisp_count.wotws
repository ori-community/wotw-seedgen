#hidden
#name("Wisp Count")
#description("Counts the amount of collected Wisps")

on EastHollow.ForestsVoice store(itemTracker.wispsCount, itemTracker.wispsCount + 1)
on EastHollow.ForestsVoice == false store(itemTracker.wispsCount, itemTracker.wispsCount - 1)
on WestPools.ForestsStrength store(itemTracker.wispsCount, itemTracker.wispsCount + 1)
on WestPools.ForestsStrength == false store(itemTracker.wispsCount, itemTracker.wispsCount - 1)
on LowerReach.ForestsMemory store(itemTracker.wispsCount, itemTracker.wispsCount + 1)
on LowerReach.ForestsMemory == false store(itemTracker.wispsCount, itemTracker.wispsCount - 1)
on UpperDepths.ForestsEyes store(itemTracker.wispsCount, itemTracker.wispsCount + 1)
on UpperDepths.ForestsEyes == false store(itemTracker.wispsCount, itemTracker.wispsCount - 1)
on WindtornRuins.ForestsHeart store(itemTracker.wispsCount, itemTracker.wispsCount + 1)
on WindtornRuins.ForestsHeart == false store(itemTracker.wispsCount, itemTracker.wispsCount - 1)
