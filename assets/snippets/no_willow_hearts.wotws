#category("World Changes")
#name("No Willow Hearts")
#description("Start with the final door in Willow's End open")

!tags("No Willow Hearts")

on spawn {
    store(Willow.GlideHeart, true)
    store(Willow.SpinLasersHeart, true)
    store(Willow.SpinPortalsHeart, true)
    store(Willow.MinibossHeart, true)
    store(Willow.BurrowHeart, true)
    store(Willow.RedirectHeart, true)
    store(Willow.BoulderHeart, true)
    store(Willow.GrappleWheelsHeart, true)
}
