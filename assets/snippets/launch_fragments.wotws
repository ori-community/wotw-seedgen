#category("Item Pool")
#name("Launch Fragments")
#description("Launch is split up into fragments you have to find. This puts Launch more into the lategame.")

!config_integer(total, 5, "Total", "How many Launch Fragments to shuffle in")
!config_integer(required, 3, "Required", "How many Launch Fragments are required to get Launch")
!tags("Launch Fragments (" + required + "/" + total + ")")

!include("launch_fragments_core", launch_fragment)

on spawn store(itemTracker.launchFragmentsRequired, required)

!add_item(launch_fragment(), total)

!remove_item(skill(Launch), 1)

!only_simulation { on spawn store(itemTracker.launchFragmentsRequired, total) }
