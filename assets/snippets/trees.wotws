#category("Goals")
#name("All Trees")
#description("Require visiting all Trees before fighting Shriek")

!tags("All Trees")

!include("goal_mode_core", write_goal_progress_message, check_goals_completed, write_goals_incomplete_message, update_goals_completed)

!let(max_trees, 14)

!augment_fun(write_goal_progress_message(), {
    if get_boolean("comma") set_string("goal_progress_message", get_string("goal_progress_message") + ", ")
    set_boolean("comma", true)
    set_string("color", "")
    if itemTracker.treesCount == max_trees set_string("color", "$")
    write_trees_message(get_string("color"))
    set_string("goal_progress_message", get_string("goal_progress_message") + get_string("trees_message"))
})

!augment_fun(check_goals_completed(), {
    if itemTracker.treesCount < max_trees set_boolean("goals_completed", false)
})

on spawn store(itemTracker.treesRequired, max_trees)

on MarshSpawn.RegenTree store(itemTracker.treesCount, itemTracker.treesCount + 1)
on MarshSpawn.RegenTree == false store(itemTracker.treesCount, itemTracker.treesCount - 1)
on MarshSpawn.DamageTree store(itemTracker.treesCount, itemTracker.treesCount + 1)
on MarshSpawn.DamageTree == false store(itemTracker.treesCount, itemTracker.treesCount - 1)
on HowlsDen.SwordTree store(itemTracker.treesCount, itemTracker.treesCount + 1)
on HowlsDen.SwordTree == false store(itemTracker.treesCount, itemTracker.treesCount - 1)
on HowlsDen.DoubleJumpTree store(itemTracker.treesCount, itemTracker.treesCount + 1)
on HowlsDen.DoubleJumpTree == false store(itemTracker.treesCount, itemTracker.treesCount - 1)
on MarshPastOpher.BowTree store(itemTracker.treesCount, itemTracker.treesCount + 1)
on MarshPastOpher.BowTree == false store(itemTracker.treesCount, itemTracker.treesCount - 1)
on WestHollow.DashTree store(itemTracker.treesCount, itemTracker.treesCount + 1)
on WestHollow.DashTree == false store(itemTracker.treesCount, itemTracker.treesCount - 1)
on EastHollow.BashTree store(itemTracker.treesCount, itemTracker.treesCount + 1)
on EastHollow.BashTree == false store(itemTracker.treesCount, itemTracker.treesCount - 1)
on GladesTown.DamageTree store(itemTracker.treesCount, itemTracker.treesCount + 1)
on GladesTown.DamageTree == false store(itemTracker.treesCount, itemTracker.treesCount - 1)
on InnerWellspring.GrappleTree store(itemTracker.treesCount, itemTracker.treesCount + 1)
on InnerWellspring.GrappleTree == false store(itemTracker.treesCount, itemTracker.treesCount - 1)
on UpperReach.GrenadeTree store(itemTracker.treesCount, itemTracker.treesCount + 1)
on UpperReach.GrenadeTree == false store(itemTracker.treesCount, itemTracker.treesCount - 1)
on UpperPools.WaterDashTree store(itemTracker.treesCount, itemTracker.treesCount + 1)
on UpperPools.WaterDashTree == false store(itemTracker.treesCount, itemTracker.treesCount - 1)
on LowerDepths.FlashTree store(itemTracker.treesCount, itemTracker.treesCount + 1)
on LowerDepths.FlashTree == false store(itemTracker.treesCount, itemTracker.treesCount - 1)
on LowerWastes.BurrowTree store(itemTracker.treesCount, itemTracker.treesCount + 1)
on LowerWastes.BurrowTree == false store(itemTracker.treesCount, itemTracker.treesCount - 1)
on WeepingRidge.LaunchTree store(itemTracker.treesCount, itemTracker.treesCount + 1)
on WeepingRidge.LaunchTree == false store(itemTracker.treesCount, itemTracker.treesCount - 1)

on change itemTracker.treesCount update_goals_completed()

// TODO maybe do a fancier feedback message pointing out what exactly you are missing?

!augment_fun(write_goals_incomplete_message(), {
    if itemTracker.treesCount < max_trees {
        write_trees_message("@")
        set_string("goals_incomplete_message", get_string("goals_incomplete_message") + "\n" + get_string("trees_message"))
    }
})

fun write_trees_message(color: String) {
    set_string("trees_message", color + "Trees: " + itemTracker.treesCount + "/" + max_trees + color)
}
