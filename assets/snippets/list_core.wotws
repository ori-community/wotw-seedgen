#hidden
#name("List Core")
#description("Various helpers to create lists")

!include("color_core", invisible, bright_yellow as default_color)
!export(default_color)

!export(new_row)
fun new_row(front: String) {
    set_string("row", front)
    set_boolean("comma", false)
}

!export(add_row_item)
fun add_row_item(item: String) {
    if get_boolean("comma") set_string("row", get_string("row") + ", ")
    set_string("row", get_string("row") + item)
    set_boolean("comma", true)
}

!let(next_item_first, 0)
!export(next_item_first)
!let(next_item_colored, 1)
!export(next_item_colored)
!let(next_item_uncolored, 2)
!export(next_item_uncolored)

!export(new_colored_row)
fun new_colored_row(front: String) {
    set_string("row", front)
    set_integer("next_item", next_item_first) // 0 = not started, 1 = next yellow, 2 = next white
}

!export(add_colored_row_item)
fun add_colored_row_item(item: String) {
    add_colored_row_item_with(item, default_color)
}

!export(add_colored_row_item_with)
fun add_colored_row_item_with(item: String, color: String) {
    if get_integer("next_item") > next_item_first set_string("row", get_string("row") + ", ")

    if get_integer("next_item") == next_item_colored set_string("row", get_string("row") + color)
    set_string("row", get_string("row") + item)
    if get_integer("next_item") == next_item_colored set_string("row", get_string("row") + "</>")

    set_integer("next_item", get_integer("next_item") + 1)
    if get_integer("next_item") > next_item_uncolored set_integer("next_item", next_item_colored)
}

!export(new_column)
fun new_column(top: String) {
    set_string("column", top)
    set_integer("lines", 0)
}

!export(add_row)
fun add_row(row: String) {
    if get_integer("lines") > 0 set_string("column", get_string("column") + "\n")
    set_string("column", get_string("column") + row)
    set_integer("lines", get_integer("lines") + 1)
}

!export(add_current_row)
fun add_current_row() {
    if get_boolean("comma") add_row(get_string("row"))
}

!export(add_current_colored_row)
fun add_current_colored_row() {
    if get_integer("next_item") > 0 add_row(get_string("row"))
}

!export(auto_negative_margin)
fun auto_negative_margin() {
    if get_integer("lines") > 0 {
        // negative margin hack
        set_string("column", "<ls_-" + (get_integer("lines") - 1) * 0.1 + ">" + invisible + ".</></>\n" + get_string("column"))
    }
}
