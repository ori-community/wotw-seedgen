#category("Placements")
#name("Black Market")
#description(
"Opher and Twillen sell Keystones and Gorlek Ore respectively. These items are never required to beat the seed.
Supply lasts indefinitely, but the price grows with the demand.")

!config(keystones, "Keystones", "Let Opher sell Keystones", Boolean, true)
!config(ores, "Gorlek Ore", "Let Twillen sell Gorlek Ore", Boolean, true)

!builtin_icon(keystone_icon, "icons/game/keystone.png")
!builtin_icon(ore_icon, "icons/game/gorlekore.png")

// TODO black market delivery at an increased price?

!if keystones {
    !state(keystone_price, Integer)
    !let(base_price, 200)

    on spawn set_shop_item_data(
        OpherShop.FastTravel,
        base_price,
        "Black Market Keystone",
        "If anyone asks, you found it in a cave!",
        keystone_icon,
    )

    !remove_location(OpherShop.FastTravel)
    on reload disable_server_sync(OpherShop.FastTravel)
    on OpherShop.FastTravel {
        store(OpherShop.FastTravel, false)
        keystone()

        if keystone_price < 5 * base_price {
            store(keystone_price, keystone_price + base_price)
            set_shop_item_price(OpherShop.FastTravel, keystone_price)
        }
    }
}

!if ores {
    !state(ore_price, Integer)
    !let(base_price, 200)

    on spawn set_shop_item_data(
        TwillenShop.LightHarvest,
        base_price,
        "Black Market Ore",
        "If anyone asks, you found it in the Gorlek Mines!",
        ore_icon,
    )

    !remove_location(TwillenShop.LightHarvest)
    on reload disable_server_sync(TwillenShop.LightHarvest)
    on TwillenShop.LightHarvest {
        store(TwillenShop.LightHarvest, false)
        gorlek_ore()

        if ore_price < 5 * base_price {
            store(ore_price, ore_price + base_price)
            set_shop_item_price(TwillenShop.LightHarvest, ore_price)
        }
    }
}
