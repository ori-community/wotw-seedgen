#category("Placements")
#name("Black Market")
#description(
"Opher and Twillen sell Keystones and Gorlek Ore respectively. These items are never required to beat the seed.
Supply lasts indefinitely, but the price grows with the demand.")

!config_boolean(keystones, true, "Keystones", "Let Opher sell Keystones")
!config_boolean(ores, true, "Gorlek Ore", "Let Twillen sell Gorlek Ore")

!builtin_icon(keystone_icon, "icons/game/keystone.png")
!builtin_icon(ore_icon, "icons/game/gorlekore.png")

// TODO black market delivery at an increased price?

!if keystones {
    !state(keystone_price, Integer)
    !let(base_price, 200)

    on spawn set_shop_item_data(
        Shop.Opher.Slot12,
        base_price,
        "Black Market Keystone",
        "If anyone asks, you found it in a cave!",
        keystone_icon,
    )

    on reload disable_server_sync(Shop.Opher.Slot12)
    on Shop.Opher.Slot12 {
        store(Shop.Opher.Slot12, false)
        keystone()

        if keystone_price < 5 * base_price {
            store(keystone_price, keystone_price + base_price)
            set_shop_item_price(Shop.Opher.Slot12, keystone_price)
        }
    }

    !only_simulation {
        on spawn store_without_triggers(Shop.Opher.Slot12, true)
    }
}

!if ores {
    !state(ore_price, Integer)
    !let(base_price, 200)

    on spawn set_shop_item_data(
        Shop.Twillen.Slot5,
        base_price,
        "Black Market Ore",
        "If anyone asks, you found it in the Gorlek Mines!",
        ore_icon,
    )

    on reload disable_server_sync(Shop.Twillen.Slot5)
    on Shop.Twillen.Slot5 {
        store(Shop.Twillen.Slot5, false)
        gorlek_ore()

        if ore_price < 5 * base_price {
            store(ore_price, ore_price + base_price)
            set_shop_item_price(Shop.Twillen.Slot5, ore_price)
        }
    }

    !only_simulation {
        on spawn store_without_triggers(Shop.Twillen.Slot5, true)
    }
}
