#hidden
#name("Bingo")
#description("Bingo snippet included by the launcher when playing Bingo games")
!tags("Bingo")

!config_boolean(cards, false, "Cards", "cards = false, lines = true")
!config_integer(amount, 0, "Amount", "The amount of cards/lines required")
!include("goal_mode_core", check_goals_completed, write_missing_goals, update_goals)
!include("list_core", add_row)

!if (cards) {
  !augment_fun(check_goals_completed(), {
    if bingo.squares < amount set_boolean("goals_completed", false)
  })

  !augment_fun(write_missing_goals(), {
      if bingo.squares < amount {
          set_string("color", "@")
          add_row(get_string("color") + "Cards: " + bingo.squares + "/" + amount + get_string("color"))
      }
  })

  on change bingo.squares update_goals()
}

!if (cards == false) {
  !augment_fun(check_goals_completed(), {
    if bingo.lines < amount set_boolean("goals_completed", false)
  })

  !augment_fun(write_missing_goals(), {
      if bingo.lines < amount {
          set_string("color", "@")
          add_row(get_string("color") + "Lines: " + bingo.lines + "/" + amount + get_string("color"))
      }
  })

  on change bingo.lines update_goals()
}
