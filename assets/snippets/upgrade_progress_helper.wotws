#hidden
#name("Upgrade Progress Helper")
#description("Tracks vanilla and bonus upgrades in a progress helper wheel item")

!builtin_icon(message_icon, "icons/game/message.png")

!include("color_core", transparent)
!include("list_core", default_color, new_column, add_row, add_current_colored_row, next_item_first, next_item_colored, next_item_uncolored, new_colored_row, add_colored_row_item_with, auto_negative_margin)
!include("regeneration_core", energy_per_second, health_per_second)

!export(write_upgrades)
fun write_upgrades(relevant: Boolean) {
    if skills.spear == relevant add_upgrade("Exploding Spear")
    if skills.hammer == relevant add_upgrade("Hammer Shockwave")
    if skills.shuriken == relevant add_upgrade("Static Shuriken")
    if skills.blaze == relevant add_upgrade("Charge Blaze")
    if skills.sentry == relevant add_upgrade("Rapid Sentry")
    if skills.bow == relevant add_upgrade("Long Splinter")
}

!export(add_upgrade)
fun add_upgrade(item: String) {
    add_colored_row_item_with(item, get_string("row_item_color"))
}

!export(update_upgrades)
fun update_upgrades() {
    upgrades_row()
    set_message_text("upgrades", get_string("row"))
}

fun upgrades_row() {
    new_colored_row("")

    set_string("row_item_color", default_color)
    write_upgrades(true)

    set_string("row", get_string("row") + transparent)

    set_string("row_item_color", transparent)
    write_upgrades(false)

    if get_integer("next_item") == next_item_first set_string("row", "No Upgrades")
}

on reload {
    set_wheel_item_data(
        "progress_helper",
        TopLeft,
        "Upgrades",
        "[Ability1]View Upgrades\n[Ability2]View Effects",
        message_icon,
    )
    set_wheel_item_action("progress_helper", TopLeft, Ability1, {
        upgrades_row()
        controlled_priority_message("upgrades", get_string("row"), 4)
    })
    set_wheel_item_action("progress_helper", TopLeft, Ability2, show_upgrade_effects())
    set_wheel_item_action("progress_helper", TopLeft, Ability3, show_upgrade_effects())
}

fun show_upgrade_effects() {
    write_upgrade_effects()
    controlled_priority_message("upgrade_effects", get_string("column"), 6.0)
}

on change playerUberStateGroupDescriptor.spikeExplosiveUpgradeLevel update_upgrade_effects()
on change playerUberStateGroupDescriptor.hammerStompUpgradeLevel update_upgrade_effects()
on change playerUberStateGroupDescriptor.chakramSpinUpgradeLevel update_upgrade_effects()
on change playerUberStateGroupDescriptor.blazeChargeUpgradeLevel update_upgrade_effects()
on change playerUberStateGroupDescriptor.sentrySpeedUpgradeLevel update_upgrade_effects()
on change bonusUpgrades.swordSpeedMultiplier update_upgrade_effects()
on change bonusUpgrades.meltingSword update_upgrade_effects()
on change bonusUpgrades.bowCost update_upgrade_effects()
on change bonusUpgrades.quickshotIntervalDurationMultiplier update_upgrade_effects()
on change bonusUpgrades.meltingBow update_upgrade_effects()
on change bonusUpgrades.spearCost update_upgrade_effects()
on change bonusUpgrades.spearSpeedMultiplier update_upgrade_effects()
on change bonusUpgrades.meltingSpear update_upgrade_effects()
on change bonusUpgrades.hammerSpeedMultiplier update_upgrade_effects()
on change bonusUpgrades.meltingHammer update_upgrade_effects()
on change bonusUpgrades.shurikenCost update_upgrade_effects()
on change bonusUpgrades.shurikenDamageMultiplier update_upgrade_effects()
on change bonusUpgrades.meltingShuriken update_upgrade_effects()
on change bonusUpgrades.shurikenBashable update_upgrade_effects()
on change bonusUpgrades.maxShurikens update_upgrade_effects()
on change bonusUpgrades.splinterShurikenCount update_upgrade_effects()
on change bonusUpgrades.grenadeCost update_upgrade_effects()
on change bonusUpgrades.grenadeChargeDurationMultiplier update_upgrade_effects()
on change bonusUpgrades.unchargedGrenadesBashable update_upgrade_effects()
on change bonusUpgrades.maxGrenades update_upgrade_effects()
on change bonusUpgrades.splinterGrenadeCount update_upgrade_effects()
on change bonusUpgrades.unchargedGrenadesBashable update_upgrade_effects()
on change bonusUpgrades.grenadesExplodeOnCollision update_upgrade_effects()
on change bonusUpgrades.regenerateCost update_upgrade_effects()
on change bonusUpgrades.regenerateSpeedMultiplier update_upgrade_effects()
on change bonusUpgrades.flapDamage update_upgrade_effects()
on change bonusUpgrades.blazeCost update_upgrade_effects()
on change bonusUpgrades.chargeBlazeCost update_upgrade_effects()
on change bonusUpgrades.meltingBlaze update_upgrade_effects()
on change bonusUpgrades.flashCostInitial update_upgrade_effects()
on change bonusUpgrades.flashCostPerSecond update_upgrade_effects()
on change bonusUpgrades.flashDamageIntervalDurationMultiplier update_upgrade_effects()
on change bonusUpgrades.flashDamageMultiplier update_upgrade_effects()
on change bonusUpgrades.sentryCost update_upgrade_effects()
on change bonusUpgrades.sentryFireRateMultiplier update_upgrade_effects()
on change bonusUpgrades.sentryShotsPerBurst update_upgrade_effects()
on change bonusUpgrades.maxSentries update_upgrade_effects()
on change bonusUpgrades.maxDoubleJumps update_upgrade_effects()
on change bonusUpgrades.jumpHeightMultiplier update_upgrade_effects()
on change bonusUpgrades.wallJumpSpeedMultiplier update_upgrade_effects()
on change bonusUpgrades.doubleJumpSpeedMultiplier update_upgrade_effects()
on change bonusUpgrades.maxAirDashes update_upgrade_effects()
on change bonusUpgrades.dashDistanceMultiplier update_upgrade_effects()
on change bonusUpgrades.bashSpeedMultiplier update_upgrade_effects()
on change bonusUpgrades.grappleSpeedMultiplier update_upgrade_effects()
on change bonusUpgrades.launchSpeedMultiplier update_upgrade_effects()
on change bonusUpgrades.burrowSpeedMultiplier update_upgrade_effects()
on change bonusUpgrades.burrowDashSpeedMultiplier update_upgrade_effects()
on change bonusUpgrades.swimSpeedMultiplier update_upgrade_effects()
on change bonusUpgrades.waterDashSpeedMultiplier update_upgrade_effects()
on change bonusUpgrades.splinterLongerRange update_upgrade_effects()
on change energy_per_second update_upgrade_effects()
on change health_per_second update_upgrade_effects()
fun update_upgrade_effects() {
    write_upgrade_effects()
    set_message_text("upgrade_effects", get_string("column"))
}

fun write_upgrade_effects() {
    new_column("")

    set_string("skill_color", "#")
    set_string("row_item_color", default_color)
    upgrade_effects_half(true)

    set_string("column", get_string("column") + transparent)

    set_string("skill_color", "")
    set_string("row_item_color", transparent)
    upgrade_effects_half(false)

    if get_integer("lines") == 0 set_string("column", "No Upgrade Effects")
    auto_negative_margin()
}

fun upgrade_effects_half(relevant: Boolean) {
    if skills.sword == relevant {
        new_upgrade_effect_row("Sword")
        multiplier_row_item(bonusUpgrades.swordSpeedMultiplier, "x Speed")
        melting_row_item(bonusUpgrades.meltingSword)
        add_current_colored_row()
    }

    if skills.bow == relevant {
        new_upgrade_effect_row("Bow")
        float_row_item(bonusUpgrades.bowCost, " Cost", 0.25)
        multiplier_row_item(1 / bonusUpgrades.quickshotIntervalDurationMultiplier, "x Quickshot Speed")
        toggle_row_item(bonusUpgrades.splinterLongerRange, "Long Splinter")
        melting_row_item(bonusUpgrades.meltingBow)
        add_current_colored_row()
    }

    if skills.spear == relevant {
        new_upgrade_effect_row("Spear")
        float_row_item(bonusUpgrades.spearCost, " Cost", 2)
        multiplier_row_item(bonusUpgrades.spearSpeedMultiplier, "x Speed")
        toggle_row_item(playerUberStateGroupDescriptor.spikeExplosiveUpgradeLevel > 0, "Exploding")
        melting_row_item(bonusUpgrades.meltingSpear)
        add_current_colored_row()
    }

    if skills.hammer == relevant {
        new_upgrade_effect_row("Hammer")
        multiplier_row_item(bonusUpgrades.hammerSpeedMultiplier, "x Speed")
        toggle_row_item(playerUberStateGroupDescriptor.hammerStompUpgradeLevel > 0, "Shockwave")
        melting_row_item(bonusUpgrades.meltingHammer)
        add_current_colored_row()
    }

    if skills.shuriken == relevant {
        new_upgrade_effect_row("Shuriken")
        float_row_item(bonusUpgrades.shurikenCost, " Cost", 0.5)
        multiplier_row_item(bonusUpgrades.shurikenDamageMultiplier, "x Damage")
        toggle_row_item(playerUberStateGroupDescriptor.chakramSpinUpgradeLevel > 0, "Static")
        melting_row_item(bonusUpgrades.meltingShuriken)
        toggle_row_item(bonusUpgrades.shurikenBashable, "Bashable")
        integer_row_item(bonusUpgrades.maxShurikens, " Max", 1)
        splinter_row_item(bonusUpgrades.splinterShurikenCount, " Splinter")
        add_current_colored_row()
    }

    if skills.grenade == relevant {
        new_upgrade_effect_row("Grenade")
        float_row_item(bonusUpgrades.grenadeCost, " Cost", 1)
        multiplier_row_item(1 / bonusUpgrades.grenadeChargeDurationMultiplier, "x Charge Speed")
        toggle_row_item(bonusUpgrades.unchargedGrenadesBashable, "Uncharged Bashable")
        integer_row_item(bonusUpgrades.maxGrenades, " Max", 1)
        splinter_row_item(bonusUpgrades.splinterGrenadeCount, " Splinter")
        toggle_row_item(bonusUpgrades.unchargedGrenadesBashable, "Air Charge")
        toggle_row_item(bonusUpgrades.grenadesExplodeOnCollision == false, "Manual Detonation")
        add_current_colored_row()
    }

    if skills.regenerate == relevant {
        new_upgrade_effect_row("Regenerate")
        float_row_item(bonusUpgrades.regenerateCost, " Cost", 1)
        multiplier_row_item(bonusUpgrades.regenerateSpeedMultiplier, "x Speed")
        add_current_colored_row()
    }

    if skills.flap == relevant && bonusUpgrades.flapDamage != 0 {
        add_row(get_string("skill_color") + "Flap" + get_string("skill_color") + ": " + bonusUpgrades.flapDamage + " Damage")
    }

    if skills.blaze == relevant {
        new_upgrade_effect_row("Blaze")
        float_row_item(bonusUpgrades.blazeCost, " Cost", 1)
        toggle_row_item(playerUberStateGroupDescriptor.blazeChargeUpgradeLevel > 0, "Charge")
        float_row_item(bonusUpgrades.chargeBlazeCost, " Charge Cost", 2)
        melting_row_item(bonusUpgrades.meltingBlaze)
        add_current_colored_row()
    }

    if skills.flash == relevant {
        new_upgrade_effect_row("Flash")
        float_row_item(bonusUpgrades.flashCostInitial, " Initial Cost", 0.4)
        float_row_item(bonusUpgrades.flashCostPerSecond, " Cost Per Second", 0.1)
        multiplier_row_item(1 / bonusUpgrades.flashDamageIntervalDurationMultiplier, "x Speed")
        multiplier_row_item(bonusUpgrades.flashDamageMultiplier, "x Damage")
        add_current_colored_row()
    }

    if skills.sentry == relevant {
        new_upgrade_effect_row("Sentry")
        float_row_item(bonusUpgrades.sentryCost, " Cost", 1)
        multiplier_row_item(bonusUpgrades.sentryFireRateMultiplier, "x Fire Rate")
        toggle_row_item(playerUberStateGroupDescriptor.sentrySpeedUpgradeLevel > 0, "Rapid")
        integer_row_item(bonusUpgrades.sentryShotsPerBurst, " Sentry Burst Shots", 3)
        integer_row_item(bonusUpgrades.maxSentries, " Max", 3)
        add_current_colored_row()
    }

    if relevant {
        new_colored_row("#Jumps#: ")
        multiplier_row_item(bonusUpgrades.jumpHeightMultiplier, "x Grounded Jump Height")
        multiplier_row_item(bonusUpgrades.wallJumpSpeedMultiplier, "x Wall Jump Height")
        add_current_colored_row()

        if bonusUpgrades.swimSpeedMultiplier != 1 add_upgrade("#Swimming#: " + bonusUpgrades.swimSpeedMultiplier + "x Speed")
    }

    set_string("left_row", "")

    if skills.doubleJump == relevant {
        new_upgrade_effect_row("Double Jump")
        integer_row_item(bonusUpgrades.maxDoubleJumps, " Double Jumps", 1)
        multiplier_row_item(bonusUpgrades.doubleJumpSpeedMultiplier, "x Height")
        add_current_half_row()
    }

    if skills.dash == relevant {
        new_upgrade_effect_row("Dash")
        integer_row_item(bonusUpgrades.maxAirDashes, " Air Dashes", 1)
        multiplier_row_item(bonusUpgrades.dashDistanceMultiplier, "x Distance")
        add_current_half_row()
    }

    if skills.bash == relevant && bonusUpgrades.bashSpeedMultiplier != 1 {
        set_string("row", get_string("skill_color") + "Bash" + get_string("skill_color") + ": " + bonusUpgrades.bashSpeedMultiplier + "x Speed")
        add_current_half_row_unchecked()
    }

    if skills.grapple == relevant && bonusUpgrades.grappleSpeedMultiplier != 1 {
        set_string("row", get_string("skill_color") + "Grapple" + get_string("skill_color") + ": " + bonusUpgrades.grappleSpeedMultiplier + "x Speed")
        add_current_half_row_unchecked()
    }

    if skills.waterDash == relevant && bonusUpgrades.waterDashSpeedMultiplier != 1 {
        set_string("row", get_string("skill_color") + "Water Dash" + get_string("skill_color") + ": " + bonusUpgrades.waterDashSpeedMultiplier + "x Speed")
        add_current_half_row_unchecked()
    }

    if skills.burrow == relevant {
        new_upgrade_effect_row("Burrow")
        multiplier_row_item(bonusUpgrades.burrowSpeedMultiplier, "x Speed")
        multiplier_row_item(bonusUpgrades.burrowDashSpeedMultiplier, "x Dash Speed")
        add_current_half_row()
    }

    if skills.launch == relevant && bonusUpgrades.launchSpeedMultiplier != 1 {
        set_string("row", get_string("skill_color") + "Launch" + get_string("skill_color") + ": " + bonusUpgrades.launchSpeedMultiplier + "x Speed")
        add_current_half_row_unchecked()
    }

    if get_string("left_row") != "" add_current_colored_row()

    if relevant {
        new_colored_row("#Passive Regeneration#: ")
        if energy_per_second != 0 add_upgrade(energy_per_second + " Energy/s")
        if health_per_second != 0 add_upgrade(health_per_second + " Life/s")
        add_current_colored_row()
    }
}

fun new_upgrade_effect_row(skill: String) {
    new_colored_row(get_string("skill_color") + skill + get_string("skill_color") + ": ")
}

fun multiplier_row_item(value: Float, name: String) {
    if value != 1 add_upgrade(value + name)
}

fun melting_row_item(value: Boolean) {
    toggle_row_item(value, "Melting")
}

fun toggle_row_item(value: Boolean, name: String) {
    if value add_upgrade(name)
}

fun splinter_row_item(value: Integer, name: String) {
   if value != 0 add_upgrade((1 + value) + name)
}

fun integer_row_item(value: Integer, name: String, default: Integer) {
    if value != default add_upgrade(value + name)
}

fun float_row_item(value: Float, name: String, default: Float) {
    if value != default add_upgrade(value + name)
}

fun add_current_half_row() {
    if get_integer("next_item") > next_item_first add_current_half_row_unchecked()
}

fun add_current_half_row_unchecked() {
    set_boolean("left_row_empty", get_string("left_row") == "")
    if get_boolean("left_row_empty") set_string("left_row", get_string("row"))
    if get_boolean("left_row_empty") == false {
        set_string("right_row", get_string("row"))
        set_string("row", get_string("left_row"))
        set_string("left_row", "")

        if get_integer("next_item") == next_item_colored set_integer("next_item", next_item_uncolored)
        add_upgrade(get_string("right_row"))

        add_current_colored_row()
    }
}
