#hidden
#name("Upgrade Progress Helper")
#description("Tracks vanilla and bonus upgrades in a progress helper wheel item")

!builtin_icon(message_icon, "icons/game/message.png")

!include("color_core", transparent)
!include("list_core", default_color, new_column, add_row, add_current_colored_row, next_item_first, next_item_colored, next_item_uncolored, new_colored_row, add_colored_row_item_with, auto_negative_margin)
!include("regeneration_core", energy_per_second, health_per_second)

!export(write_upgrades)
fun write_upgrades(relevant: Boolean) {
    if skills.spear == relevant add_upgrade("Exploding Spear")
    if skills.hammer == relevant add_upgrade("Hammer Shockwave")
    if skills.shuriken == relevant add_upgrade("Static Shuriken")
    if skills.blaze == relevant add_upgrade("Charge Blaze")
    if skills.sentry == relevant add_upgrade("Rapid Sentry")
}

!export(add_upgrade)
fun add_upgrade(item: String) {
    add_colored_row_item_with(item, get_string("row_item_color"))
}

!export(update_upgrades)
fun update_upgrades() {
    upgrades_row()
    set_message_text("upgrades", get_string("row"))
}

fun upgrades_row() {
    new_colored_row("")

    set_string("row_item_color", default_color)
    write_upgrades(true)

    set_string("row", get_string("row") + transparent)

    set_string("row_item_color", transparent)
    write_upgrades(false)

    if get_integer("next_item") == next_item_first set_string("row", "No Upgrades")
}

on reload {
    set_wheel_item_data(
        "progress_helper",
        TopLeft,
        "Upgrades",
        "[Ability1]View Upgrades\n[Ability2]View Effects",
        message_icon,
    )
    set_wheel_item_action("progress_helper", TopLeft, Ability1, {
        upgrades_row()
        controlled_priority_message("upgrades", get_string("row"), 4)
    })
    set_wheel_item_action("progress_helper", TopLeft, Ability2, show_upgrade_effects())
    set_wheel_item_action("progress_helper", TopLeft, Ability3, show_upgrade_effects())
}

fun show_upgrade_effects() {
    write_upgrade_effects()
    controlled_priority_message("upgrade_effects", get_string("column"), 6.0)
}

on change playerUberStateGroupDescriptor.spikeExplosiveUpgradeLevel update_upgrade_effects()
on change playerUberStateGroupDescriptor.hammerStompUpgradeLevel update_upgrade_effects()
on change playerUberStateGroupDescriptor.chakramSpinUpgradeLevel update_upgrade_effects()
on change playerUberStateGroupDescriptor.blazeChargeUpgradeLevel update_upgrade_effects()
on change playerUberStateGroupDescriptor.sentrySpeedUpgradeLevel update_upgrade_effects()
on change randoUpgrades.swordSpeedMultiplier update_upgrade_effects()
on change randoUpgrades.swordAsFireSource update_upgrade_effects()
on change randoUpgrades.bowCostMultiplier update_upgrade_effects()
on change randoUpgrades.bowRapidFireIntervalDurationMultiplier update_upgrade_effects()
on change randoUpgrades.bowAsFireSource update_upgrade_effects()
on change randoUpgrades.spearCostMultiplier update_upgrade_effects()
on change randoUpgrades.spearSpeedMultiplier update_upgrade_effects()
on change randoUpgrades.spearAsFireSource update_upgrade_effects()
on change randoUpgrades.hammerSpeedMultiplier update_upgrade_effects()
on change randoUpgrades.hammerAsFireSource update_upgrade_effects()
on change randoUpgrades.shurikenCostMultiplier update_upgrade_effects()
on change randoUpgrades.shurikenDamageMultiplier update_upgrade_effects()
on change randoUpgrades.shurikenAsFireSource update_upgrade_effects()
on change randoUpgrades.shurikenBashable update_upgrade_effects()
on change randoUpgrades.extraShurikens update_upgrade_effects()
on change randoUpgrades.shurikenMultishotCount update_upgrade_effects()
on change randoUpgrades.grenadeCostMultiplier update_upgrade_effects()
on change randoUpgrades.grenadeChargeDurationMultiplier update_upgrade_effects()
on change randoUpgrades.unchargedGrenadesBashable update_upgrade_effects()
on change randoUpgrades.extraGrenades update_upgrade_effects()
on change randoUpgrades.grenadeMultishotCount update_upgrade_effects()
on change randoUpgrades.unchargedGrenadesBashable update_upgrade_effects()
on change randoUpgrades.grenadesExplodeOnCollision update_upgrade_effects()
on change randoUpgrades.regenerateCostMultiplier update_upgrade_effects()
on change randoUpgrades.regenerateSpeedMultiplier update_upgrade_effects()
on change randoUpgrades.flapDamage update_upgrade_effects()
on change randoUpgrades.blazeCostMultiplier update_upgrade_effects()
on change randoUpgrades.blazeAsFireSource update_upgrade_effects()
on change randoUpgrades.flashCostMultiplier update_upgrade_effects()
on change randoUpgrades.flashTickInterval update_upgrade_effects()
on change randoUpgrades.flashDamageMultiplier update_upgrade_effects()
on change randoUpgrades.sentryCostMultiplier update_upgrade_effects()
on change randoUpgrades.sentryFireRateSpeed update_upgrade_effects()
on change randoUpgrades.sentryShots update_upgrade_effects()
on change randoUpgrades.extraSentries update_upgrade_effects()
on change randoUpgrades.extraDoubleJumps update_upgrade_effects()
on change randoUpgrades.jumpHeightMultiplier update_upgrade_effects()
on change randoUpgrades.wallJumpHeightMultiplier update_upgrade_effects()
on change randoUpgrades.doubleJumpHeightMultiplier update_upgrade_effects()
on change randoUpgrades.extraDashes update_upgrade_effects()
on change randoUpgrades.dashDistanceMultiplier update_upgrade_effects()
on change randoUpgrades.bashSpeedMultiplier update_upgrade_effects()
on change randoUpgrades.grappleSpeedMultiplier update_upgrade_effects()
on change randoUpgrades.launchSpeedMultiplier update_upgrade_effects()
on change randoUpgrades.burrowSpeedMultiplier update_upgrade_effects()
on change randoUpgrades.burrowDashSpeedMultiplier update_upgrade_effects()
on change randoUpgrades.swimSpeedMultiplier update_upgrade_effects()
on change randoUpgrades.waterDashSpeedMultiplier update_upgrade_effects()
on change energy_per_second update_upgrade_effects()
on change health_per_second update_upgrade_effects()
fun update_upgrade_effects() {
    write_upgrade_effects()
    set_message_text("upgrade_effects", get_string("column"))
}

fun write_upgrade_effects() {
    new_column("")

    set_string("skill_color", "#")
    set_string("row_item_color", default_color)
    upgrade_effects_half(true)

    set_string("column", get_string("column") + transparent)

    set_string("skill_color", "")
    set_string("row_item_color", transparent)
    upgrade_effects_half(false)

    if get_integer("lines") == 0 set_string("column", "No Upgrade Effects")
    auto_negative_margin()
}

fun upgrade_effects_half(relevant: Boolean) {
    if skills.sword == relevant {
        new_upgrade_effect_row("Sword")
        multiplier_row_item(randoUpgrades.swordSpeedMultiplier, "x Speed")
        melting_row_item(randoUpgrades.swordAsFireSource)
        add_current_colored_row()
    }

    if skills.bow == relevant {
        new_upgrade_effect_row("Bow")
        multiplier_row_item(randoUpgrades.bowCostMultiplier, "x Cost")
        multiplier_row_item(1 / randoUpgrades.bowRapidFireIntervalDurationMultiplier, "x Quickshot Speed")
        melting_row_item(randoUpgrades.bowAsFireSource)
        add_current_colored_row()
    }

    if skills.spear == relevant {
        new_upgrade_effect_row("Spear")
        multiplier_row_item(randoUpgrades.spearCostMultiplier, "x Cost")
        multiplier_row_item(randoUpgrades.spearSpeedMultiplier, "x Speed")
        toggle_row_item(playerUberStateGroupDescriptor.spikeExplosiveUpgradeLevel > 0, "Exploding")
        melting_row_item(randoUpgrades.spearAsFireSource)
        add_current_colored_row()
    }

    if skills.hammer == relevant {
        new_upgrade_effect_row("Hammer")
        multiplier_row_item(randoUpgrades.hammerSpeedMultiplier, "x Speed")
        toggle_row_item(playerUberStateGroupDescriptor.hammerStompUpgradeLevel > 0, "Shockwave")
        melting_row_item(randoUpgrades.hammerAsFireSource)
        add_current_colored_row()
    }

    if skills.shuriken == relevant {
        new_upgrade_effect_row("Shuriken")
        multiplier_row_item(randoUpgrades.shurikenCostMultiplier, "x Cost")
        multiplier_row_item(randoUpgrades.shurikenDamageMultiplier, "x Damage")
        toggle_row_item(playerUberStateGroupDescriptor.chakramSpinUpgradeLevel > 0, "Static")
        melting_row_item(randoUpgrades.shurikenAsFireSource)
        toggle_row_item(randoUpgrades.shurikenBashable, "Bashable")
        extra_row_item(randoUpgrades.extraShurikens, " Max")
        extra_row_item(randoUpgrades.shurikenMultishotCount, " Splinter")
        add_current_colored_row()
    }

    if skills.grenade == relevant {
        new_upgrade_effect_row("Grenade")
        multiplier_row_item(randoUpgrades.grenadeCostMultiplier, "x Cost")
        multiplier_row_item(1 / randoUpgrades.grenadeChargeDurationMultiplier, "x Charge Speed")
        toggle_row_item(randoUpgrades.unchargedGrenadesBashable, "Uncharged Bashable")
        extra_row_item(randoUpgrades.extraGrenades, " Max")
        extra_row_item(randoUpgrades.grenadeMultishotCount, " Splinter")
        toggle_row_item(randoUpgrades.unchargedGrenadesBashable, "Air Charge")
        toggle_row_item(randoUpgrades.grenadesExplodeOnCollision == false, "Manual Detonation")
        add_current_colored_row()
    }

    if skills.regenerate == relevant {
        new_upgrade_effect_row("Regenerate")
        multiplier_row_item(randoUpgrades.regenerateCostMultiplier, "x Cost")
        multiplier_row_item(randoUpgrades.regenerateSpeedMultiplier, "x Speed")
        add_current_colored_row()
    }

    if skills.flap == relevant && randoUpgrades.flapDamage != 0 {
        add_row(get_string("skill_color") + "Flap" + get_string("skill_color") + ": " + randoUpgrades.flapDamage + " Damage")
    }

    if skills.blaze == relevant {
        new_upgrade_effect_row("Blaze")
        multiplier_row_item(randoUpgrades.blazeCostMultiplier, "x Cost")
        toggle_row_item(playerUberStateGroupDescriptor.blazeChargeUpgradeLevel > 0, "Charge")
        melting_row_item(randoUpgrades.blazeAsFireSource)
        add_current_colored_row()
    }

    if skills.flash == relevant {
        new_upgrade_effect_row("Flash")
        multiplier_row_item(randoUpgrades.flashCostMultiplier, "x Cost")
        multiplier_row_item(1 / randoUpgrades.flashTickInterval, "x Speed")
        multiplier_row_item(randoUpgrades.flashDamageMultiplier, "x Damage")
        add_current_colored_row()
    }

    if skills.sentry == relevant {
        new_upgrade_effect_row("Sentry")
        multiplier_row_item(randoUpgrades.sentryCostMultiplier, "x Cost")
        multiplier_row_item(randoUpgrades.sentryFireRateSpeed, "x Fire Rate")
        toggle_row_item(playerUberStateGroupDescriptor.sentrySpeedUpgradeLevel > 0, "Rapid")
        integer_row_item(randoUpgrades.sentryShots, " Sentry Burst Shots", 3)
        extra_row_item(randoUpgrades.extraSentries, " Max")
        add_current_colored_row()
    }

    if relevant {
        new_colored_row("#Jumps#: ")
        multiplier_row_item(randoUpgrades.jumpHeightMultiplier, "x Grounded Jump Height")
        multiplier_row_item(randoUpgrades.wallJumpHeightMultiplier, "x Wall Jump Height")
        add_current_colored_row()

        if randoUpgrades.swimSpeedMultiplier != 1 add_upgrade("#Swimming#: " + randoUpgrades.swimSpeedMultiplier + "x Speed")
    }

    set_string("left_row", "")

    if skills.doubleJump == relevant {
        new_upgrade_effect_row("Double Jump")
        extra_row_item(randoUpgrades.extraDoubleJumps, " Double Jumps")
        multiplier_row_item(randoUpgrades.doubleJumpHeightMultiplier, "x Height")
        add_current_half_row()
    }

    if skills.dash == relevant {
        new_upgrade_effect_row("Dash")
        extra_row_item(randoUpgrades.extraDashes, " Air Dashes")
        multiplier_row_item(randoUpgrades.dashDistanceMultiplier, "x Distance")
        add_current_half_row()
    }

    if skills.bash == relevant && randoUpgrades.bashSpeedMultiplier != 1 {
        set_string("row", get_string("skill_color") + "Bash" + get_string("skill_color") + ": " + randoUpgrades.bashSpeedMultiplier + "x Speed")
        add_current_half_row_unchecked()
    }

    if skills.grapple == relevant && randoUpgrades.grappleSpeedMultiplier != 1 {
        set_string("row", get_string("skill_color") + "Grapple" + get_string("skill_color") + ": " + randoUpgrades.grappleSpeedMultiplier + "x Speed")
        add_current_half_row_unchecked()
    }

    if skills.waterDash == relevant && randoUpgrades.waterDashSpeedMultiplier != 1 {
        set_string("row", get_string("skill_color") + "Water Dash" + get_string("skill_color") + ": " + randoUpgrades.waterDashSpeedMultiplier + "x Speed")
        add_current_half_row_unchecked()
    }

    if skills.burrow == relevant {
        new_upgrade_effect_row("Burrow")
        multiplier_row_item(randoUpgrades.burrowSpeedMultiplier, "x Speed")
        multiplier_row_item(randoUpgrades.burrowDashSpeedMultiplier, "x Dash Speed")
        add_current_half_row()
    }

    if skills.launch == relevant && randoUpgrades.launchSpeedMultiplier != 1 {
        set_string("row", get_string("skill_color") + "Launch" + get_string("skill_color") + ": " + randoUpgrades.launchSpeedMultiplier + "x Speed")
        add_current_half_row_unchecked()
    }

    if get_string("left_row") != "" add_current_colored_row()

    if relevant {
        new_colored_row("#Passive Regeneration#: ")
        if energy_per_second != 0 add_upgrade(energy_per_second + " Energy/s")
        if health_per_second != 0 add_upgrade(health_per_second + " Health/s")
        add_current_colored_row()
    }
}

fun new_upgrade_effect_row(skill: String) {
    new_colored_row(get_string("skill_color") + skill + get_string("skill_color") + ": ")
}

fun multiplier_row_item(value: Float, name: String) {
    if value != 1 add_upgrade(value + name)
}

fun melting_row_item(value: Boolean) {
    toggle_row_item(value, "Melting")
}

fun toggle_row_item(value: Boolean, name: String) {
    if value add_upgrade(name)
}

fun extra_row_item(value: Integer, name: String) {
   if value != 0 add_upgrade((1 + value) + name)
}

fun integer_row_item(value: Integer, name: String, default: Integer) {
    if value != default add_upgrade(value + name)
}

fun add_current_half_row() {
    if get_integer("next_item") > next_item_first add_current_half_row_unchecked()
}

fun add_current_half_row_unchecked() {
    set_boolean("left_row_empty", get_string("left_row") == "")
    if get_boolean("left_row_empty") set_string("left_row", get_string("row"))
    if get_boolean("left_row_empty") == false {
        set_string("right_row", get_string("row"))
        set_string("row", get_string("left_row"))
        set_string("left_row", "")

        if get_integer("next_item") == next_item_colored set_integer("next_item", next_item_uncolored)
        add_upgrade(get_string("right_row"))

        add_current_colored_row()
    }
}
