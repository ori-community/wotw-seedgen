on binding1 if get_integer("bind_pointer") == 0 {
    save()
    refill()
    controlled_priority_message("response", "Game Saved!\nHealth and Energy restored", 4)
}
fun refill() {
    store(player.health, player.maxHealth)
    store(player.energy, player.maxEnergy)
}

!state(auto_refill, Boolean)

fun toggle_auto_refill() {
    store(auto_refill, auto_refill == false)
    if auto_refill respond("#Auto-Refill enabled#")
    if auto_refill == false respond("@Auto-Refill disabled@")
}

on tick if auto_refill refill()

!let(bind_counter, bind_counter + 1)
!let(choose_teleport_target, bind_counter)

on binding2 if get_integer("bind_pointer") == 0 {
    set_boolean("warp_set", warp_x != 0 || warp_y != 0)
    if get_boolean("warp_set") teleport()
    if get_boolean("warp_set") == false choose_teleport_target()
}

fun choose_teleport_target() {
    store(bind_pointer, choose_teleport_target)

    open_dialogue()
    update_target_message()
}

on tick if bind_pointer == choose_teleport_target update_target_message()
fun update_target_message() {
    set_message_text("dialogue", player.mouseWorldPositionX + ", " + player.mouseWorldPositionY + "\n[Binding1]Confirm [Binding2]Cancel")
}

on binding1 if get_integer("bind_pointer") == choose_teleport_target {
    store(warp_x, player.mouseWorldPositionX)
    store(warp_y, player.mouseWorldPositionY)

    respond("Warp target set\n[Binding2]Warp to " + player.mouseWorldPositionX + ", " + player.mouseWorldPositionY)
}

on binding2 if get_integer("bind_pointer") == choose_teleport_target close_dialogue()

fun teleport() {
    instant_warp(warp_x, warp_y)
}

!let(bind_counter, bind_counter + 1)
!let(select_major_state, bind_counter)

on binding3 if get_integer("bind_pointer") == 0 {
    store(bind_pointer, select_major_state)

    open_dialogue()
    set_message_text("dialogue", "Select toggle\n[Binding1]Difficulty\n[Binding2]Clean Water\n[Binding3]Glades Projects\n[Binding4]Marsh Weather\n[Binding5]Cancel")
}

on binding1 if get_integer("bind_pointer") == select_major_state toggle_difficulty()
on binding2 if get_integer("bind_pointer") == select_major_state toggle_clean_water()
on binding3 if get_integer("bind_pointer") == select_major_state toggle_glades_projects()
on binding4 if get_integer("bind_pointer") == select_major_state toggle_marsh_weather()
on binding5 if get_integer("bind_pointer") == select_major_state close_dialogue()

fun toggle_difficulty() {
    store(gameStateGroup.gameDifficultyMode, gameStateGroup.gameDifficultyMode + 1)
    if gameStateGroup.gameDifficultyMode == 3 store(gameStateGroup.gameDifficultyMode, 0)
    if gameStateGroup.gameDifficultyMode == 0 set_string("difficulty", "#Easy#")
    if gameStateGroup.gameDifficultyMode == 1 set_string("difficulty", "#Normal#")
    if gameStateGroup.gameDifficultyMode == 2 set_string("difficulty", "#Hard#")
    controlled_priority_message("response", "Difficulty changed to " + get_string("difficulty"), 4)
}

fun toggle_clean_water() {
    store(worldEvents.cleanWater, worldEvents.cleanWater == false)
    if worldEvents.cleanWater respond(clean_water_string())
    if worldEvents.cleanWater == false respond(remove_clean_water_string())
}

fun toggle_marsh_weather() {
    store(Marsh.StormLifted, Marsh.StormLifted == false)
    if Marsh.StormLifted respond("#Storm Lifted#")
    if Marsh.StormLifted == false respond("@Storm Reset@")
}

fun toggle_glades_projects() {
    set_boolean("all_built",
        Glades.Buildings.DwellingRepairs
        && Glades.Buildings.RoofsOverHeads
        && Glades.Buildings.OnwardsAndUpwards
        && Glades.Buildings.ThornySituation
        && Glades.Buildings.ClearTheCaveEntrance
        && Glades.Plants.BlueMoon
        && Glades.Plants.StickyGrass
        && Glades.Plants.SpringPlants
        && Glades.Plants.Lightcatchers
        && Glades.Plants.SelaFlowers
        && Glades.Plants.LastTree
    )
    if get_boolean("all_built") {
        store(Glades.Buildings.DwellingRepairs, false)
        store(Glades.Buildings.RoofsOverHeads, false)
        store(Glades.Buildings.OnwardsAndUpwards, false)
        store(Glades.Buildings.ThornySituation, false)
        store(Glades.Buildings.ClearTheCaveEntrance, false)
        store(Glades.Plants.BlueMoon, false)
        store(Glades.Plants.StickyGrass, false)
        store(Glades.Plants.SpringPlants, false)
        store(Glades.Plants.Lightcatchers, false)
        store(Glades.Plants.SelaFlowers, false)
        store(Glades.Plants.LastTree, false)
        respond("@Glades Projects Reset@")
    }
    if get_boolean("all_built") == false {
        store(Glades.Buildings.DwellingRepairs, true)
        store(Glades.Buildings.RoofsOverHeads, true)
        store(Glades.Buildings.OnwardsAndUpwards, true)
        store(Glades.Buildings.ThornySituation, true)
        store(Glades.Buildings.ClearTheCaveEntrance, true)
        store(Glades.Plants.BlueMoon, true)
        store(Glades.Plants.StickyGrass, true)
        store(Glades.Plants.SpringPlants, true)
        store(Glades.Plants.Lightcatchers, true)
        store(Glades.Plants.SelaFlowers, true)
        store(Glades.Plants.LastTree, true)
        respond("#Glades Projects Completed#")
    }
}

on binding4 if get_integer("bind_pointer") == 0 world_reset()
fun world_reset() {
    store_defaults_exclude(
        "^("
        // map
        + "3\|"
        // player
        + "|5\|"
        // modifications
        + "|6\|"
        // custom
        + "|([89]|10)\|"
        // worldEvents
        + "|16\|"
        // skills
        + "|24\|"
        // shards
        + "|25\|"
        // spirit wells
        + "|21786\|10185"
        + "|11666\|61594"
        + "|937\|26601"
        + "|42178\|42096"
        + "|24922\|42531"
        + "|53632\|18181"
        + "|58674\|(7071|1965)"
        + "|28895\|54235"
        + "|18793\|38871"
        + "|945\|(58183|1370)"
        + "|58674\|10029"
        + "|20120\|(49994|41398)"
        + "|10289\|4928"
        + "|16155\|(41465|50867)"
        // default-finished grom projects and shop slots
        + "|(17|21)\|(16825|15068)"
        // playerUberStateGroupDescriptor
        + "|3440\|"
        // fast travel
        + "|48248\|16489"
        // marsh intro and torch
        + "|21786\|48748"
        // torch
        + "|21786\|47458|9593\|3621"
        // kwolok lever
        + "|21786\|50432|48248\|33981"
        // ku
        + "|58674\|44798|14019\|(34504|54675|8973|35087|35399|45931)"
        + ")"
    )
    trigger_client_event(spawn) // Fallback if an exclude is missing above, will spam the UberState log though
    controlled_priority_message("response", "@World Reset@", 4)
}

!state(uber_state_log, Boolean)

on binding5 if get_integer("bind_pointer") == 0 toggle_uber_state_log()
fun toggle_uber_state_log() {
    store(uber_state_log, uber_state_log == false)
    if uber_state_log respond("#UberState log enabled#")
    if uber_state_log == false respond("@UberState log disabled@")
}

fun uber_state_log_message(message: String) {
    if uber_state_log {
        item_message(message)
        debug_log(message)
    }
}

// This can be generated using wotw-seedgen dev generate-uber-state-log
// Do keep the modified uber_state_log_message above respecting the toggle though

