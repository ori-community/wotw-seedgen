        "Toggle Spring Plants",
        "[Ability1]Toggle",
        SpringPlants,
    )
    set_wheel_item_all_actions("glades_projects", RightBottom, store(Glades.Plants.SpringPlants, Glades.Plants.SpringPlants == false))

    set_wheel_item_data(
        "glades_projects",
        BottomRight,
        "Toggle Last Tree",
        "[Ability1]Toggle",
        TheLastSeed,
    )
    set_wheel_item_all_actions("glades_projects", BottomRight, store(Glades.Plants.LastTree, Glades.Plants.LastTree == false))
}

