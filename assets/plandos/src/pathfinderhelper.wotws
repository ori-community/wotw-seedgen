#name("Pathfinder Helper")
#description("Useful tools when writing logic")

!include("seed_core")

!builtin_icon(clean_water_icon, "icons/game/clean_water.monochrome.png")
!builtin_icon(teleporter_icon, "icons/game/teleporter.png")
!builtin_icon(save_icon, "icons/game/save.png")
!builtin_icon(health_icon, "icons/game/health_fragment.png")
!builtin_icon(wall_icon, "map_icons/blocked_wall.png")
!builtin_icon(gears_icon, "icons/wheel/toggle_debug.png")
!builtin_icon(message_icon, "icons/game/message.png")

!state(warp_x, Float)
!state(warp_y, Float)

!state(bind_pointer, Integer)
!let(bind_counter, 0)

!state(first_spawn, Boolean)
on spawn store(first_spawn, true)

on binding1 set_integer("bind_pointer", bind_pointer)
on binding2 set_integer("bind_pointer", bind_pointer)
on binding3 set_integer("bind_pointer", bind_pointer)
on binding4 set_integer("bind_pointer", bind_pointer)
on binding5 set_integer("bind_pointer", bind_pointer)

fun open_dialogue() {
    destroy_message("response")
    free_message_uninitialized("dialogue")
    free_message_show("dialogue", true, true)
}

fun close_dialogue() {
    store(bind_pointer, 0)
    destroy_message("dialogue")
}

fun respond(message: String) {
    close_dialogue()
    controlled_priority_message("response", message, 4)
}

on reload {
    set_wheel_item_data(
        "root",
        BottomLeft,
        "Toggle UberState log",
        "[Ability1]Toggle\nShortcut: [Binding5]",
        message_icon,
    )
    set_wheel_item_all_actions("root", BottomLeft, toggle_uber_state_log())

    set_wheel_item_data(
        "root",
        LeftBottom,
        "Save",
        "[Ability1]Save\nShortcut: [Binding1]",
        save_icon,
    )
    set_wheel_item_all_actions("root", LeftBottom, {
        save()
        respond("Game Saved!")
    })

    set_wheel_item_data(
        "root",
        Left,
        "Refill",
        "[Ability1]Refill\n[Ability2]Toggle Auto-Refill\nShortcut: [Binding1]",
        health_icon,
    )
    set_wheel_item_action("root", Left, Ability1, {
        refill()
        respond("Health and Energy restored")
    })
    set_wheel_item_action("root", Left, Ability2, toggle_auto_refill())
    set_wheel_item_action("root", Left, Ability3, toggle_auto_refill())

    set_wheel_item_data(
        "root",
        LeftTop,
        "Choose target for Warp to x/y",
        "[Ability1]Choose\nShortcut: [Binding2]",
        teleporter_icon,
    )
    set_wheel_item_all_actions("root", LeftTop, choose_teleport_target())

    set_wheel_item_data(
        "root",
        TopLeft,
        "Warp to x/y",
        "[Ability1]Warp\nShortcut: [Binding2]",
        teleporter_icon,
    )
    set_wheel_item_all_actions("root", TopLeft, {
        set_boolean("warp_set", warp_x != 0 || warp_y != 0)
        if get_boolean("warp_set") teleport()
        if get_boolean("warp_set") == false respond("No warp target set")
    })

    set_wheel_item_data(
        "root",
        Top,
        "Toggle Difficulty",
        "[Ability1]Toggle\nShortcut: [Binding3]",
        gears_icon,
    )
    set_wheel_item_all_actions("root", Top, toggle_difficulty())

    set_wheel_item_data(
        "root",
        TopRight,
        "Toggle Clean Water",
        "[Ability1]Toggle\nShortcut: [Binding3]",
        clean_water_icon,
    )
    set_wheel_item_all_actions("root", TopRight, toggle_clean_water())

    set_wheel_item_data(
        "root",
        RightTop,
        "Toggle Glades Projects",
        "[Ability1]Toggle All\n[Ability2]Open Menu\nShortcut: [Binding3]",
        gears_icon,
    )
    set_wheel_item_action("root", RightTop, Ability1, toggle_glades_projects())
    set_wheel_item_action("root", RightTop, Ability2, switch_wheel("glades_projects"))
    set_wheel_item_action("root", RightTop, Ability3, switch_wheel("glades_projects"))

    set_wheel_item_data(
        "root",
        Right,
        "Toggle Marsh Weather",
        "[Ability1]Toggle\nShortcut: [Binding3]",
        gears_icon,
    )
    set_wheel_item_all_actions("root", Right, toggle_marsh_weather())

    set_wheel_item_data(
        "root",
        RightBottom,
        "World Reset",
        "[Ability1]Reset\nShortcut: [Binding4]",
        wall_icon,
    )
    set_wheel_item_all_actions("root", RightBottom, world_reset())

    set_wheel_item_data(
        "glades_projects",
        Left,
        "Toggle Glades Projects",
        "[Ability1]Toggle All\n[Ability2]Open Menu",
        wall_icon,
    )

    set_wheel_item_data(
        "glades_projects",
        TopLeft,
        "Toggle Dwelling Repairs",
        "[Ability1]Toggle",
        DwellingRepairs,
    )
    set_wheel_item_all_actions("glades_projects", TopLeft, store(Glades.Buildings.DwellingRepairs, Glades.Buildings.DwellingRepairs == false))

    set_wheel_item_data(
        "glades_projects",
        LeftTop,
        "Toggle Roofs Over Heads",
        "[Ability1]Toggle",
        RoofsOverHeads,
    )
    set_wheel_item_all_actions("glades_projects", LeftTop, store(Glades.Buildings.RoofsOverHeads, Glades.Buildings.RoofsOverHeads == false))

    set_wheel_item_data(
        "glades_projects",
        Left,
        "Toggle Onwards and Upwards",
        "[Ability1]Toggle",
        OnwardsAndUpwards,
    )
    set_wheel_item_all_actions("glades_projects", Left, store(Glades.Buildings.OnwardsAndUpwards, Glades.Buildings.OnwardsAndUpwards == false))

    set_wheel_item_data(
        "glades_projects",
        LeftBottom,
        "Toggle Thorny Situation",
        "[Ability1]Toggle",
        ThornySituation,
    )
    set_wheel_item_all_actions("glades_projects", LeftBottom, store(Glades.Buildings.ThornySituation, Glades.Buildings.ThornySituation == false))

    set_wheel_item_data(
        "glades_projects",
        BottomLeft,
        "Toggle Clear the Cave Entrance",
        "[Ability1]Toggle",
        ClearTheCaveEntrance,
    )
    set_wheel_item_all_actions("glades_projects", BottomLeft, store(Glades.Buildings.ClearTheCaveEntrance, Glades.Buildings.ClearTheCaveEntrance == false))


    set_wheel_item_data(
        "glades_projects",
        Top,
        "Toggle Sela Flowers",
        "[Ability1]Toggle",
        SelaFlowers,
    )
    set_wheel_item_all_actions("glades_projects", Top, store(Glades.Plants.SelaFlowers, Glades.Plants.SelaFlowers == false))

    set_wheel_item_data(
        "glades_projects",
        TopRight,
        "Toggle Sticky Grass",
        "[Ability1]Toggle",
        StickyGrass,
    )
    set_wheel_item_all_actions("glades_projects", TopRight, store(Glades.Plants.StickyGrass, Glades.Plants.StickyGrass == false))

    set_wheel_item_data(
        "glades_projects",
        RightTop,
        "Toggle Lightcatchers",
        "[Ability1]Toggle",
        Lightcatchers,
    )
    set_wheel_item_all_actions("glades_projects", RightTop, store(Glades.Plants.Lightcatchers, Glades.Plants.Lightcatchers == false))

    set_wheel_item_data(
        "glades_projects",
        Right,
        "Toggle Blue Moon",
        "[Ability1]Toggle",
        BlueMoon,
    )
    set_wheel_item_all_actions("glades_projects", Right, store(Glades.Plants.BlueMoon, Glades.Plants.BlueMoon == false))

    set_wheel_item_data(
        "glades_projects",
