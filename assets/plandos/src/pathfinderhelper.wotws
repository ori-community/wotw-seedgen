        BlueMoon,
    )
    set_wheel_item_all_actions("glades_projects", Bottom, store(gladesProjects.blueMoonPlanted, gladesProjects.blueMoonPlanted == false))

    set_wheel_item_data(
        "glades_projects",
        BottomLeft,
        "Toggle Spring Plants",
        "[Ability1]Toggle",
        SpringPlants,
    )
    set_wheel_item_all_actions("glades_projects", BottomLeft, store(gladesProjects.springPlantsPlanted, gladesProjects.springPlantsPlanted == false))

    set_wheel_item_data(
        "glades_projects",
        LeftBottom,
        "Toggle Last Tree",
        "[Ability1]Toggle",
        TheLastSeed,
    )
    set_wheel_item_all_actions("glades_projects", LeftBottom, store(gladesProjects.lastTreePlanted, gladesProjects.lastTreePlanted == false))
