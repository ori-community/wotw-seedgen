!spawn(-3219, -5935)

on reload {
    root()
    shards()
    equipment()
    opher()
    lupo()
    grom()
    tuley()
}

fun root() {
    set_wheel_item_data("root", Left, "Shards", "[Ability1]View", Overcharge)
    set_wheel_item_all_actions("root", Left, switch_wheel("shards"))
    set_wheel_item_data("root", LeftTop, "Equipment", "[Ability1]View", Hammer)
    set_wheel_item_all_actions("root", LeftTop, switch_wheel("equipment"))
    set_wheel_item_data("root", TopLeft, "Opher", "[Ability1]View", Sentry)
    set_wheel_item_all_actions("root", TopLeft, switch_wheel("opher"))
    set_wheel_item_data("root", Top, "Lupo", "[Ability1]View", EnergyFragmentsMap)
    set_wheel_item_all_actions("root", Top, switch_wheel("lupo"))
    set_wheel_item_data("root", TopRight, "Grom", "[Ability1]View", RepairTheSpiritWell)
    set_wheel_item_all_actions("root", TopRight, switch_wheel("grom"))
    set_wheel_item_data("root", RightTop, "Tuley", "[Ability1]View", SelaFlowers)
    set_wheel_item_all_actions("root", RightTop, switch_wheel("tuley"))
    set_wheel_item_data("root", Right, "Placeholder", "", Placeholder)
}

